<% set_page_title "投资交易课程" %>
<% set_page_description "学习使用 Holdle 的工具和方法，掌握金字塔评分系统、财务分析技巧，构建你的交易规则系统。" %>
<% set_page_keywords "投资课程,交易系统,股票分析,金字塔评分,财务分析" %>
<div class="py-16">
  <div class="container-narrow-flush">
    <div class="label-en px-6 md:px-0">COURSES - V2.0</div>
    <h1 class="text-hl-22 font-semibold text-ink mb-2 px-6 md:px-0">HOLDLE - 投资交易课</h1>
    <p class="text-hl-13 text-muted-3  mb-7 px-6 md:px-0">股票新手必看，学习如何使用 HOLDLE 的工具和方法，构建你的交易系统</p>
    <%# <p class="text-hl-13 font-semibold text-ink mb-7">核心逻辑 —— “结硬寨、打呆仗”：低频量化 + 规则化交易 + 分散持仓 + 机械风控（全程不主观预判）</p> %>

    <div class="grid grid-cols-1 gap-6 md:gap-4">
      <% @courses.each do |course| %>
        <% lessons = course.lessons.select(&:published?).sort_by { |l| [l.sort_num, l.id] } %>
        <div class="hl-card overflow-hidden">
          <%# 头部（进入课程详情） %>
          <%= link_to course_path(course), class: 'block px-6 sm:px-7 py-6 sm:py-7 hover:bg-bg-soft transition-colors' do %>
            <div class="flex flex-col sm:flex-row gap-5">
              <% if course.cover_url %>
                <div class="shrink-0">
                  <%= image_tag course.cover_url,
                        alt: "#{course.title} 封面",
                        class: 'w-full sm:w-44 h-28 object-cover rounded border border-line',
                        loading: 'lazy' %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <h2 class="text-hl-16 font-semibold text-ink"><%= course.title %></h2>
                <% if course.description.present? %>
                  <p class="mt-1.5 text-hl-13 text-muted line-clamp-2"><%= course.description %></p>
                <% end %>
                <div class="mt-3 flex items-center gap-4 text-hl-12 text-muted-4">
                  <span><%= course.chapters.select(&:published?).size %> 个章节</span>
                  <span><%= lessons.size %> 个小节</span>
                </div>
              </div>
            </div>
          <% end %>

          <%# 课程大纲（小节直展） %>
          <div class="divide-y divide-line-soft border-t border-line-soft">
            <% lessons.each do |lesson| %>
              <%= link_to lesson_path(lesson), class: 'flex items-center gap-3 px-6 sm:px-7 py-3 hover:bg-bg-soft transition-colors' do %>
                <span class="shrink-0 w-6 text-right font-mono text-hl-12 text-muted-4"><%= lesson.sort_num %></span>
                <span class="flex-1 min-w-0 text-hl-13 text-muted hover:text-ink transition-colors"><%= lesson.title %></span>
                <% if lesson.member_only? %>
                  <span class="shrink-0 inline-flex px-2 py-0.5 text-hl-11 font-medium bg-bg-mute text-muted-3 border border-line-soft rounded">会员</span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @courses.empty? %>
        <div class="hl-card py-16 text-center">
          <p class="text-hl-14 text-muted-4">暂无课程</p>
        </div>
      <% end %>
    </div>
  </div>
</div>