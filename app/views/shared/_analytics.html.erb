<%# ===== 全站访问统计双埋（仅当对应 ENV 配置了 ID 才输出，本地开发默认不加载） =====
  - 百度统计：国内主力，UV/PV/来源/UTM campaign 报表
  - Microsoft Clarity：海外补充 + 热力图/会话录屏，URL 变化自动捕获（Turbo pushState 兼容）
  - ID 申请：百度统计 tongji.baidu.com；Clarity clarity.microsoft.com
  - 只埋前台 layout，admin 后台不统计
-%>
<% baidu_id = ENV["BAIDU_ANALYTICS_SITE_ID"].presence %>
<% clarity_id = ENV["CLARITY_PROJECT_ID"].presence %>

<% if baidu_id %>
  <script>
    var _hmt = _hmt || [];
    (function() {
      var hm = document.createElement("script");
      hm.src = "https://hm.baidu.com/hm.js?<%= j(baidu_id) %>";
      var s = document.getElementsByTagName("script")[0];
      s.parentNode.insertBefore(hm, s);
    })();
  </script>
<% end %>

<% if clarity_id %>
  <script>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "<%= j(clarity_id) %>");
  </script>
<% end %>

<% if baidu_id %>
  <script>
    // Turbo 页面切换不会重新加载 hm.js，首屏之外的访问须手动补报 _trackPageview，
    // 否则百度统计只记到整页刷新，站内跳转全部丢失
    (function() {
      var lastUrl = location.href; // 首次整页加载 hm.js 已自动上报，跳过
      document.addEventListener('turbo:load', function() {
        if (location.href === lastUrl) return;
        lastUrl = location.href;
        _hmt.push(['_trackPageview', location.pathname + location.search]);
      });
    })();
  </script>
<% end %>
