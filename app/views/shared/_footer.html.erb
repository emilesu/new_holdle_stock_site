<footer class="hl-footer bg-white border-t border-line pt-6 pb-4 md:pt-12 md:pb-8 mt-auto">
  <div class="container-hl">

    <%# ----- 内容区 (桌面 4 列 / 平板 品牌通栏+3 列 / 手机 品牌通栏+2 列+联系通栏)，瘦身版 2026-11-28 老板定 ----- %>
    <div class="hl-footer-grid">

      <%# 第 1 列：品牌介绍（<1024px 通栏，tagline 收成一行短句） %>
      <div class="hl-footer-col-brand">
        <div class="hl-footer-brand">HOLD LE</div>
        <p class="hl-footer-tagline">
          <span class="hl-footer-tagline-short">欢迎留下、思考，在股市里做一个清醒的人。</span>
          <span class="hl-footer-tagline-full">欢迎留下。欢迎思考。欢迎在股市里做一个清醒的人。<br><br>
          投资最终不是找到一个答案<br>
          而是建立面对未知的方法</span>
        </p>
      </div>

      <%# 第 2 列：导航 %>
      <div>
        <h5 class="hl-footer-col-title">导航</h5>
        <ul>
          <li><%= link_to "首页", root_path, class: "hl-footer-link" %></li>
          <li><%= link_to "金字塔", pyramid_path, class: "hl-footer-link" %></li>
          <li><%= link_to "交易课", courses_path, class: "hl-footer-link" %></li>
          <li><%= link_to "加入会员", join_path, class: "hl-footer-link" %></li>
          <%# TODO: 「关于HOLDLE」入口暂时隐藏，页面改版完成后删除 if false 即可恢复 %>
          <% if false %>
          <li><%= link_to "关于HOLDLE", about_path, class: "hl-footer-link" %></li>
          <% end %>
        </ul>
      </div>

      <%# 第 3 列：内容 %>
      <div>
        <h5 class="hl-footer-col-title">内容</h5>
        <ul>
          <li><%= link_to "视频分享", video_path, class: "hl-footer-link" %></li>
          <li><a href="https://www.youtube.com/@EmileSu" class="hl-footer-link">YouTube-频道</a></li>
          <li><a href="https://space.bilibili.com/270587047" class="hl-footer-link">哔哩哔哩-B站频道</a></li>
        </ul>
      </div>

      <%# 第 4 列：联系（手机端通栏横排，省一段纵向空间） %>
      <div class="hl-footer-col-contact">
        <h5 class="hl-footer-col-title">联系</h5>
        <ul>
          <li>网站留言</li>
          <li>邮箱：emilesu@qq.com</li>
        </ul>
      </div>
    </div>

    <%# ----- 版权条（手机端各段独立成行居中） ----- %>
    <div class="hl-footer-bottom">
      <div class="hl-footer-copy">
        <span class="hl-footer-copy-item">&copy; <%= Date.current.year %> HOLD LE &middot; Designed by Emile Su</span>
        <span class="hl-footer-divider">|</span>
        <span class="hl-footer-copy-item">本网站不提供投资建议，投资有风险，决策需谨慎</span>
        <span class="hl-footer-divider">|</span>
        <span class="hl-footer-copy-item">
          <%= link_to "服务协议", terms_path, class: "hl-footer-link" %>
          <span class="hl-footer-divider">|</span>
          <%= link_to "隐私政策", privacy_path, class: "hl-footer-link" %>
        </span>
      </div>
      <div>
        <a href="#" class="hl-footer-top">返回顶部 &uarr;</a>
      </div>
    </div>
  </div>
</footer>