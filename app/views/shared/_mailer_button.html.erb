<%# 事务邮件 CTA：table 按钮 + 明文备用链接（QQ/微信邮箱对现代 CSS 支持差，全部内联显式属性；bgcolor 属性兜底老客户端剥离 CSS 后白字白底） %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 16px;">
  <tr>
    <td bgcolor="#18181B" style="background-color:#18181B; border-radius:8px;">
      <a href="<%= url %>" style="display:inline-block; padding:12px 32px; font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif; font-size:15px; font-weight:500; line-height:1.4; color:#FFFFFF; text-decoration:none;"><%= text %></a>
    </td>
  </tr>
</table>
<div style="font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif; font-size:12px; line-height:1.7; color:#A1A1AA; word-break:break-all;">
  若按钮无法点击，请复制以下链接到浏览器打开：<br><%= url %>
</div>
