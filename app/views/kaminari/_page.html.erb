<%# Link showing page number
  - available local variables
    page:          a page object for "this" page
    url:           url to this page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<% if page.current? %>
  <span class="pagination-current inline-flex h-8 min-w-8 items-center justify-center rounded-md bg-ink px-2 text-hl-13 font-medium text-white" aria-current="page"><%= page %></span>
<% else %>
  <%= link_to page, url, rel: page.rel, remote: remote,
        class: "pagination-page inline-flex h-8 min-w-8 items-center justify-center rounded-md border border-line bg-white px-2 text-hl-13 text-muted transition-colors hover:border-ink hover:text-ink" %>
<% end %>
