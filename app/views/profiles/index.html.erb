<% set_page_title "企业质量档案" %>
<% set_page_description "HOLDLE 企业质量档案：基于金字塔评分与财报口径，逐家拆解上市公司的赚钱效率、资产质量与成长性（付费会员内容）。" %>
<% set_page_keywords "企业质量档案,金字塔评分,财报分析,个股研究" %>
<div class="py-16">
  <div class="container-narrow-flush">
    <div class="label-en px-6 md:px-0">QUALITY ARCHIVE - HOLDLE</div>
    <h1 class="text-hl-22 font-semibold text-ink mb-2 px-6 md:px-0">企业质量档案</h1>
    <p class="text-hl-13 text-muted-3 mb-7 px-6 md:px-0">
      基于金字塔评分与财报口径，逐家拆解上市公司的赚钱效率、资产质量与成长性。正文为付费会员权益，
      可先到<%= link_to '金字塔评分榜', pyramid_path, class: 'text-link hover:text-link-hover transition-colors' %>查任意股票的总分。
    </p>

    <div class="grid grid-cols-1 gap-6 md:gap-4">
      <% @profiles.each do |profile| %>
        <%= link_to "/archive/#{profile.stock.symbol}/#{profile.period_url_code}",
            class: 'hl-card hl-card-hover block transition-colors' do %>
          <div class="p-6 sm:p-7">
            <div class="flex items-start gap-3 mb-2">
              <h2 class="text-hl-16 font-semibold text-ink flex-1 min-w-0"><%= profile.title %></h2>
              <span class="shrink-0 inline-flex px-2 py-0.5 text-hl-11 font-medium bg-bg-mute text-muted-3 border border-line-soft rounded">会员</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-hl-12 text-muted-3">
              <span class="text-ink font-medium"><%= profile.stock.name %>（<%= profile.stock.symbol %>）</span>
              <span><%= profile.period %></span>
              <span class="font-mono">金字塔 <%= profile.meta["pyramid_score"] %></span>
            </div>
            <% if profile.published_at.present? %>
              <div class="mt-3 text-hl-12 text-muted-4"><%= l(profile.published_at.to_date, format: :long) %> 发布</div>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if @profiles.empty? %>
        <div class="hl-card py-16 text-center">
          <p class="text-hl-14 text-muted-4">档案制作中，敬请期待</p>
        </div>
      <% end %>
    </div>

    <% if @profiles.total_pages > 1 %>
      <div class="mt-8 px-6 md:px-0"><%= paginate @profiles %></div>
    <% end %>
  </div>
</div>
