<% set_page_title "金字塔评分 - 股票智能排行" %>
<% set_page_description "查看全市场股票的金字塔评分排名，从财务健康度、盈利能力、成长性等多维度筛选优质股票。" %>
<% set_page_keywords "金字塔评分,股票排行,智能选股,财务健康,多维度评分" %>
<% add_json_ld(pyramid_breadcrumb_json_ld) %>
<div class="min-h-screen bg-bg-soft" id="pyramid-page">
  <style>
    #pyramid-page.radar-fixed .radar-card {
      position: fixed;
      z-index: 40;
    }
    #pyramid-page.radar-fixed .radar-column {
      min-height: var(--radar-card-height, 0px);
    }
    @media (max-width: 1023px) {
      #pyramid-page.radar-fixed .radar-card {
        position: static;
        z-index: auto;
      }
      #pyramid-page.radar-fixed .radar-column {
        min-height: auto;
      }
    }
  </style>

  <main class="container-hl py-8">
    <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0">金字塔评分 - 全市场股票智能排行</h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="radar-column">
        <div class="hl-card radar-card">
          <div class="px-6 py-4 border-b border-line bg-bg-mute">
            <h2 class="text-hl-16 font-semibold text-ink-soft">雷达对比图</h2>
          </div>
          <div class="p-6">
            <div class="relative h-80">
              <canvas id="radar-chart"></canvas>
            </div>
            <div id="chart-legend-pyramid" class="flex justify-center items-center space-x-6 mt-4 text-hl-13">
              <div class="flex items-center space-x-2">
                <span class="w-3 h-3 bg-red-500 rounded-full inline-block"></span>
                <span class="text-muted-2 text-hl-11" id="base-label"><%= @compare_data ? @compare_data[:base][:display_name] : '行业第一' %></span>
              </div>
              <div class="flex items-center space-x-2 hidden" id="compare-legend">
                <span class="w-3 h-3 bg-blue-500 rounded-full inline-block"></span>
                <span class="text-muted-2 text-hl-11" id="compare-label"></span>
              </div>
            </div>
          </div>

          <%# 金字塔评分说明区（与雷达图同卡片，随雷达图一起固定悬浮） %>
          <div class="border-t border-line">
            <div class="px-6 py-4 border-b border-line bg-bg-mute">
              <h2 class="text-hl-16 font-semibold text-ink-soft">金字塔评分怎么算</h2>
            </div>
            <div class="p-6">
              <p class="text-hl-13 text-muted leading-relaxed mb-5">
                金字塔评分 = <span class="text-ink font-medium">6 项财务质量指标</span>（满分 1000 分）
                + <span class="text-ink font-medium">2 项成长趋势加减分</span>，
                衡量一家公司的赚钱效率、规模与成长性。
              </p>
              <div class="overflow-x-auto md-table-wrap">
                <table class="hl-table">
                  <thead>
                    <tr>
                      <th>指标</th>
                      <th>权重</th>
                      <th>说明</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>ROE 净资产收益率</td>
                      <td><span class="hl-tag">核心</span></td>
                      <td>赚钱效率，评分核心</td>
                    </tr>
                    <tr>
                      <td>净利润规模</td>
                      <td><span class="hl-tag">重要</span></td>
                      <td>体量决定抗风险能力</td>
                    </tr>
                    <tr>
                      <td>ROA 总资产回报率</td>
                      <td><span class="hl-tag">重要</span></td>
                      <td>剔除杠杆的真实赚钱能力</td>
                    </tr>
                    <tr>
                      <td>总资产周转率</td>
                      <td><span class="hl-tag">辅助</span></td>
                      <td>资产运营效率</td>
                    </tr>
                    <tr>
                      <td>毛利率</td>
                      <td><span class="hl-tag">辅助</span></td>
                      <td>护城河深浅</td>
                    </tr>
                    <tr>
                      <td>现金占总资产比率</td>
                      <td><span class="hl-tag">辅助</span></td>
                      <td>抗风险缓冲</td>
                    </tr>
                    <tr>
                      <td>净利润增长趋势</td>
                      <td><span class="hl-tag">加减分</span></td>
                      <td>近年成长性</td>
                    </tr>
                    <tr>
                      <td>经营现金流增长趋势</td>
                      <td><span class="hl-tag">加减分</span></td>
                      <td>现金流的成长性</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="px-6 py-4 border-t border-line bg-bg-mute flex items-center justify-between gap-4">
              <% if @is_member %>
                <p class="text-hl-13 text-muted">板块 / 行业筛选、完整榜单已为你解锁</p>
                <span class="hl-btn bg-bg-mute text-muted-4 border-line cursor-not-allowed hover:border-line shrink-0">已解锁</span>
              <% else %>
                <p class="text-hl-13 text-muted">板块 / 行业筛选、完整榜单为会员专属功能</p>
                <%= link_to "了解会员权益", join_path, class: "hl-btn hl-btn-primary shrink-0" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="pyramid-column">
        <div class="hl-card">
          <%# 非会员示例条数：标题与右侧提示共用同一值，避免与控制器 DEMO_* 常量各写一份 %>
          <% demo_rows = @stocks.size unless @is_member %>
          <div class="px-6 py-4 border-b border-line bg-bg-mute flex items-center justify-between gap-2">
            <h2 class="text-hl-16 font-semibold text-ink-soft"><%= @is_member ? '金字塔排行榜' : "示例：#{market_label(@market)} #{@sector} 板块金字塔分 Top #{demo_rows}" %></h2>
            <% unless @is_member %>
              <span class="text-hl-12 text-muted-3 shrink-0">示例仅展示前 <%= demo_rows %> 条</span>
            <% end %>
          </div>
          <div class="px-6 py-4 border-b border-line relative">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 <%= 'opacity-60 pointer-events-none select-none' unless @is_member %>">
              <div class="flex items-center gap-1.5 flex-1 min-w-0 sm:shrink-0">
                <label class="text-hl-13 font-medium text-muted-2 w-10 shrink-0">市场</label>
                <select name="market" id="pyramid-market" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full sm:w-24 bg-white" <%= 'disabled' unless @is_member %>>
                  <option value="CN" <%= 'selected' if @market == 'CN' %>>A股</option>
                  <option value="HK" <%= 'selected' if @market == 'HK' %>>港股</option>
                  <option value="US" <%= 'selected' if @market == 'US' %>>美股</option>
                </select>
              </div>

              <div class="flex items-center gap-1.5 sm:flex-1 sm:min-w-0">
                <label class="text-hl-13 font-medium text-muted-2 w-10 shrink-0">板块</label>
                <div id="sector-container" class="flex-1 min-w-0">
                  <select name="sector" id="pyramid-sector" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full min-w-28 bg-white" <%= 'disabled' unless @can_select_sector %>>
                    <% if @can_select_sector %>
                      <option value="">全部</option>
                    <% end %>
                    <% @sectors.each do |sector| %>
                      <option value="<%= sector %>" <%= 'selected' if @sector == sector %>><%= sector %></option>
                    <% end %>
                  </select>
                </div>
              </div>

              <div class="flex items-center gap-1.5 sm:flex-1 sm:min-w-0">
                <label class="text-hl-13 font-medium text-muted-2 w-10 shrink-0">行业</label>
                <div id="industry-container" class="flex-1 min-w-0">
                  <% if @can_select_sector && @sector.present? %>
                    <select name="industry" id="pyramid-industry" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full min-w-28 bg-white">
                      <option value="">全部</option>
                      <% @industries.each do |industry| %>
                        <option value="<%= industry %>" <%= 'selected' if @industry == industry %>><%= industry %></option>
                      <% end %>
                    </select>
                  <% else %>
                    <select name="industry" id="pyramid-industry" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full min-w-28 bg-white" disabled>
                      <option value="">全部</option>
                    </select>
                  <% end %>
                </div>
              </div>
            </div>

            <p id="sector-hint" class="text-hl-11 text-muted-3 mt-2 <%= 'hidden' if @can_select_sector %>">会员可查看其他行业</p>

            <% unless @is_member %>
              <%# 非会员遮罩：筛选区只读，引导加入会员 %>
              <div class="absolute inset-0 flex flex-col sm:flex-row items-center justify-center gap-2 px-4 bg-white/70">
                <p class="text-hl-13 text-muted text-center">市场 / 板块 / 行业筛选为会员专属功能</p>
                <%= link_to '加入会员', join_path, class: 'hl-btn hl-btn-primary shrink-0 text-hl-12' %>
              </div>
            <% end %>
          </div>

        <div id="pyramid-list-container">
          <div id="pyramid-stock-list" class="divide-y divide-line-soft">
            <% @stocks.each_slice(2) do |pair| %>
              <div class="grid grid-cols-1 md:grid-cols-2">
                <% pair.each do |stock| %>
                  <% global_index = @stocks.index(stock) + 1 %>
                  <% rank = (@page - 1) * 20 + global_index %>
                  <div class="stock-row flex items-center justify-between px-6 py-3 border-r border-line-soft last:border-r-0 cursor-pointer transition-colors duration-150 hover:bg-bg-mute"
                       data-stock-id="<%= stock.id %>"
                       data-stock-symbol="<%= stock.symbol %>"
                       data-stock-url="<%= stock_path(stock) %>"
                       data-stock-name="<%= stock.market == 'US' && stock.name&.include?('|') ? stock.name.split('|').first.strip : stock.name %>">
                    <div class="flex items-center space-x-3 min-w-0">
                      <span class="text-hl-11 font-mono text-muted-4 w-5 text-right shrink-0"><%= rank %></span>
                      <div class="min-w-0">
                        <div class="stock-name text-hl-13 font-medium text-ink truncate hover:text-link">
                          <%= stock.market == 'US' && stock.name&.include?('|') ? stock.name.split('|').first.strip : stock.name %>
                          <% if @is_member %>
                            <% (@tags[stock.id] || []).each do |tag| %>
                              <span class="ml-1 align-middle inline-block px-2 py-0.5 rounded-full text-hl-11 border <%= market_badge_class(@market) %>"
                                    title="<%= Stock.pyramid_tag_hint(tag) %>"><%= tag %></span>
                            <% end %>
                          <% else %>
                            <span class="ml-1 align-middle inline-block px-2 py-0.5 rounded-full text-hl-11 border border-line text-muted-3 font-mono">**</span>
                          <% end %>
                        </div>
                        <div class="text-hl-11 text-muted-3 truncate"><%= stock.symbol %></div>
                      </div>
                    </div>
                    <span class="stock-score font-semibold text-hl-13 shrink-0 ml-2 <%= @is_member ? 'text-link hover:text-link' : 'text-muted-3 font-mono' %>"><%= @is_member ? stock.pyramid_total_score : '**' %></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if @is_member %>
            <div id="pyramid-scroll-sentinel"
                 class="flex justify-center py-4 text-hl-13 text-muted-4 opacity-100 transition-opacity duration-300"
                 data-scroll-has-more="<%= @total_pages > 1 %>"
                 data-next-page="2"
                 data-per-page="<%= PyramidsController::PER_PAGE %>"
                 data-total-pages="<%= @total_pages %>"
                 data-market="<%= @market %>"
                 data-sector="<%= @sector || '' %>"
                 data-industry="<%= @industry || '' %>">
              <% if @total_pages > 1 %>
                <span class="flex items-center space-x-2"><span>滚动加载更多...</span></span>
              <% else %>
                <span>— 已全部加载 —</span>
              <% end %>
            </div>
          <% else %>
            <%# 非会员示例卡底部引导（示例不提供分页加载） %>
            <div class="px-6 py-4 border-t border-line bg-bg-mute flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <p class="text-hl-13 text-muted">完整榜单（全部市场 / 板块 / 行业）与金字塔分数为会员专属</p>
              <%= link_to '加入会员', join_path, class: 'hl-btn hl-btn-primary shrink-0' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
document.addEventListener('turbo:load', function initPyramidPage() {
  const pyramidPage = document.getElementById('pyramid-page');
  if (!pyramidPage) return;
  if (pyramidPage.dataset._initialized) return;
  pyramidPage.dataset._initialized = 'true';

  let chartInstance = null;
  let currentBaseStockId = '<%= @top_stock&.id || 0 %>';
  let initialBaseData = <%= @compare_data ? raw(@compare_data.to_json) : 'null' %>;
  let lastHoveredStockId = null;
  let pendingRequestId = 0;
  let hoverDebounceTimer = null;
  let canSelectSector = <%= @can_select_sector ? 'true' : 'false' %>;

  // 从服务器实时获取会员状态，解决页面被 Turbo 快照 / 浏览器缓存后权限状态过期的问题
  // 返回 true 表示页面权限状态与服务端一致（含请求失败保留原状态的兜底）
  const refreshPermission = async () => {
    try {
      // 加时间戳避免 CDN 返回缓存的过期权限数据
      const resp = await fetch(`/pyramid/permission?_=${Date.now()}`);
      const data = await resp.json();
      if (data.can_select_sector === canSelectSector) return true;
      // 与页面烘焙的权限不一致：会员墙、分数打码、下拉禁用态都是服务端渲染产物，本地无法补齐，
      // 直接重载以拿到与当前账号匹配的页面（重载后服务端值即真值，不会循环）
      location.reload();
      return false;
    } catch (e) {
      // 静默失败，保留页面原有状态
      return true;
    }
  };

  const initChart = (baseData, compareData = null) => {
    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }

    const ctx = document.getElementById('radar-chart');
    if (!ctx) return;

    const labels = ['ROE', '毛利率', '资产周转率', 'EPS', '现金比率', '净利率'];
    const baseValues = baseData ? [
      baseData.values.roe || 0,
      baseData.values.gross_margin || 0,
      baseData.values.asset_turnover_ratio || 0,
      baseData.values.eps || 0,
      baseData.values.cash_to_assets_ratio || 0,
      baseData.values.net_profit_margin || 0
    ] : [0, 0, 0, 0, 0, 0];

    const datasets = [{
      label: baseData ? (baseData.display_name || baseData.name) : '行业第一',
      data: baseValues,
      backgroundColor: 'rgba(239, 68, 68, 0.2)',
      borderColor: 'rgb(239, 68, 68)',
      borderWidth: 2,
      pointRadius: 3
    }];

    if (compareData) {
      const compareValues = [
        compareData.values.roe || 0,
        compareData.values.gross_margin || 0,
        compareData.values.asset_turnover_ratio || 0,
        compareData.values.eps || 0,
        compareData.values.cash_to_assets_ratio || 0,
        compareData.values.net_profit_margin || 0
      ];
      datasets.push({
        label: compareData.display_name || compareData.name,
        data: compareValues,
        backgroundColor: 'rgba(59, 130, 246, 0.2)',
        borderColor: 'rgb(59, 130, 246)',
        borderWidth: 2,
        pointRadius: 3
      });
      document.getElementById('compare-legend').style.display = 'flex';
      document.getElementById('compare-label').textContent = compareData.display_name || compareData.name;
    } else {
      document.getElementById('compare-legend').style.display = 'none';
    }

    chartInstance = new Chart(ctx, {
      type: 'radar',
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        scales: {
          r: {
            min: 0,
            max: 100,
            ticks: { stepSize: 20 },
            pointLabels: { font: { size: 11 } }
          }
        },
        plugins: {
          legend: { display: false }
        }
      }
    });
  };

  window.initChart = initChart;

  // 仅更新对比数据集，避免销毁重建图表
  const updateChartCompareData = (compareData) => {
    if (!chartInstance) return;

    if (compareData) {
      const compareValues = [
        compareData.values.roe || 0,
        compareData.values.gross_margin || 0,
        compareData.values.asset_turnover_ratio || 0,
        compareData.values.eps || 0,
        compareData.values.cash_to_assets_ratio || 0,
        compareData.values.net_profit_margin || 0
      ];

      if (chartInstance.data.datasets.length === 1) {
        chartInstance.data.datasets.push({
          label: compareData.display_name || compareData.name,
          data: compareValues,
          backgroundColor: 'rgba(59, 130, 246, 0.2)',
          borderColor: 'rgb(59, 130, 246)',
          borderWidth: 2,
          pointRadius: 3
        });
      } else if (chartInstance.data.datasets.length >= 2) {
        chartInstance.data.datasets[1].data = compareValues;
        chartInstance.data.datasets[1].label = compareData.display_name || compareData.name;
      }

      chartInstance.update('none');
      document.getElementById('compare-legend').style.display = 'flex';
      document.getElementById('compare-label').textContent = compareData.display_name || compareData.name;
    } else {
      if (chartInstance.data.datasets.length >= 2) {
        chartInstance.data.datasets.pop();
        chartInstance.update('none');
      }
      document.getElementById('compare-legend').style.display = 'none';
    }
  };

  // 雷达数据前端缓存 - 避免重复请求
  const radarDataCache = new Map();

  const loadCompareData = (compareId) => {
    if (hoverDebounceTimer) {
      clearTimeout(hoverDebounceTimer);
      hoverDebounceTimer = null;
    }

    if (compareId === lastHoveredStockId) return;
    lastHoveredStockId = compareId;

    if (!compareId) {
      updateChartCompareData(null);
      return;
    }

    if (compareId === currentBaseStockId) return;

    const cached = radarDataCache.get(compareId);
    if (cached) {
      updateChartCompareData(cached);
      return;
    }

    if (!currentBaseStockId) return;

    pendingRequestId++;
    const thisRequestId = pendingRequestId;

    fetch(`/pyramid/compare?base_id=${currentBaseStockId}&compare_id=${compareId}`)
      .then(response => response.json())
      .then(result => {
        if (thisRequestId !== pendingRequestId) return;
        if (result.success && result.data && result.data.compare) {
          radarDataCache.set(compareId, result.data.compare);
          updateChartCompareData(result.data.compare);
        }
      })
      .catch(e => console.error('加载对比数据失败:', e));
  };

  // 空函数保留向后兼容（已有调用点），hover 事件已改用委托方式
  const addRowEventListeners = () => {};

  // 使用事件委托绑定 hover 和点击事件到永不替换的祖先元素
  const pyramidPageEl = document.getElementById('pyramid-page');
  pyramidPageEl.addEventListener('mouseover', function(e) {
    const row = e.target.closest('.stock-row');
    if (!row) return;
    loadCompareData(row.dataset.stockId);
  });

  pyramidPageEl.addEventListener('mouseout', function(e) {
    const row = e.target.closest('.stock-row');
    if (!row) return;
    const to = e.relatedTarget;
    if (!to || row.contains(to)) return;
    pendingRequestId++;
    lastHoveredStockId = null;
    loadCompareData(null);
  });

  pyramidPageEl.addEventListener('click', function(e) {
    const row = e.target.closest('.stock-row');
    if (!row) return;
    const url = row.dataset.stockUrl;
    if (url) {
      window.open(url, '_blank');
    }
  });

  const updateSectors = async (market) => {
    try {
      const url = `/pyramid/update_sectors?market=${encodeURIComponent(market)}`;
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Accept': 'text/vnd.turbo-stream.html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!response.ok) {
        console.error('Sectors request failed:', response.status);
        return;
      }

      const html = await response.text();
      window.Turbo.renderStreamMessage(html);

      setTimeout(() => {
        setupSectorListener();
      }, 50);
    } catch (e) {
      console.error('Failed to update sectors:', e);
    }
  };

  const updateList = async (market, sector, industry) => {
    try {
      let url = `/pyramid/update_list?market=${encodeURIComponent(market)}`;
      if (sector && sector !== '') {
        url += `&sector=${encodeURIComponent(sector)}`;
      }
      if (industry && industry !== '') {
        url += `&industry=${encodeURIComponent(industry)}`;
      }

      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Accept': 'text/vnd.turbo-stream.html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!response.ok) {
        console.error('List request failed:', response.status);
        return;
      }

      const html = await response.text();
      window.Turbo.renderStreamMessage(html);

      // 重置滚动加载页码
      scrollCurrentPage = 1;
      scrollIsLoading = false;
      
      setTimeout(() => {
        radarDataCache.clear();
        const newTopStock = document.querySelector('.stock-row');
        if (newTopStock) {
          currentBaseStockId = newTopStock.dataset.stockId;
        }
        addRowEventListeners();
        setupScrollObserver();
        loadCompareData(null);
      }, 150);
    } catch (e) {
      console.error('Failed to update list:', e);
    }
  };

  const setupSectorListener = () => {
    const sectorSelect = document.getElementById('pyramid-sector');
    if (sectorSelect) {
      sectorSelect.removeEventListener('change', handleSectorChange);
      sectorSelect.addEventListener('change', handleSectorChange);
    }
  };

  const setupIndustryListener = () => {
    const industrySelect = document.getElementById('pyramid-industry');
    if (industrySelect) {
      industrySelect.removeEventListener('change', handleIndustryChange);
      industrySelect.addEventListener('change', handleIndustryChange);
    }
  };

  // 加载某板块下的行业列表并渲染下拉（默认选中「全部」）
  const loadIndustries = async (market, sector) => {
    try {
      const url = `/pyramid/update_industries?market=${encodeURIComponent(market)}&sector=${encodeURIComponent(sector)}`;
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Accept': 'text/vnd.turbo-stream.html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!response.ok) {
        console.error('Industries request failed:', response.status);
        return;
      }

      const html = await response.text();

      // 竞态保护：市场/板块已切换或权限已变化时，丢弃过期的行业列表响应
      const marketEl = document.getElementById('pyramid-market');
      const sectorEl = document.getElementById('pyramid-sector');
      if (!marketEl || !sectorEl || !canSelectSector) return;
      if (marketEl.value !== market || sectorEl.value !== sector) return;

      window.Turbo.renderStreamMessage(html);

      setTimeout(() => {
        setupIndustryListener();
      }, 50);
    } catch (e) {
      console.error('Failed to update industries:', e);
    }
  };

  const handleSectorChange = function() {
    if (!canSelectSector) {
      this.value = '公用事业';
      return;
    }
    const market = document.getElementById('pyramid-market').value;
    const sector = this.value;
    if (sector) {
      loadIndustries(market, sector);
    } else {
      // 板块选「全部」时行业下拉禁用并重置为「全部」
      const industrySelect = document.getElementById('pyramid-industry');
      if (industrySelect) {
        industrySelect.disabled = true;
        industrySelect.innerHTML = '<option value="">全部</option>';
      }
    }
    updateList(market, sector, '');
    rememberSelection({ market: market, sector: sector, industry: '' });
  };

  const handleIndustryChange = function() {
    if (!canSelectSector) return;
    const market = document.getElementById('pyramid-market').value;
    const sector = document.getElementById('pyramid-sector').value;
    updateList(market, sector, this.value);
    rememberSelection({ market: market, sector: sector, industry: this.value });
  };

  document.getElementById('pyramid-market').addEventListener('change', function() {
    // 非会员没有筛选权（下拉已 disabled，此处兜底脚本 / 扩展触发的 change），
    // 否则会请求已被服务端拦截的接口，出现「下拉已变、榜单未变」的不一致
    if (!canSelectSector) return;
    const market = this.value;
    document.getElementById('pyramid-sector').value = '';
    pendingRequestId++;
    updateSectors(market);
    updateList(market, '', '');
    rememberSelection({ market: market, sector: '', industry: '' });
  });

  // ---------- 记住上次选择的市场 / 板块 / 行业（localStorage，7 天有效） ----------
  const SELECTION_STORAGE_KEY = 'pyramid_last_v1';
  const SELECTION_TTL = 7 * 24 * 60 * 60 * 1000;
  // 合法市场取值，用于校验缓存数据（localStorage 可能被篡改或残留旧版本数据）
  const SELECTION_MARKETS = ['CN', 'HK', 'US'];

  const marketSelectEl = () => document.getElementById('pyramid-market');
  const sectorSelectEl = () => document.getElementById('pyramid-sector');
  const industrySelectEl = () => document.getElementById('pyramid-industry');

  // 读取当前三个下拉的值（服务端渲染结果或用户最新选择）
  const currentSelection = () => {
    const marketEl = marketSelectEl();
    const sectorEl = sectorSelectEl();
    const industryEl = industrySelectEl();
    return {
      market: marketEl ? marketEl.value : 'CN',
      sector: sectorEl ? sectorEl.value : '',
      industry: industryEl ? industryEl.value : ''
    };
  };

  const saveSelection = (selection) => {
    try {
      localStorage.setItem(SELECTION_STORAGE_KEY, JSON.stringify({ ...selection, ts: Date.now() }));
    } catch (e) { /* 无痕模式等存储不可用时静默忽略 */ }
  };

  // 同步到地址栏，保证刷新 / 分享链接得到同样的筛选结果
  const syncUrl = (selection) => {
    const params = new URLSearchParams();
    if (selection.market) params.set('market', selection.market);
    // 非会员没有板块/行业选择权，不把默认值「公用事业」写进地址栏
    if (canSelectSector && selection.sector) params.set('sector', selection.sector);
    if (canSelectSector && selection.industry) params.set('industry', selection.industry);
    const query = params.toString();
    const nextUrl = query ? `${location.pathname}?${query}` : location.pathname;
    if (nextUrl === location.pathname + location.search) return;
    // 透传 Turbo 写入的 history.state，避免破坏 Turbo 的历史记录
    history.replaceState(history.state, '', nextUrl);
  };

  // 用户每次改变筛选条件后记录：市场 + 板块 + 行业
  const rememberSelection = (selection) => {
    const data = selection || currentSelection();
    saveSelection(data);
    syncUrl(data);
  };

  // 无参数进入时套用缓存；URL 已带条件时以 URL 为准（不写缓存）
  // 仅会员调用（调用处已用 canSelectSector 门控）
  // 三级下拉的选项必须由服务端按「市场 → 板块 → 行业」重建（板块列表随市场变、行业列表随板块变），
  // 而前端异步级联的赋值会被 Turbo 流异步替换 DOM 冲掉（下拉看着恢复了、实际没选中），
  // 故不再前端拼装选项，改为带参数访问同一页面，由服务端一次性渲染出正确的三级下拉与榜单
  const restoreSelection = () => {
    if (!marketSelectEl()) return;

    const urlParams = new URLSearchParams(location.search);
    // 分享/收藏链接带来的条件只用于本次渲染，不覆盖用户自己的偏好
    if (['market', 'sector', 'industry'].some((key) => urlParams.has(key))) return;

    let saved = null;
    try {
      saved = JSON.parse(localStorage.getItem(SELECTION_STORAGE_KEY));
    } catch (e) {
      return;
    }
    if (!saved || Date.now() - (saved.ts || 0) > SELECTION_TTL) return;

    const target = {
      market: SELECTION_MARKETS.includes(saved.market) ? saved.market : 'CN',
      sector: saved.sector || '',
      // 板块为「全部」时行业必然为空，避免残留上次的行业条件
      industry: saved.sector ? (saved.industry || '') : ''
    };
    const initial = currentSelection();
    // 与当前页面一致时无需重新加载，避免多余请求
    if (target.market === initial.market && target.sector === initial.sector && target.industry === initial.industry) return;

    const params = new URLSearchParams();
    params.set('market', target.market);
    if (target.sector) params.set('sector', target.sector);
    if (target.industry) params.set('industry', target.industry);
    // 目标板块 / 行业已下线时服务端渲染的选项里不会有它，浏览器自然回退为「全部」
    window.Turbo.visit(`${location.pathname}?${params.toString()}`, { action: 'replace' });
  };

  // 无限滚动加载（v3 - 使用 JS 变量维护页码，避开 Turbo replace 不生效的 Bug）
  console.log('[Scroll] 金字塔页面加载，使用 v3 滚动加载机制（JS 变量维护页码）');
  let scrollObserver = null;
  let scrollIsLoading = false;
  // 每页条数由服务端下发（哨兵 data-per-page），避免前端硬编码与 PyramidsController::PER_PAGE 漂移
  const sentinelPerPage = () => {
    const sentinel = document.getElementById('pyramid-scroll-sentinel');
    const value = parseInt(sentinel && sentinel.dataset.perPage, 10);
    return Number.isFinite(value) && value > 0 ? value : 20;
  };
  // 当前页码以「列表里已渲染的股票条数」为准：页面被整页替换或列表被重建后，
  // 闭包内的游标可能落后于 DOM，按陈旧游标请求会把渲染过的分块再追加一遍
  const renderedPageCount = () => {
    const list = document.getElementById('pyramid-stock-list');
    if (!list) return 1;
    return Math.max(1, Math.ceil(list.querySelectorAll('.stock-row').length / sentinelPerPage()));
  };
  let scrollCurrentPage = renderedPageCount();
  // 本闭包失效标记（页面被 Turbo 整页替换时置位）：
  // loadNextPage 每次都重新 getElementById 取哨兵，若不失效，旧闭包会「复活」并按新哨兵的
  // 筛选条件继续加载，把分块重复追加到新页面的列表尾部
  let scrollDisposed = false;
  // 失效判定的第二道保险：登录态页面的 layout 注入了 turbo-cache-control: no-cache
  //（app/views/layouts/application.html.erb），Turbo 的 view.cacheSnapshot 在
  // snapshot.isCacheable 为 false 时直接返回，不会派发 turbo:before-cache，
  // 只靠上面的标记会漏掉「页面已整页替换」；改用 window 级代际号后，新页面一初始化，
  // 所有旧闭包（含在途 fetch、已排队的定时器与观察器回调）立即失效
  const scrollGeneration = (window.__pyramidScrollGeneration || 0) + 1;
  window.__pyramidScrollGeneration = scrollGeneration;
  const scrollStale = () => scrollDisposed || window.__pyramidScrollGeneration !== scrollGeneration;

  const setupScrollObserver = () => {
    if (scrollStale()) return;

    if (scrollObserver) {
      scrollObserver.disconnect();
      scrollObserver = null;
    }

    const sentinel = document.getElementById('pyramid-scroll-sentinel');
    if (!sentinel) {
      console.log('[Scroll] sentinel 元素未找到');
      return;
    }

    const totalPages = parseInt(sentinel.dataset.totalPages || 1);
    const hasMore = scrollCurrentPage < totalPages;
    console.log('[Scroll] setupScrollObserver: hasMore=' + hasMore + ', currentPage=' + scrollCurrentPage + ', totalPages=' + totalPages);
    if (!hasMore) return;

    scrollObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        console.log('[Scroll] Observer回调: isIntersecting=' + entry.isIntersecting + ', isLoading=' + scrollIsLoading);
        if (!entry.isIntersecting || scrollIsLoading) return;
        console.log('[Scroll] sentinel 进入视口，触发加载下一页');
        loadNextPage();
      });
    }, { rootMargin: '300px' });

    scrollObserver.observe(sentinel);
    console.log('[Scroll] IntersectionObserver 已绑定到 sentinel');
  };

  const loadNextPage = async () => {
    const sentinel = document.getElementById('pyramid-scroll-sentinel');
    if (scrollStale() || !sentinel || scrollIsLoading) {
      console.log('[Scroll] loadNextPage 跳过: stale=' + scrollStale() + ', sentinel=' + !!sentinel + ', isLoading=' + scrollIsLoading);
      return;
    }

    const totalPages = parseInt(sentinel.dataset.totalPages || 1);
    // 每次请求前按 DOM 实际条数校正游标，保证不会重取已渲染过的分块
    scrollCurrentPage = Math.max(scrollCurrentPage, renderedPageCount());
    const nextPage = scrollCurrentPage + 1;
    
    if (nextPage > totalPages) {
      console.log('[Scroll] loadNextPage 跳过: nextPage=' + nextPage + ' > totalPages=' + totalPages);
      sentinel.dataset.scrollHasMore = 'false';
      sentinel.innerHTML = '<span>— 已全部加载 —</span>';
      return;
    }

    const market = sentinel.dataset.market || 'CN';
    const sector = sentinel.dataset.sector || '';
    const industry = sentinel.dataset.industry || '';
    console.log('[Scroll] loadNextPage: 开始加载 page=' + nextPage + ', market=' + market + ', sector=' + sector + ', industry=' + industry);

    scrollIsLoading = true;
    sentinel.innerHTML = '<span class="flex items-center space-x-2"><svg class="animate-spin h-4 w-4 text-gray-400" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg><span>加载中...</span></span>';

    try {
      let url = `/pyramid/load_more?page=${nextPage}&market=${encodeURIComponent(market)}`;
      if (sector) {
        url += `&sector=${encodeURIComponent(sector)}`;
      }
      if (industry) {
        url += `&industry=${encodeURIComponent(industry)}`;
      }

      const response = await fetch(url, {
        headers: {
          'Accept': 'text/vnd.turbo-stream.html',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (!response.ok) throw new Error('请求失败');

      const html = await response.text();
      // 响应期间页面可能已被 Turbo 整页替换（如恢复筛选触发的 Turbo.visit），或列表容器被 updateList 换掉：
      // 此时哨兵已不是发起请求时的那个元素，必须丢弃本次响应，否则会追加到新页面的列表里造成重复
      if (scrollStale() || document.getElementById('pyramid-scroll-sentinel') !== sentinel) {
        console.log('[Scroll] 页面已切换，丢弃本次响应 page=' + nextPage);
        scrollIsLoading = false;
        return;
      }
      console.log('[Scroll] 收到响应，长度=' + html.length + ' chars');
      
      window.Turbo.renderStreamMessage(html);
      
      // 用 JS 变量更新页码，不依赖 Turbo replace 是否生效
      scrollCurrentPage = nextPage;
      scrollIsLoading = false;
      
      // 手动更新 sentinel 的 data 属性和文本
      const updatedSentinel = document.getElementById('pyramid-scroll-sentinel');
      if (updatedSentinel) {
        const hasMore = scrollCurrentPage < parseInt(updatedSentinel.dataset.totalPages || 1);
        updatedSentinel.dataset.scrollHasMore = hasMore ? 'true' : 'false';
        updatedSentinel.dataset.nextPage = String(scrollCurrentPage + 1);
        
        if (hasMore) {
          updatedSentinel.innerHTML = '<span>滚动加载更多...</span>';
        } else {
          updatedSentinel.innerHTML = '<span>— 已全部加载 —</span>';
        }
        
        console.log('[Scroll] 手动更新 sentinel: currentPage=' + scrollCurrentPage + 
          ', hasMore=' + hasMore + ', nextPage=' + updatedSentinel.dataset.nextPage);
      }

      console.log('[Scroll] Turbo渲染完成，重新配置观察器');
      setupScrollObserver();

      // 主动检查：Turbo 异步 append 后，sentinel 可能已被推出视口
      // IntersectionObserver 不会对已在视口外的元素触发，需手动检测
      setTimeout(() => {
        if (scrollStale()) return;

        const checkSentinel = document.getElementById('pyramid-scroll-sentinel');
        if (checkSentinel && !scrollIsLoading && scrollCurrentPage < parseInt(checkSentinel.dataset.totalPages || 1)) {
          const rect = checkSentinel.getBoundingClientRect();
          const windowHeight = window.innerHeight || document.documentElement.clientHeight;
          const isVisible = rect.top < windowHeight + 300 && rect.bottom > 0;
          console.log('[Scroll] 主动检查: rect.top=' + rect.top + ', windowHeight=' + windowHeight + ', isVisible=' + isVisible);
          if (isVisible) {
            console.log('[Scroll] sentinel 仍在视口内，自动触发下一页');
            loadNextPage();
            return;
          }
        }
        addRowEventListeners();
      }, 200);
    } catch (e) {
      scrollIsLoading = false;
      const currentSentinel = document.getElementById('pyramid-scroll-sentinel');
      if (currentSentinel) {
        currentSentinel.innerHTML = '<div class="flex flex-col items-center space-y-2 py-4"><span class="text-red-500">加载失败</span></div>';
        setTimeout(() => {
          const retrySentinel = document.getElementById('pyramid-scroll-sentinel');
          if (retrySentinel && scrollCurrentPage < parseInt(retrySentinel.dataset.totalPages || 1)) {
            setupScrollObserver();
            loadNextPage();
          }
        }, 3000);
      } else {
        setTimeout(setupScrollObserver, 1000);
      }
    }
  };

  // 非会员看到的是示例（无 sentinel），不启用无限滚动
  if (canSelectSector) setupScrollObserver();

  // 雷达图固定定位滚动处理
  let radarScrollHandler = null;
  let radarResizeHandler = null;

  const initRadarFixed = () => {
    const radarCard = document.querySelector('.radar-card');
    const radarColumn = document.querySelector('.radar-column');
    const pageContainer = document.getElementById('pyramid-page');
    const navbar = document.querySelector('nav');
    if (!radarCard || !radarColumn || !pageContainer) return;

    const getFixedTop = () => {
      if (navbar) return navbar.offsetHeight;
      return 0;
    };

    const updateRadarPosition = () => {
      if (window.innerWidth < 1024) {
        pageContainer.classList.remove('radar-fixed');
        radarCard.style.width = '';
        radarCard.style.left = '';
        radarCard.style.top = '';
        radarCard.style.maxHeight = '';
        radarCard.style.overflowY = '';
        radarColumn.style.setProperty('--radar-card-height', '0px');
        return;
      }

      const radarCardRect = radarCard.getBoundingClientRect();
      const fixedTop = getFixedTop();
      // 触发阈值：导航栏下方32px
      const stickyThreshold = fixedTop + 32;

      if (radarCardRect.top <= stickyThreshold) {
        pageContainer.classList.add('radar-fixed');
        const columnRect = radarColumn.getBoundingClientRect();
        radarCard.style.width = columnRect.width + 'px';
        radarCard.style.left = columnRect.left + 'px';
        radarCard.style.top = stickyThreshold + 'px';   // ← 固定值，始终对齐
        // 矮视口下限制卡片高度并允许内部滚动，保证底部 CTA 可达
        radarCard.style.maxHeight = (window.innerHeight - stickyThreshold - 16) + 'px';
        radarCard.style.overflowY = 'auto';
        radarColumn.style.setProperty('--radar-card-height', radarCard.offsetHeight + 'px');
      } else {
        pageContainer.classList.remove('radar-fixed');
        radarCard.style.width = '';
        radarCard.style.left = '';
        radarCard.style.top = '';
        radarCard.style.maxHeight = '';
        radarCard.style.overflowY = '';
        radarColumn.style.setProperty('--radar-card-height', '0px');
      }
    };

    let ticking = false;
    radarScrollHandler = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateRadarPosition();
          ticking = false;
        });
        ticking = true;
      }
    };

    document.addEventListener('scroll', radarScrollHandler, { passive: true });
    updateRadarPosition();

    radarResizeHandler = () => {
      updateRadarPosition();
    };
    window.addEventListener('resize', radarResizeHandler);
  };

  initRadarFixed();

  function cleanupBeforeCache() {
    // 先注销自身的两个监听：initPyramidPage 每次整页渲染都会执行一次，
    // 不注销会让监听器随访问次数累积，且回调闭包长期持有已分离的旧页面 DOM
    //（与订单页「先移除旧监听再挂载」的处理方式一致）
    document.removeEventListener('turbo:before-cache', cleanupBeforeCache);
    document.removeEventListener('turbo:before-render', cleanupBeforeCache);
    // 移除初始化标记，确保 Turbo 恢复缓存页面时能重新初始化
    pyramidPage.removeAttribute('data-_initialized');
    // 失效本闭包：在途的 fetch 与已排队的定时器 / 观察器回调都不再允许写入 DOM，
    // 否则页面被整页替换后旧闭包会把分块追加到新页面的列表里（尾部重复）
    scrollDisposed = true;
    if (scrollObserver) {
      scrollObserver.disconnect();
      scrollObserver = null;
    }
    if (radarScrollHandler) {
      document.removeEventListener('scroll', radarScrollHandler);
    }
    if (radarResizeHandler) {
      window.removeEventListener('resize', radarResizeHandler);
    }
  }
  document.addEventListener('turbo:before-cache', cleanupBeforeCache);
  // 登录态页面带 turbo-cache-control: no-cache，Turbo 不会派发 turbo:before-cache，
  // 故同时挂在 turbo:before-render（每次整页替换前必触发）上，保证旧闭包在换 DOM 前失效
  document.addEventListener('turbo:before-render', cleanupBeforeCache);

  setupSectorListener();
  setupIndustryListener();
  addRowEventListeners();
  // 权限状态可能因 Turbo 快照而过期：先与服务端对齐（不一致会重载页面）
  // 非会员没有筛选权，不套用缓存选择（接口已被服务端拦截），也不启用无限滚动
  refreshPermission().then((permissionSynced) => {
    if (permissionSynced && canSelectSector) restoreSelection();
  });

  if (initialBaseData && initialBaseData.base) {
    initChart(initialBaseData.base);
  }
});
</script>
