<%# 本接口为会员专属（控制器 before_action 拦截），下拉恒为可交互状态 %>
<%= turbo_stream.replace 'industry-container' do %>
  <div id="industry-container" class="flex-1 min-w-0 sm:flex-none">
    <select name="industry" id="pyramid-industry" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full sm:w-40 bg-white">
      <option value="" <%= 'selected' if @industry.blank? %>>全部</option>
      <% @industries.each do |industry| %>
        <option value="<%= industry %>" <%= 'selected' if @industry == industry %>><%= industry %></option>
      <% end %>
    </select>
  </div>
<% end %>
