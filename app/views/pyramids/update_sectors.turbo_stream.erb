<%# 本接口为会员专属（控制器 before_action 拦截），下拉恒为可交互状态 %>
<%= turbo_stream.replace 'sector-container' do %>
<div id="sector-container" class="flex-1 min-w-0">
  <select name="sector" id="pyramid-sector" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full min-w-28 bg-white">
    <option value="">全部</option>
    <% @sectors.each do |sector| %>
      <option value="<%= sector %>"><%= sector %></option>
    <% end %>
  </select>
</div>
<% end %>

<%# 切换市场后 sector 已变化，旧 industry 失效，重置 industry 下拉为禁用「全部」 %>
<%= turbo_stream.replace 'industry-container' do %>
  <div id="industry-container" class="flex-1 min-w-0">
    <select name="industry" id="pyramid-industry" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-full bg-white" disabled>
      <option value="">全部</option>
    </select>
  </div>
<% end %>

<%# 会员提示单独维护，目标恒存在避免 Turbo replace 找不到元素 %>
<%= turbo_stream.replace 'sector-hint' do %>
  <p id="sector-hint" class="text-hl-11 text-muted-3 mt-2 hidden">会员可查看其他行业</p>
<% end %>
