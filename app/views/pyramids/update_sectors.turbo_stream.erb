<%= turbo_stream.replace 'sector-container' do %>
<div id="sector-container">
  <select name="sector" id="pyramid-sector" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-40 bg-white" <%= 'disabled' unless @can_select_sector %>>
    <% if @can_select_sector %>
      <option value="">全部</option>
    <% end %>
    <% @sectors.each do |sector| %>
      <option value="<%= sector %>" <%= 'selected' if !@can_select_sector && sector == '公用事业' %>><%= sector %></option>
    <% end %>
  </select>
  <% unless @can_select_sector %>
    <span class="text-hl-11 text-muted-3 ml-2">会员可查看其他行业</span>
  <% end %>
</div>
<% end %>

<%# 切换市场后 sector 已变化，旧 industry 失效，重置 industry 下拉为禁用「全部」 %>
<%= turbo_stream.replace 'industry-container' do %>
  <div id="industry-container">
    <select name="industry" id="pyramid-industry" class="px-3 py-2 text-hl-13 border border-line rounded focus:border-link w-40 bg-white" disabled>
      <option value="">全部</option>
    </select>
  </div>
<% end %>
