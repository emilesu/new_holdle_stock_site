<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:admin_title) ? content_for(:admin_title) : "管理后台" %> | HOLDLE</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# 后台恒为登录态，禁用 Turbo 快照缓存，防止跨会话恢复旧页面 %>
    <meta name="turbo-cache-control" content="no-cache">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-bg-soft min-h-screen">
    <nav class="bg-ink text-white" data-controller="mobile-menu">
      <div class="container-hl">
        <div class="flex justify-between items-center h-14">
          <div class="flex items-center space-x-4 min-w-0">
            <a href="<%= admin_root_path %>" class="text-hl-15 font-bold whitespace-nowrap shrink-0">管理后台</a>
            <%# 桌面端：按业务域分组的下拉导航（数据源与移动端菜单共用 admin_nav_groups） %>
            <div class="hidden md:flex items-center space-x-1" data-controller="admin-nav">
              <a href="<%= admin_root_path %>" class="<%= admin_nav_link_class(request.path == admin_root_path) %>">仪表盘</a>
              <% admin_nav_groups.each do |group| %>
                <% if group[:items].size == 1 %>
                  <%# 仅含一个页面的分组（如 AI）直接渲染为顶级链接，减少一次点击 %>
                  <% item = group[:items].first %>
                  <a href="<%= item[:url] %>" class="<%= admin_nav_link_class(admin_nav_active?(item[:url])) %>"><%= item[:label] %></a>
                <% else %>
                  <% group_active = group[:items].any? { |item| admin_nav_active?(item[:url]) } %>
                  <div class="relative">
                    <button type="button"
                            data-action="click->admin-nav#toggle"
                            aria-haspopup="true" aria-expanded="false"
                            class="<%= admin_nav_link_class(group_active) %> flex items-center gap-1 cursor-pointer select-none">
                      <%= group[:label] %>
                      <svg data-role="arrow" class="w-3 h-3 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                    <div data-role="menu"
                         class="hidden absolute left-0 top-full mt-2 min-w-40 py-1 bg-white border border-line rounded z-50
                                opacity-0 -translate-y-1 transition-all duration-150 ease-out
                                hl-dropdown-open:opacity-100 hl-dropdown-open:translate-y-0
                                hl-dropdown-closing:opacity-0 hl-dropdown-closing:-translate-y-1">
                      <% group[:items].each do |item| %>
                        <a href="<%= item[:url] %>"
                           class="block px-4 py-2 text-hl-13 <%= admin_nav_active?(item[:url]) ? 'text-ink bg-bg-mute font-medium' : 'text-muted hover:bg-bg-mute hover:text-ink' %>">
                          <%= item[:label] %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="flex items-center space-x-4 shrink-0">
            <div class="flex items-center space-x-3">
              <%= user_avatar_tag(current_user, size: "w-8 h-8") %>
              <div class="text-right hidden sm:block">
                <p class="text-hl-13 font-medium whitespace-nowrap"><%= current_user.nickname %></p>
                <p class="text-hl-12 text-muted-5 whitespace-nowrap"><%= human_role(current_user.role) %></p>
              </div>
            </div>
            <div class="hidden md:block">
              <%= link_to "退出", destroy_user_session_path, method: :delete, class: "text-muted-4 hover:text-white px-3 py-1.5 text-hl-13 transition-colors rounded whitespace-nowrap" %>
            </div>
            <button data-action="click->mobile-menu#toggle"
                    class="md:hidden p-2 hover:bg-white/10 rounded" aria-label="切换菜单">
              <svg data-mobile-menu-target="buttonIcon" class="w-[18px] h-[18px] text-muted-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <%# 移动端菜单 %>
      <div id="mobile-menu" data-mobile-menu-target="menu"
           class="hidden md:hidden bg-ink border-t border-white/10 overflow-hidden transition-[max-height] duration-200 ease-out">
        <div class="px-4 py-4 space-y-2">
          <a href="<%= admin_root_path %>" class="block px-3 py-2 text-hl-13 text-muted-4 hover:text-white hover:bg-white/10 rounded transition-colors">仪表盘</a>
          <% admin_nav_groups.each do |group| %>
            <%# 单元素分组（如 AI）不渲染标题，避免与子项重复 %>
            <% if group[:items].size > 1 %>
              <p class="px-3 pt-2 pb-1 text-hl-11 text-muted-5 tracking-wide-2"><%= group[:label] %></p>
            <% end %>
            <% group[:items].each do |item| %>
              <a href="<%= item[:url] %>" class="block px-3 py-2 text-hl-13 text-muted-4 hover:text-white hover:bg-white/10 rounded transition-colors"><%= item[:label] %></a>
            <% end %>
          <% end %>
          <div class="pt-3 mt-3 border-t border-white/10">
            <div class="flex items-center gap-3 px-3 py-2">
              <%= user_avatar_tag(current_user, size: "w-9 h-9") %>
              <div>
                <p class="text-hl-13 font-medium"><%= current_user.nickname %></p>
                <p class="text-hl-12 text-muted-5"><%= human_role(current_user.role) %></p>
              </div>
            </div>
            <%= link_to "退出", destroy_user_session_path, method: :delete,
                class: "block w-full text-left px-3 py-2 text-hl-13 text-muted-4 hover:text-white hover:bg-white/10 rounded transition-colors mt-1" %>
          </div>
        </div>
      </div>
    </nav>

    <div class="container-hl py-6">
      <% if notice %>
        <div data-controller="flash" class="mb-4 bg-bg-mute border border-line text-muted px-4 py-3 rounded flex items-center justify-between">
          <span><%= notice %></span>
          <button data-action="flash#dismiss" class="ml-4 text-muted-3 hover:text-ink transition-colors">&times;</button>
        </div>
      <% end %>
      <% if alert %>
        <div data-controller="flash" class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded flex items-center justify-between">
          <span><%= alert %></span>
          <button data-action="flash#dismiss" class="ml-4 text-red-400 hover:text-red-700 transition-colors">&times;</button>
        </div>
      <% end %>
      
      <%= yield %>
    </div>
  </body>
</html>