<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <meta name="keywords" content="<%= page_keywords %>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="canonical" href="https://www.holdle.com<%= request.path %>">

    <%# ===== Open Graph + Twitter Cards（默认跟随该页 title/description；og:url 与 canonical 同源） ===== %>
    <meta property="og:type" content="<%= page_og_type %>">
    <meta property="og:site_name" content="HOLDLE">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="https://www.holdle.com<%= request.path %>">
    <meta property="og:image" content="https://www.holdle.com/og-default.png">
    <meta name="twitter:card" content="summary_large_image">

    <%# ===== JSON-LD：全站 Organization + 各页自定义结构化数据（页面用 add_json_ld 追加） ===== %>
    <script type="application/ld+json"><%= raw json_escape(organization_json_ld.to_json) %></script>
    <%= yield :page_json_ld %>

    <%# 登录态页面禁用 Turbo 快照缓存：防止跨账号/登出后恢复旧快照（admin 按钮泄漏、后退弹回） %>
    <% if user_signed_in? %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>
    
    <%= render "shared/analytics" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
    <script>
      // Turbo 缓存前关闭移动端菜单，防止缓存快照中菜单打开导致状态错乱
      document.addEventListener('turbo:before-cache', function() {
        var menu = document.getElementById('mobile-menu');
        if (menu) {
          menu.classList.remove('mobile-menu-open');
          menu.classList.add('hidden');
        }
        var icon = document.querySelector('[data-mobile-menu-target="buttonIcon"]');
        if (icon) icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
      });
    </script>
  </head>

  <body data-controller="message">
    <%= render "shared/navbar" %>

    <%# 全站 flash 提示：前台此前没有渲染位置，notice/alert 写了却看不见 %>
    <% if notice || alert %>
      <div class="container-hl pt-4" data-flash-host>
        <% if notice %>
          <div data-controller="flash" class="mb-2 bg-bg-mute border border-line text-muted px-4 py-3 rounded flex items-center justify-between text-hl-13">
            <span><%= notice %></span>
            <button data-action="flash#dismiss" class="ml-4 text-muted-3 hover:text-ink transition-colors">&times;</button>
          </div>
        <% end %>
        <% if alert %>
          <div data-controller="flash" data-flash-delay-value="0" class="mb-2 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded flex items-center justify-between text-hl-13">
            <span><%= alert %></span>
            <button data-action="flash#dismiss" class="ml-4 text-red-400 hover:text-red-700 transition-colors">&times;</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- 主内容区 -->
    <main class="min-h-screen" id="main-content">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <script>
      // 股票搜索自动补齐功能 - 防竞态设计
      (function() {
        var searchState = null;

        function initStockSearch() {
          if (searchState) return;
          var searchInput = document.getElementById('stock-search-input');
          var suggestionsBox = document.getElementById('search-suggestions');
          var suggestionsList = document.getElementById('suggestions-list');
          var noResults = document.getElementById('no-results');

          if (!searchInput) return;

          var state = {
            selectedIndex: -1,
            currentResults: [],
            debounceTimer: null,
            requestCounter: 0,
            abortController: null
          };
          searchState = state;

          function hideSuggestions() {
            suggestionsBox.classList.add('hidden');
            state.selectedIndex = -1;
          }

          function abortPreviousRequest() {
            if (state.abortController) {
              state.abortController.abort();
            }
            state.abortController = new AbortController();
            return state.abortController;
          }

          function searchStocks(query) {
            if (query.length < 1) {
              state.currentResults = [];
              hideSuggestions();
              return;
            }

            var controller = abortPreviousRequest();
            var requestId = ++state.requestCounter;
            var signal = controller.signal;

            fetch('/stocks/autocomplete?q=' + encodeURIComponent(query), { signal: signal })
              .then(function(response) { return response.json(); })
              .then(function(data) {
                if (requestId !== state.requestCounter) return;
                state.currentResults = data;
                renderSuggestions(data);
              })
              .catch(function(error) {
                if (error.name === 'AbortError') return;
                console.error('搜索失败:', error);
              });
          }

          function renderSuggestions(results) {
            state.selectedIndex = -1;

            if (results.length === 0) {
              suggestionsList.innerHTML = '';
              suggestionsBox.classList.remove('hidden');
              noResults.classList.remove('hidden');
              return;
            }

            noResults.classList.add('hidden');
            suggestionsBox.classList.remove('hidden');

            suggestionsList.innerHTML = results.map(function(stock, index) {
              var marketClass = stock.market === 'CN'
                ? 'bg-green-100 text-green-700'
                : stock.market === 'HK'
                ? 'bg-amber-100 text-amber-700'
                : 'bg-blue-100 text-blue-700';

              return '<div class="suggestion-item px-4 py-3 hover:bg-gray-50 cursor-pointer transition-colors" data-index="' + index + '" data-url="' + stock.url + '" data-symbol="' + stock.symbol + '">' +
                '<div class="flex items-center justify-between">' +
                  '<div class="flex items-center space-x-3">' +
                    '<span class="px-2 py-0.5 text-xs font-medium rounded whitespace-nowrap ' + marketClass + '">' + stock.market_label + '</span>' +
                    '<span class="font-mono text-sm font-medium text-gray-800">' + stock.symbol + '</span>' +
                  '</div>' +
                  '<span class="text-sm text-gray-600 truncate max-w-[200px]" title="' + stock.name + '">' + stock.name + '</span>' +
                '</div>' +
              '</div>';
            }).join('');
          }

          function updateSelection() {
            var items = document.querySelectorAll('.suggestion-item');
            items.forEach(function(item, index) {
              if (index === state.selectedIndex) {
                item.classList.add('bg-blue-50', 'border-l-2', 'border-blue-500');
              } else {
                item.classList.remove('bg-blue-50', 'border-l-2', 'border-blue-500');
              }
            });
          }

          searchInput.addEventListener('input', function() {
            clearTimeout(state.debounceTimer);
            state.debounceTimer = setTimeout(function() {
              searchStocks(searchInput.value.trim());
            }, 300);
          });

          searchInput.addEventListener('keydown', function(e) {
            var items = document.querySelectorAll('.suggestion-item');

            if (e.key === 'ArrowDown') {
              e.preventDefault();
              state.selectedIndex = Math.min(state.selectedIndex + 1, items.length - 1);
              updateSelection();
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              state.selectedIndex = Math.max(state.selectedIndex - 1, -1);
              updateSelection();
            } else if (e.key === 'Enter') {
              e.preventDefault();
              if (state.selectedIndex >= 0 && items[state.selectedIndex]) {
                window.location.href = items[state.selectedIndex].dataset.url;
              }
            } else if (e.key === 'Escape') {
              // 两段式 Esc：先收起建议下拉，再次 Esc 退出搜索框焦点
              if (!suggestionsBox.classList.contains('hidden')) {
                hideSuggestions();
              } else {
                state.currentResults = [];
                searchInput.blur();
              }
            }
          });

          searchInput.addEventListener('focus', function() {
            if (state.currentResults.length > 0) {
              suggestionsBox.classList.remove('hidden');
            }
          });

          // 事件委托：下拉项点击跳转
          suggestionsBox.addEventListener('click', function(e) {
            var item = e.target.closest('.suggestion-item');
            if (item) {
              window.location.href = item.dataset.url;
            }
          });

          document.addEventListener('click', function(e) {
            var container = document.getElementById('search-container');
            if (container && !container.contains(e.target)) {
              hideSuggestions();
            }
          });
        }

        // 桌面端「直接敲键即搜索」：焦点不在输入框时，按字母/数字自动聚焦导航栏搜索框
        // Turbo 每次跳转都会重新执行本脚本，用 window 标记防止 document 级监听重复绑定
        if (!window.__hlTypeToSearchBound) {
          window.__hlTypeToSearchBound = true;
          document.addEventListener('keydown', function(e) {
            // 排除组合键、输入法组合输入中的按键
            if (e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
            // 仅字母、数字触发
            if (!/^[a-zA-Z0-9]$/.test(e.key)) return;
            // 仅桌面端（有精确指针设备）生效，移动端不启用
            if (!window.matchMedia('(pointer: fine)').matches) return;
            // 有可见的全屏遮罩/弹窗（如股票详情页指标弹窗）时不抢焦点
            const overlayVisible = Array.prototype.some.call(
              document.querySelectorAll('.fixed.inset-0'),
              function(el) { return el.getClientRects().length > 0; }
            );
            if (overlayVisible) return;
            // 焦点已在可编辑元素（输入框、文本域、下拉框、可编辑区域）内时不干预
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' ||
                active.tagName === 'SELECT' || active.isContentEditable)) return;
            const input = document.getElementById('stock-search-input');
            if (!input) return;
            // 聚焦后本次按键的默认行为会自动把字符输入到搜索框，无需手动赋值
            input.focus();
          });
        }

        // 搜索初始化（移动端菜单由 Stimulus mobile-menu controller 管理）
        document.addEventListener('turbo:load', function() {
          initStockSearch();
        });
      })();
    </script>

    <!-- 留言功能：右下角悬浮入口，点击进入微信式会话页；登录态显示未读回复红点；会话页内不重复显示 -->
    <% unless user_signed_in? && current_page?(messages_path) %>
      <% unread_replies = unread_messages_count %>
      <%= link_to messages_path, class: "message-float" do %>留言<% if unread_replies > 0 %><span class="message-badge"><%= unread_replies > 99 ? "99+" : unread_replies %></span><% end %><% end %>
    <% end %>
  </body>
</html>