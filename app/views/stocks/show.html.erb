<% set_stock_seo(@stock) %>
<% add_json_ld(stock_breadcrumb_json_ld(@stock)) %>
<!-- 股票详情页 -->
<div class="min-h-screen bg-bg-soft" id="stock-detail-page">

  <div class="container-hl py-8">


    <!-- 左右两列布局 -->
    <div class="main-container grid grid-cols-1 lg:grid-cols-[4fr_1fr] gap-6">
      <!-- 左列：80% -->
      <div class="space-y-6 min-w-0">

        <!-- 上半部分：股票基础信息 + 雷达图 -->
        <div class="bg-white hl-card overflow-hidden">
          <div class="p-6 top-card flex flex-col lg:flex-row gap-8">
            <!-- 公司信息 -->
            <div class="company-info flex-1 min-w-0">
              <h1 class="text-hl-22 font-bold text-ink">
                <% if @stock.market == 'US' && @stock.name.present? && @stock.name.include?('|') %>
                  <% parts = @stock.name.split('|', 2) %>
                  <%= parts.first %><span class="text-hl-13 font-medium text-muted-2"> - <%= parts.last %></span>
                <% else %>
                  <%= @stock.name.presence || '未命名股票' %>
                <% end %>
              </h1>
              <div class="flex items-center space-x-2 mt-2">
                <span class="text-muted-2 text-hl-13 font-mono"><%= @stock.symbol.presence || 'N/A' %></span>
                <span class="px-2 py-1 text-xs font-semibold rounded <%= @market_badge_bg %>">
                    <%= @stock.market == 'CN' ? 'A股' : @stock.market == 'HK' ? '港股' : '美股' %>
                  </span>
                  <span class="px-2 py-1 text-xs font-semibold rounded <%= @market_badge_bg %>">
                    <%= @stock.exchange.presence || '-' %>
                  </span>
              </div>
              <div class="border-t border-line-soft pt-4 mt-4 space-y-3">
                <div class="flex justify-between py-2">
                  <span class="text-muted-3 text-hl-11">所属板块</span>
                  <span class="px-2 py-1 text-xs font-semibold rounded <%= @market_badge_bg %>">
                    <%= @stock.sector.presence || '-' %>
                  </span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-3 text-hl-11">所属行业</span>
                  <span class="px-2 py-1 text-xs font-semibold rounded <%= @market_badge_bg %>">
                    <%= @stock.industry.presence || '-' %>
                  </span>
                </div>
                <%# 上市日期仅 A股/港股支持（东方财富 F10 同步，美股无该字段） %>
                <% if @stock.market.in?(%w[CN HK]) %>
                  <div class="flex justify-between py-2">
                    <span class="text-muted-3 text-hl-11">上市日期</span>
                    <span class="text-ink font-medium">
                      <%= @stock.listing_date ? @stock.listing_date.strftime('%Y-%m-%d') : '-' %>
                    </span>
                  </div>
                <% end %>
                <div class="flex justify-between py-2">
                  <span class="text-muted-3 text-hl-11">金字塔分</span>
                  <% if user_signed_in? && current_user.is_member? %>
                    <span class="text-ink font-medium"><%= @stock.pyramid_total_score %></span>
                  <% else %>
                    <span class="text-muted-4 text-hl-11">会员可见</span>
                  <% end %>
                </div>
                <% if @pyramid_tags.any? %>
                  <div class="flex flex-wrap gap-1.5 pt-3">
                    <% @pyramid_tags.each do |tag| %>
                      <span class="inline-block px-2 py-0.5 rounded-full text-hl-11 border <%= market_badge_class(@stock.market) %>"
                            title="<%= Stock.pyramid_tag_hint(tag) %>"><%= tag %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <%= turbo_frame_tag "follow_stock_#{@stock.id}" do %>
                <% if user_signed_in? && @user_favorite.present? %>
                  <%= button_to "已关注", user_favorite_path(@user_favorite, stock_id: @stock.id), method: :delete,
                    class: "w-full hl-btn hl-btn-line mt-4" %>
                <% elsif user_signed_in? %>
                  <%= button_to "收藏股票", user_favorites_path(stock_id: @stock.id), method: :post,
                    class: "w-full hl-btn hl-btn-primary mt-4" %>
                <% else %>
                  <%= link_to "收藏股票", new_user_session_path,
                    class: "w-full hl-btn hl-btn-primary mt-4 text-center block" %>
                <% end %>
              <% end %>
            </div>
            
            <!-- 雷达图数据存储（隐藏） -->
            <div id="radar-data" 
                 data-current='<%= @radar_data.to_json.html_safe if @radar_data %>'
                 class="hidden"></div>

            <!-- 雷达图 -->
            <div class="radar-section flex-1 min-w-0 border-t border-line lg:border-t-0 lg:border-l lg:border-l-line lg:pl-8 pt-4 lg:pt-0">
              <canvas id="radarChart" width="400" height="400" style="display: block; margin: 0 auto; max-width: 100%;"></canvas>
            <!-- 图例区域由 Chart.js 渲染 -->
          </div>
          </div>
        </div>
        
        <%# 四张财务表定义：年报列最多 20 年可横向滚动，右侧 2 列为季报同比（左：去年同期同一期次，右：最近一期定期报告） %>
        <%
          financial_unit = @stock.market == 'US' ? '美元' : (@stock.market == 'HK' ? '港币' : '元')
          financial_tables = [
            {
              title: '获利能力', en: 'Profitability', unit_note: "(单位：#{financial_unit})",
              rows: [
                ['净资产收益率（ROE）', :roe],
                ['总资产收益率（ROA）', :roa],
                ['毛利率', :gross_margin],
                ['净利率', :net_profit_margin],
                ['每股收益（EPS）', :eps]
              ]
            },
            {
              title: '财务结构', en: 'Financial Structure', unit_note: nil,
              rows: [
                ['现金占总资产比率', :cash_to_assets_ratio],
                ['负债占总资产比率', :asset_liab_ratio]
              ]
            },
            {
              title: '经营能力', en: 'Operating Capability', unit_note: nil,
              rows: [
                ['应收账款周转率(次)', :receivable_turnover],
                ['平均收现日数', :avg_collection_days],
                ['固定资产周转率(次)', :fixed_asset_turnover],
                ['总资产周转率', :asset_turnover_ratio]
              ]
            },
            {
              title: '现金流量', en: 'Cash Flow', unit_note: "(单位：亿#{financial_unit})",
              rows: [
                ['现金及现金等价物', :cash_and_cash_equivalents],
                ['净利润', :net_income],
                ['经营活动现金流量', :operating_cash_flow],
                ['投资活动现金流量', :investing_cash_flow],
                ['筹资活动现金流量', :financing_cash_flow],
                ['净现金流量', :net_cash_change]
              ]
            }
          ]
          last_quarter_index = @quarter_columns.size - 1
          market_col = market_financial_column_classes(@stock.market)
        %>

        <% financial_tables.each do |table| %>
        <div class="bg-white hl-card overflow-hidden <%= market_col[:hover] %>" data-controller="financial-table">
          <div class="px-6 py-4 border-b border-line">
            <h2 class="text-hl-16 font-semibold text-ink"><%= table[:title] %> <span class="text-hl-12 text-muted-4 ml-2"><%= table[:en] %></span><% if table[:unit_note] %> <span class="text-hl-12 text-muted-4 ml-2"><%= table[:unit_note] %></span><% end %></h2>
          </div>
          <div class="overflow-x-auto" data-financial-table-target="scroll" data-action="mouseover->financial-table#zoneEnter mouseleave->financial-table#zoneLeave">
            <table class="w-full">
              <thead>
                <tr>
                  <th class="text-left sticky left-0 bg-bg-soft z-20 min-w-30 px-6 py-3">指标</th>
                  <% if @financial_years.any? %>
                    <% @financial_years.each do |year| %>
                      <th class="w-hl-hero min-w-hl-hero px-4 py-3 text-right text-hl-11 font-semibold text-ink-soft whitespace-nowrap bg-bg-soft"><%= year %></th>
                    <% end %>
                  <% else %>
                    <th class="px-6 py-3 text-center text-hl-13 text-muted-4">暂无数据</th>
                  <% end %>
                  <%# 季报两列固定 120px：sticky 偏移 right-30 必须与列宽严格一致，宽度不足会导致两列重叠 %>
                  <% @quarter_columns.each_with_index do |column, index| %>
                    <th class="w-30 min-w-30 px-4 py-3 text-right text-hl-11 font-semibold text-ink-soft whitespace-nowrap sticky z-20 <%= market_col[:head] %> <%= index.zero? ? 'shadow-[-6px_0_6px_-6px_rgba(0,0,0,0.12)]' : '' %> <%= index == last_quarter_index ? 'right-0' : 'right-30' %>"><%= column[:label] %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-soft">
                <% table[:rows].each do |row_label, indicator_key| %>
                  <tr class="cursor-pointer indicator-row financial-row" data-indicator="<%= indicator_key %>">
                    <td class="px-6 py-3 text-hl-13 text-muted font-medium whitespace-nowrap sticky left-0 z-20 bg-white" data-hover-zone="annual"><%= row_label %></td>
                    <% if @financial_years.any? %>
                      <% @financial_years.each do |year| %>
                        <td class="w-hl-hero min-w-hl-hero px-4 py-3 text-right text-hl-13 text-muted-2" data-scope="annual" data-hover-zone="annual"><%= format_value(@financial_data_by_year[year][indicator_key], indicator_key) %></td>
                      <% end %>
                    <% else %>
                      <td class="px-6 py-3 text-center text-hl-13 text-muted-4">-</td>
                    <% end %>
                    <% @quarter_columns.each_with_index do |column, index| %>
                      <td class="w-30 min-w-30 px-4 py-3 text-right text-hl-13 text-muted-2 sticky z-20 <%= market_col[:cell] %> <%= index.zero? ? 'shadow-[-6px_0_6px_-6px_rgba(0,0,0,0.12)]' : '' %> <%= index == last_quarter_index ? 'right-0' : 'right-30' %>" data-scope="quarter" data-hover-zone="quarter"><%= format_value(column[:data][indicator_key], indicator_key) %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <% end %>

        <% if @quarter_columns.any? %>
          <p class="text-hl-11 text-muted-4 px-1">右侧两列为报告期累计口径同比（左：去年同期同一期次，右：最近一期季报，年报期次已在左侧列展示）；周转率类指标为报告期累计值，未做年化。</p>
        <% end %>
      </div>

      <!-- 右列：20% -->
      <div class="lg:col-span-1 min-w-0">
        <div class="sticky top-24 bg-white hl-card flex flex-col max-h-[calc(100vh-7.5rem)]">
          <div class="px-4 py-4 border-b border-line bg-bg-mute shrink-0">
            <span class="text-link font-semibold"><%= @stock.sector.presence || '-' %></span>
            <span class="text-muted-3 items-center justify-right text-hl-11">
              <%= @is_member ? ' - 行业金字塔对比' : ' - 近五年ROE对比' %>
            </span>
          </div>
          <div class="p-4 flex-1 min-h-0 hover-scroll">
            
            <div class="border-t border-line-soft">
              <% if @industry_comparison_data.present? %>
                <div class="divide-y divide-line-soft">
                  <% @industry_comparison_data.each_with_index do |item, index| %>
                    <% stock = item[:stock] %>
                    <% radar_data = @comparison_radar_data[stock.symbol] %>
                    <a href="<%= stock_path(stock) %>"
                       class="block py-3 transition-colors comparison-item <%= item[:is_current_stock] ? 'bg-blue-50' : 'hover:bg-bg-mute' %>"
                       data-symbol="<%= stock.symbol %>"
                       data-radar='<%= raw radar_data.to_json if radar_data %>'>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2 min-w-0">
                          <span class="w-5 h-5 rounded-full flex items-center justify-center text-hl-11 font-medium shrink-0
                            <%= item[:is_current_stock] ? 'bg-blue-500 text-white' : 'bg-bg-mute text-muted-2' %>">
                            <%= index + 1 %>
                          </span>
                          <div class="flex flex-col min-w-0">
                            <div class="flex items-center space-x-1 min-w-0">
                              <span class="text-hl-13 font-medium text-ink truncate"><%= stock.display_name_for_comparison %></span>
                              <% (@comparison_tags[stock.id] || []).each do |tag| %>
                                <span class="shrink-0 align-middle inline-block px-2 py-0.5 rounded-full text-hl-11 border <%= @market_badge_bg %>"
                                      title="<%= Stock.pyramid_tag_hint(tag) %>"><%= tag %></span>
                              <% end %>
                            </div>
                            <span class="text-hl-11 text-muted-4"><%= stock.symbol %></span>
                          </div>
                        </div>
                        <span class="text-hl-11 font-medium shrink-0 ml-2 <%= @market_text_color %>">
                          <%= @is_member ? item[:pyramid_score] : ('%.2f' % item[:roe_average]) + '%' %>
                        </span>
                      </div>
                    </a>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-8">
                  <div class="text-muted-4 mb-2">📊</div>
                  <p class="text-hl-13 text-muted-3">暂无同行业股票数据</p>
                  <p class="text-hl-11 text-muted-4 mt-1">需要至少3年财务数据才能参与对比</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <!-- 快速操作 -->
        <!--
        <div class="mt-6 bg-white hl-card p-4">
          <h3 class="text-hl-13 font-semibold text-ink-soft mb-4">快速操作</h3>
          <div class="space-y-2">
            <%= turbo_frame_tag "follow_stock_quick_#{@stock.id}" do %>
              <% if user_signed_in? && @user_favorite.present? %>
                <%= button_to "已收藏", user_favorite_path(@user_favorite, stock_id: @stock.id), method: :delete,
                  class: "w-full py-2 text-left text-hl-13 text-muted-2 hover:text-link hover:bg-bg-mute rounded transition-colors" %>
              <% elsif user_signed_in? %>
                <%= button_to "收藏股票", user_favorites_path(stock_id: @stock.id), method: :post,
                  class: "w-full py-2 text-left text-hl-13 text-muted-2 hover:text-link hover:bg-bg-mute rounded transition-colors" %>
              <% else %>
                <%= link_to "收藏股票", new_user_session_path,
                  class: "w-full py-2 text-left text-hl-13 text-muted-2 hover:text-link hover:bg-bg-mute rounded transition-colors block" %>
              <% end %>
            <% end %>
            <button class="w-full py-2 text-left text-hl-13 text-muted-2 hover:text-link hover:bg-bg-mute rounded transition-colors">查看历史走势</button>
            <button class="w-full py-2 text-left text-hl-13 text-muted-2 hover:text-link hover:bg-bg-mute rounded transition-colors">生成分析报告</button>
          </div>
        </div>
        -->
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('turbo:load', function() {
  let chartInstance = null;
  let currentStockData = null;
  let hoverTimeout = null;

  const labels = ['ROE', '毛利率', '资产周转率', 'EPS', '现金比率', '净利率'];

  function extractValues(data) {
    if (!data || !data.values) return [0, 0, 0, 0, 0, 0];
    var v = data.values;
    return [
      typeof v.roe === 'number' ? v.roe : 0,
      typeof v.gross_margin === 'number' ? v.gross_margin : 0,
      typeof v.asset_turnover_ratio === 'number' ? v.asset_turnover_ratio : 0,
      typeof v.eps === 'number' ? v.eps : 0,
      typeof v.cash_to_assets_ratio === 'number' ? v.cash_to_assets_ratio : 0,
      typeof v.net_profit_margin === 'number' ? v.net_profit_margin : 0
    ];
  }

  function initRadarChart(compareData) {
    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }

    var canvas = document.getElementById('radarChart');
    if (!canvas) return;

    var currentValues = extractValues(currentStockData);
    var datasets = [{
      label: currentStockData ? (currentStockData.display_name || currentStockData.name) : '当前股票',
      data: currentValues,
      backgroundColor: 'rgba(239, 68, 68, 0.2)',
      borderColor: 'rgb(239, 68, 68)',
      borderWidth: 2,
      pointRadius: 3,
      pointBackgroundColor: 'rgb(239, 68, 68)',
      pointBorderColor: '#fff',
      pointBorderWidth: 1
    }];

    if (compareData) {
      var compareValues = extractValues(compareData);
      datasets.push({
        label: compareData.display_name || compareData.name || '对比股票',
        data: compareValues,
        backgroundColor: 'rgba(59, 130, 246, 0.2)',
        borderColor: 'rgb(59, 130, 246)',
        borderWidth: 2,
        pointRadius: 3,
        pointBackgroundColor: 'rgb(59, 130, 246)',
        pointBorderColor: '#fff',
        pointBorderWidth: 1
      });
    }

    chartInstance = new Chart(canvas, {
       type: 'radar',
       data: { labels: labels, datasets: datasets },
       options: {
         responsive: true,
         maintainAspectRatio: true,
         animation: false,
         scales: {
           r: {
             min: 0,
             max: 100,
             ticks: { stepSize: 20, backdropColor: 'transparent' },
             pointLabels: { font: { size: 11 }, color: '#374151' },
             grid: { color: 'rgba(0, 0, 0, 0.1)' },
             angleLines: { color: 'rgba(0, 0, 0, 0.1)' }
           }
         },
         plugins: {
           legend: {
             display: true,
             position: 'bottom',
             labels: {
               usePointStyle: true,
               padding: 16,
               font: { size: 11 }
             }
           }
         }
       }
     });
  }

  var radarDataEl = document.getElementById('radar-data');
  if (radarDataEl && radarDataEl.dataset.current) {
    try {
      currentStockData = JSON.parse(radarDataEl.dataset.current);
      setTimeout(function() { initRadarChart(null); }, 100);
    } catch (e) {
      console.error('Parse radar data error:', e);
    }
  }

  document.querySelectorAll('.comparison-item').forEach(function(item) {
    item.addEventListener('mouseenter', function() {
      if (hoverTimeout) clearTimeout(hoverTimeout);
      var radarRaw = this.dataset.radar;
      if (!radarRaw) return;
      try {
        var compareData = JSON.parse(radarRaw);
        initRadarChart(compareData);
      } catch (e) {
        console.error('Parse comparison radar data error:', e);
      }
    });

    item.addEventListener('mouseleave', function() {
      hoverTimeout = setTimeout(function() {
        initRadarChart(null);
      }, 100);
    });
  });
});
</script>

<script>
// 财务指标弹窗功能 - 封装在IIFE中避免全局变量污染
(function() {
  const STOCK_PARAM = '<%= @stock.to_param %>';
  const CACHE_TTL = 300000; // 5分钟缓存
  let chartInstance = null;

  // 初始化事件监听（兼容Turbo）
  function initEventListeners() {
    document.querySelectorAll('.indicator-row').forEach(row => {
      row.removeEventListener('click', handleRowClick);
      row.addEventListener('click', handleRowClick);
    });

    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    if (backdrop) {
      backdrop.removeEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);
    }
    if (closeBtn) {
      closeBtn.removeEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
    }
  }

  function handleRowClick(event) {
    const indicatorKey = this.dataset.indicator;
    // 年报单元格看 20 年年度趋势，季报单元格看近 16 期季度趋势
    const cell = event.target.closest('[data-scope]');
    openIndicatorModal(indicatorKey, cell ? cell.dataset.scope : 'annual');
  }

  function openIndicatorModal(indicatorKey, scope) {
    const modal = document.getElementById('indicator-modal');
    const chartContainer = document.getElementById('chart-container');
    const contentContainer = document.getElementById('content-container');
    const errorContainer = document.getElementById('error-container');

    // 显示加载状态
    chartContainer.innerHTML = '<div class="flex items-center justify-center h-56"><div class="w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div></div>';
    contentContainer.classList.add('hidden');
    errorContainer.classList.add('hidden');

    // 显示弹窗（带过渡动画）
    modal.classList.remove('hidden');
    modal.classList.add('opacity-100');
    modal.querySelector('.relative').classList.add('scale-100');

    // 从缓存获取或调用API
    const cachedData = getCachedData(indicatorKey, scope);
    if (cachedData) {
      renderIndicatorModal(cachedData);
      return;
    }

    const url = new URL(`/stocks/${encodeURIComponent(STOCK_PARAM)}/indicator_detail`, window.location.origin);
    url.searchParams.set('indicator_key', indicatorKey);
    url.searchParams.set('scope', scope);
    
    fetch(url, {
      method: 'GET',
      headers: {
        'Accept': 'application/json'
      }
    })
      .then(res => {
        if (!res.ok) throw new Error('网络请求失败');
        return res.json();
      })
      .then(data => {
        if (data.success) {
          cacheData(indicatorKey, scope, data.data);
          renderIndicatorModal(data.data);
        } else {
          showError(data.error || '加载失败');
        }
      })
      .catch(err => {
        console.error('Load indicator error:', err);
        showError('加载失败，请稍后重试');
      });
  }

  function showError(message) {
    const errorContainer = document.getElementById('error-container');
    const contentContainer = document.getElementById('content-container');
    errorContainer.innerHTML = `<div class="bg-bg-mute rounded p-4"><p class="text-muted-2 text-center text-hl-11">${message}</p></div>`;
    errorContainer.classList.remove('hidden');
    contentContainer.classList.add('hidden');
  }

  function getCachedData(indicatorKey, scope) {
    try {
      const cacheKey = `indicator_${STOCK_PARAM}_${indicatorKey}_${scope}`;
      const cached = localStorage.getItem(cacheKey);
      if (cached) {
        const data = JSON.parse(cached);
        if (data.timestamp && Date.now() - data.timestamp < CACHE_TTL) {
          return data.payload;
        }
      }
    } catch (e) {
      console.warn('Cache read error:', e);
    }
    return null;
  }

  function cacheData(indicatorKey, scope, payload) {
    try {
      const cacheKey = `indicator_${STOCK_PARAM}_${indicatorKey}_${scope}`;
      localStorage.setItem(cacheKey, JSON.stringify({
        timestamp: Date.now(),
        payload: payload
      }));
    } catch (e) {
      console.warn('Cache write error:', e);
    }
  }

  function renderIndicatorModal(data) {
    const chartContainer = document.getElementById('chart-container');
    const contentContainer = document.getElementById('content-container');
    const errorContainer = document.getElementById('error-container');

    // 显示内容区域
    chartContainer.innerHTML = '<div style="height: 256px; overflow: hidden;"><canvas id="indicator-chart"></canvas></div>';
    contentContainer.classList.remove('hidden');
    errorContainer.classList.add('hidden');

    // 更新标题
    document.getElementById('modal-title').textContent = data.indicator_name;
    document.getElementById('indicator-description').textContent = data.description || '暂无说明';
    document.getElementById('indicator-formula').textContent = data.formula || '暂无公式';

    // 更新解读标准
    const interpretation = document.getElementById('indicator-interpretation');
    if (data.interpretation) {
      const order = ['excellent', 'good', 'normal', 'poor'];
      const labels = { excellent: '优秀', good: '良好', normal: '一般', poor: '较差' };

      interpretation.innerHTML = order.map(key => {
        if (data.interpretation[key]) {
          return `
            <div class="text-hl-11 text-muted-2 py-1">
              <span class="text-muted-3 font-medium">${labels[key]}：</span>
              ${data.interpretation[key]}
            </div>
          `;
        }
        return '';
      }).join('');
    } else {
      interpretation.innerHTML = '<p class="text-hl-11 text-muted-3">暂无解读标准</p>';
    }

    // 渲染图表
    renderIndicatorChart(data);
  }

  function renderIndicatorChart(data) {
    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }

    const ctx = document.getElementById('indicator-chart');
    if (!ctx) return;

    const points = data.data_points || [];
    // 后端直接给出 x 轴文案：年报为年份（2025），季报为期次（2026中报）
    const labels = points.map(p => p.label);

    // 季报口径提示：同一折线混排 3/6/9 个月累计值，需明确告知不可直接比较
    const scopeNote = document.getElementById('indicator-scope-note');
    if (scopeNote) scopeNote.classList.toggle('hidden', data.scope !== 'quarter');
    
    const isCashFlowIndicator = ['net_income', 'operating_cash_flow', 'investing_cash_flow', 'financing_cash_flow', 'net_cash_change', 'cash_and_cash_equivalents'].includes(data.indicator_key);
    const isAssetTurnover = data.indicator_key === 'asset_turnover_ratio';
    
    const values = points.map(p => {
      if (!p.value) return null;
      let val = parseFloat(p.value);
      if (isCashFlowIndicator) {
        return val / 100000000;
      }
      if (isAssetTurnover) {
        return val * 100;
      }
      return val;
    });
    
    const validValues = values.filter(v => v !== null && !isNaN(v));
    const dataMin = validValues.length > 0 ? Math.min(...validValues) : 0;
    const dataMax = validValues.length > 0 ? Math.max(...validValues) : 100;
    const dataRange = dataMax - dataMin;
    
    let yMin, yMax;
    if (dataRange > 0) {
      const padding = dataRange * 0.15;
      const absMax = Math.max(Math.abs(dataMin), Math.abs(dataMax));
      if (dataRange / absMax < 0.05) {
        yMin = dataMin - padding;
        yMax = dataMax + padding;
      } else {
        yMin = dataMin - padding;
        yMax = dataMax + padding;
      }
    } else {
      yMin = dataMin - 1;
      yMax = dataMax + 1;
    }
    
    const formatted = points.map(p => p.formatted);
    const unit = isCashFlowIndicator ? '亿' : (data.unit || '');

    chartInstance = new Chart(ctx.getContext('2d'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: data.indicator_name,
          data: values,
          borderColor: 'rgb(59, 130, 246)',
          backgroundColor: 'rgba(59, 130, 246, 0.08)',
          fill: true,
          tension: 0.3,
          pointRadius: 4,
          pointHoverRadius: 8,
          pointBackgroundColor: 'rgb(59, 130, 246)',
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          borderWidth: 2,
          pointHoverBorderWidth: 3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false,
          axis: 'x'
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            enabled: true,
            backgroundColor: 'rgba(30, 30, 30, 0.9)',
            titleFont: { size: 11, weight: '600' },
            bodyFont: { size: 10 },
            padding: 10,
            cornerRadius: 6,
            displayColors: false,
            usePointStyle: false,
            intersect: false,
            titleMarginBottom: 6,
            callbacks: {
              title: ctx => ctx[0].label,
              label: ctx => data.indicator_name + ': ' + (formatted[ctx.dataIndex] || '-')
            }
          }
        },
        scales: {
          y: {
            min: yMin,
            max: yMax,
            beginAtZero: false,
            grid: {
              color: 'rgba(0, 0, 0, 0.06)',
              drawBorder: false,
              lineWidth: 1
            },
            ticks: {
              callback: v => (unit ? v.toFixed(2) + unit : v.toFixed(2)),
              color: '#555555',
              font: { size: 9 },
              padding: 6
            }
          },
          x: {
            grid: { display: false },
            ticks: {
              color: '#555555',
              font: { size: 9, weight: '500' },
              padding: 4
            }
          }
        },
        animation: {
          duration: 400,
          easing: 'linear'
        },
        hover: {
          mode: 'nearest',
          intersect: false
        },
        responsiveAnimationDuration: 0
      }
    });
  }

  function closeModal() {
    const modal = document.getElementById('indicator-modal');
    const modalContent = document.getElementById('modal-content');

    // 直接隐藏
    modal.classList.add('hidden');

    // 销毁图表实例
    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }
  }

  // ESC键关闭
  function handleKeydown(e) {
    const modal = document.getElementById('indicator-modal');
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  }

  // Turbo兼容：监听turbo:load事件
  document.addEventListener('turbo:load', initEventListeners);
  document.addEventListener('turbo:render', initEventListeners);
  document.addEventListener('keydown', handleKeydown);

  // 初始绑定
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventListeners);
  } else {
    initEventListeners();
  }
})();
</script>

<!-- 指标弹窗 -->
<div id="indicator-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6 hidden">
  <div id="modal-backdrop" class="fixed inset-0 bg-black/40"></div>
  <div id="modal-content" class="relative bg-white rounded w-full min-w-0 max-w-full lg:w-[896px] max-h-[90vh] lg:max-h-[85vh] overflow-hidden">
    <div class="px-4 md:px-6 py-3 md:py-4 border-b border-line-soft flex justify-between items-center overflow-hidden">
      <h3 id="modal-title" class="text-hl-14 md:text-base font-semibold text-ink-soft truncate mr-4"></h3>
      <button id="modal-close" class="p-1.5 hover:bg-bg-mute rounded transition-colors ml-4 shrink-0">
        <svg class="w-4 h-4 text-muted-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="p-4 md:p-5 overflow-y-auto max-h-[calc(90vh-62px)] lg:max-h-[calc(85vh-70px)] overflow-x-hidden">
      <div id="error-container" class="hidden"></div>
      
      <div id="chart-container" class="mb-4 md:mb-6 overflow-hidden">
        <div class="w-full" style="height: 180px; overflow: hidden;">
          <canvas id="indicator-chart"></canvas>
        </div>
      </div>

      <p id="indicator-scope-note" class="hidden text-hl-11 text-muted-4 mb-4 md:mb-6">季报为报告期累计口径（一季报 3 个月 / 中报 6 个月 / 三季报 9 个月），不同期次的数值不可直接比较。</p>

      <div id="content-container" class="overflow-hidden">
        <div class="mb-4 md:mb-6">
          <h4 class="font-semibold text-muted text-hl-13 mb-2 md:mb-3 truncate">指标定义</h4>
          <p id="indicator-description" class="text-muted-2 text-hl-11 leading-relaxed" style="word-break: break-word; hyphens: auto;"></p>
        </div>
        
        <div class="h-px bg-line-soft mb-4 md:mb-6"></div>
        
        <div class="mb-4 md:mb-6">
          <h4 class="font-semibold text-muted text-hl-13 mb-2 md:mb-3 truncate">计算公式</h4>
          <div id="indicator-formula" class="text-muted-2 text-hl-11 font-mono p-3 bg-bg-mute rounded overflow-x-auto break-all overflow-y-hidden"></div>
        </div>
        
        <div class="h-px bg-line-soft mb-4 md:mb-6"></div>
        
        <div>
          <h4 class="font-semibold text-muted text-hl-13 mb-2 md:mb-3 truncate">解读标准</h4>
          <div id="indicator-interpretation" class="space-y-3 overflow-hidden"></div>
        </div>
      </div>
    </div>
  </div>
</div>