<div class="mb-8">
  <h1 class="text-hl-22 font-bold text-ink">订单管理</h1>
  <p class="mt-2 text-muted">查看所有微信支付订单，可按状态 / 套餐 / 支付方式 / 关键词 / 时间筛选</p>
</div>

<%# 统计卡片（与筛选联动） %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="hl-card p-5">
    <p class="text-hl-12 text-muted mb-1">订单总数</p>
    <p class="text-hl-22 font-bold text-ink"><%= @total_count %></p>
  </div>
  <div class="hl-card p-5">
    <p class="text-hl-12 text-muted mb-1">已支付金额</p>
    <p class="text-hl-22 font-bold text-profit">¥<%= @total_amount_cents / 100 %></p>
  </div>
  <div class="hl-card p-5">
    <p class="text-hl-12 text-muted mb-1">已支付订单</p>
    <p class="text-hl-22 font-bold text-ink"><%= @paid_count %></p>
  </div>
  <div class="hl-card p-5">
    <p class="text-hl-12 text-muted mb-1">待支付订单</p>
    <p class="text-hl-22 font-bold text-ink"><%= @pending_count %></p>
  </div>
</div>

<%# 筛选表单 %>
<%= form_tag admin_orders_path, method: :get, class: "mb-6" do %>
  <div class="hl-card p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
      <div>
        <label class="text-hl-12 text-muted block mb-1">状态</label>
        <%= select_tag :status,
              options_for_select([["全部状态", ""], ["待支付", "pending"], ["已支付", "paid"]], params[:status]),
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 bg-white focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
      <div>
        <label class="text-hl-12 text-muted block mb-1">套餐</label>
        <%= select_tag :plan_code,
              options_for_select([["全部套餐", ""]] + @plans.map { |p| [p.name, p.plan_code] }, params[:plan_code]),
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 bg-white focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
      <div>
        <label class="text-hl-12 text-muted block mb-1">支付方式</label>
        <%= select_tag :payment_method,
              options_for_select([["全部方式", ""], ["微信·扫码", "wechat_native"], ["微信·JSAPI", "wechat_jsapi"], ["支付宝·扫码", "alipay_native"], ["支付宝·手机", "alipay_wap"]], params[:payment_method]),
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 bg-white focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
      <div>
        <label class="text-hl-12 text-muted block mb-1">关键词</label>
        <%= text_field_tag :q, params[:q], placeholder: "订单号 / 微信单号 / 昵称",
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
      <div>
        <label class="text-hl-12 text-muted block mb-1">开始日期</label>
        <%= date_field_tag :from, params[:from],
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 bg-white focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
      <div>
        <label class="text-hl-12 text-muted block mb-1">结束日期</label>
        <%= date_field_tag :to, params[:to],
              class: "w-full border border-line rounded px-3 py-2 text-hl-13 bg-white focus:outline-none focus:ring-1 focus:ring-profit" %>
      </div>
    </div>
    <div class="mt-4 flex items-center gap-3">
      <button type="submit" class="hl-btn hl-btn-primary px-6 py-2 text-hl-13">筛选</button>
      <%= link_to "重置", admin_orders_path, class: "text-hl-13 text-muted-3 hover:text-ink transition-colors" %>
    </div>
  </div>
<% end %>

<div class="hl-card overflow-hidden">
  <table class="hl-table">
    <thead>
      <tr>
        <th>订单号</th>
        <th>用户</th>
        <th>套餐</th>
        <th>金额</th>
        <th>状态</th>
        <th>支付方式</th>
        <th>创建时间</th>
        <th>支付时间</th>
        <th class="text-right">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td class="font-mono text-hl-12"><%= order.order_no %></td>
          <td><%= order.user.nickname %></td>
          <td class="text-hl-12"><%= @plans_by_code[order.plan_code]&.name || order.plan_code %></td>
          <td class="font-mono">¥<%= order.amount_yuan %></td>
          <td>
            <span class="inline-flex px-2 py-0.5 text-hl-11 font-medium rounded
              <%= order.paid? ? 'bg-green-100 text-green-700' : 'bg-bg-mute text-muted' %>">
              <%= order.paid? ? "已支付" : "待支付" %>
            </span>
          </td>
          <td class="text-hl-12">
            <%= case order.payment_method
                  when "wechat_native" then "微信·扫码"
                  when "wechat_jsapi" then "微信·JSAPI"
                  when "alipay_native" then "支付宝·扫码"
                  when "alipay_wap" then "支付宝·手机"
                  else order.payment_method
                end %>
          </td>
          <td class="text-hl-12"><%= order.created_at ? l(order.created_at, format: :short) : "-" %></td>
          <td class="text-hl-12"><%= order.paid_at ? l(order.paid_at, format: :short) : "-" %></td>
          <td class="text-right">
            <%= link_to "详情", admin_order_path(order), class: "text-link text-hl-13 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @orders.empty? %>
    <p class="text-hl-13 text-muted-4 text-center py-12">没有符合条件的订单</p>
  <% end %>
</div>

<div class="mt-6">
  <%= paginate @orders %>
</div>
