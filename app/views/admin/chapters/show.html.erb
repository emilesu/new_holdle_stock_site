<div class="flex items-center justify-between mb-6">
  <h1 class="text-hl-16 font-semibold text-ink">
    <%= link_to '课程管理', admin_courses_path, class: 'text-link hover:text-link-hover' %> /
    <%= link_to @course.title, admin_course_path(@course), class: 'text-link hover:text-link-hover' %> /
    <%= @chapter.title %>
  </h1>
  <%= link_to '编辑章节', edit_admin_course_chapter_path(@course, @chapter), class: 'hl-btn hl-btn-primary' %>
</div>

<div class="hl-card mb-8">
  <div class="px-6 py-4 border-b border-line bg-bg-mute">
    <h2 class="text-hl-13 font-semibold text-muted-3">基本信息</h2>
  </div>
  <div class="p-6 space-y-4">
    <div>
      <span class="text-hl-12 text-muted-4 block mb-1">标题</span>
      <span class="text-hl-13 text-ink"><%= @chapter.title %></span>
    </div>
    <% if @chapter.summary.present? %>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">摘要</span>
        <div class="text-hl-13 text-muted [&_p]:my-1 [&_ul]:my-1 [&_ol]:my-1 [&_h1]:text-hl-16 [&_h2]:text-hl-15 [&_h3]:text-hl-14 [&_a]:text-link [&_a]:underline [&_code]:bg-bg-mute [&_code]:px-1 [&_code]:rounded [&_table]:text-hl-13">
          <%= sanitize @chapter.summary_html, tags: %w[p a img ul ol li h1 h2 h3 h4 h5 h6 pre code blockquote table thead tbody tr th td strong em br hr span div], attributes: %w[href src alt class id target rel width height] %>
        </div>
      </div>
    <% end %>
    <div class="flex items-center space-x-6">
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">访问级别</span>
        <% level = @chapter.effective_access_level %>
        <span class="inline-flex px-2 py-1 text-hl-12 font-medium <%= level.to_i > 0 ? 'bg-blue-50 text-link border border-blue-200' : 'bg-green-50 text-green-600 border border-green-200' %> rounded">
          <%= access_level_label(level) %>
          <% if @chapter.access_level.nil? %>
            <span class="ml-1 text-muted-4">(继承课程)</span>
          <% end %>
        </span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">状态</span>
        <span class="text-hl-13 text-muted"><%= @chapter.published? ? '已发布' : '草稿' %></span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">排序</span>
        <span class="text-hl-13 text-muted"><%= @chapter.sort_num %></span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">更新时间</span>
        <span class="text-hl-13 text-muted"><%= @chapter.updated_at.strftime('%Y-%m-%d %H:%M') %></span>
      </div>
    </div>
  </div>
</div>

<div class="hl-card overflow-hidden">
  <div class="px-6 py-4 border-b border-line bg-bg-mute flex items-center justify-between">
    <h2 class="text-hl-13 font-semibold text-muted-3">小节列表</h2>
    <%= link_to '新增小节', new_admin_course_chapter_lesson_path(@course, @chapter), class: 'hl-btn hl-btn-primary' %>
  </div>
  <table class="w-full">
    <thead>
      <tr class="border-b border-line bg-bg-mute">
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">排序</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">标题</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">有效访问级别</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">状态</th>
        <th class="px-6 py-4 text-right text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @lessons.each do |lesson| %>
        <tr class="border-b border-line hover:bg-bg-mute">
          <td class="px-6 py-4 text-hl-13 text-muted"><%= lesson.sort_num %></td>
          <td class="px-6 py-4 text-hl-13">
            <%= link_to lesson.title, admin_course_chapter_lesson_path(@course, @chapter, lesson), class: 'text-link hover:text-link-hover' %>
          </td>
          <td class="px-6 py-4 text-hl-13">
            <% level = lesson.effective_access_level %>
            <span class="inline-flex px-2 py-1 text-hl-12 font-medium <%= level.to_i > 0 ? 'bg-blue-50 text-link border border-blue-200' : 'bg-green-50 text-green-600 border border-green-200' %> rounded">
              <%= access_level_label(level) %>
              <% if lesson.access_level.nil? %>
                <span class="ml-1 text-muted-4">(继承)</span>
              <% end %>
            </span>
          </td>
          <td class="px-6 py-4 text-hl-13 text-muted">
            <%= lesson.published? ? '已发布' : '草稿' %>
          </td>
          <td class="px-6 py-4 text-hl-13 text-right">
            <div class="flex items-center justify-end space-x-3">
              <%= link_to '查看', admin_course_chapter_lesson_path(@course, @chapter, lesson), class: 'text-link hover:text-link-hover' %>
              <%= link_to '编辑', edit_admin_course_chapter_lesson_path(@course, @chapter, lesson), class: 'text-muted hover:text-ink' %>
              <%= button_to '删除', admin_course_chapter_lesson_path(@course, @chapter, lesson), method: :delete, class: 'text-profit hover:text-red-700', data: { turbo_confirm: '确认删除？' } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
