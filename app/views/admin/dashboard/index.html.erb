<div class="mb-6 flex items-end justify-between">
  <div>
    <h1 class="text-hl-22 font-bold text-ink">仪表盘</h1>
    <p class="mt-1 text-hl-13 text-muted">平台核心数据一览 · <%= Time.current.strftime("%Y-%m-%d %H:%M") %></p>
  </div>
</div>

<%# 数据总览：单卡片 + 竖线分割，替代原来 7 张重复卡片 %>
<div class="hl-card mb-6">
  <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-line-soft">
    <div class="p-5">
      <p class="text-hl-12 font-medium text-muted-3">股票总数</p>
      <p class="mt-1 text-hl-22 font-bold text-ink font-mono"><%= @total_stocks %></p>
      <p class="mt-1 text-hl-12 text-muted-4">
        A股 <%= @a_stock_count %> · 港股 <%= @hk_stock_count %> · 美股 <%= @us_stock_count %>
      </p>
    </div>
    <div class="p-5">
      <p class="text-hl-12 font-medium text-muted-3">注册用户</p>
      <p class="mt-1 text-hl-22 font-bold text-ink font-mono"><%= @total_users %></p>
      <p class="mt-1 text-hl-12 text-muted-4">今日新增 <%= @today_registered_users %></p>
    </div>
    <div class="p-5">
      <p class="text-hl-12 font-medium text-muted-3">会员用户</p>
      <p class="mt-1 text-hl-22 font-bold text-ink font-mono"><%= @member_count %></p>
      <p class="mt-1 text-hl-12 text-muted-4">管理员 <%= @admin_count %></p>
    </div>
    <div class="p-5">
      <p class="text-hl-12 font-medium text-muted-3">今日活跃</p>
      <p class="mt-1 text-hl-22 font-bold text-ink font-mono"><%= @today_active_users %></p>
      <p class="mt-1 text-hl-12 text-muted-4">近 7 日活跃 <%= @week_active_users %></p>
    </div>
  </div>
</div>

<%# 快捷入口：与导航分组一致的线条式链接 %>
<div class="mb-6">
  <h2 class="text-hl-16 font-bold text-ink mb-3">快捷入口</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <% [
      { label: "股票管理", url: admin_stocks_path, desc: "A股 / 港股 / 美股" },
      { label: "爬虫管理", url: admin_stock_crawlers_path, desc: "任务执行与断点" },
      { label: "数据看板", url: admin_stock_data_path, desc: "覆盖率与新鲜度" },
      { label: "数据质量", url: admin_data_quality_path, desc: "问题台账" },
      { label: "用户管理", url: admin_users_path, desc: "注册与会员" },
      { label: "订单管理", url: admin_orders_path, desc: "交易记录" },
      { label: "AI 提问分析", url: admin_usage_analytics_path, desc: "用量报表" },
      { label: "留言管理", url: admin_messages_path, desc: "用户反馈" }
    ].each do |entry| %>
      <a href="<%= entry[:url] %>" class="hl-card hl-card-hover px-4 py-3 block">
        <p class="text-hl-13 font-medium text-ink"><%= entry[:label] %></p>
        <p class="mt-0.5 text-hl-12 text-muted-4"><%= entry[:desc] %></p>
      </a>
    <% end %>
  </div>
</div>

<%# 最近动态：三列线条列表 %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="hl-card">
    <div class="px-5 py-4 border-b border-line flex items-center justify-between">
      <h3 class="text-hl-16 font-semibold text-ink">最近注册</h3>
      <a href="<%= admin_users_path %>" class="text-hl-13 text-link hover:text-link-hover">查看全部</a>
    </div>
    <div class="divide-y divide-line">
      <% @recent_users.each do |user| %>
        <div class="px-5 py-3 flex items-center justify-between">
          <div class="flex items-center space-x-3 min-w-0">
            <%= user_avatar_tag(user, size: "w-8 h-8", css_class: "text-hl-12") %>
            <div class="min-w-0">
              <p class="text-hl-13 font-medium text-ink truncate"><%= user.nickname %></p>
              <p class="text-hl-12 text-muted-3 truncate"><%= l user.created_at, format: :short %> 注册</p>
            </div>
          </div>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-hl-12 font-medium shrink-0
            <%= case user.role
                 when 'super_admin' then 'bg-red-50 text-red-700'
                 when 'admin' then 'bg-purple-50 text-purple-700'
                 when 'member' then 'bg-blue-50 text-blue-700'
                 else 'bg-bg-mute text-muted-2'
               end %>">
            <%= human_role(user.role) %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="hl-card">
    <div class="px-5 py-4 border-b border-line flex items-center justify-between">
      <h3 class="text-hl-16 font-semibold text-ink">最近添加股票</h3>
      <a href="<%= admin_stocks_path %>" class="text-hl-13 text-link hover:text-link-hover">查看全部</a>
    </div>
    <div class="divide-y divide-line">
      <% @recent_stocks.each do |stock| %>
        <div class="px-5 py-3 flex items-center justify-between">
          <div class="min-w-0">
            <p class="text-hl-13 font-medium text-ink"><%= stock.symbol %></p>
            <p class="text-hl-12 text-muted-3 truncate"><%= stock.name %></p>
          </div>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-hl-12 font-medium shrink-0
            <%= stock.market == 'CN' ? 'bg-green-50 text-green-700' : stock.market == 'HK' ? 'bg-amber-50 text-amber-700' : 'bg-blue-50 text-blue-700' %>">
            <%= stock.market == 'CN' ? 'A股' : stock.market == 'HK' ? '港股' : '美股' %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="hl-card">
    <div class="px-5 py-4 border-b border-line flex items-center justify-between">
      <h3 class="text-hl-16 font-semibold text-ink">最近爬虫执行</h3>
      <a href="<%= admin_crawler_executions_path %>" class="text-hl-13 text-link hover:text-link-hover">查看全部</a>
    </div>
    <div class="divide-y divide-line">
      <% if @recent_executions.any? %>
        <% @recent_executions.each do |record| %>
          <div class="px-5 py-3 flex items-center gap-3">
            <span class="w-2 h-2 rounded-full shrink-0
              <%= record.status == 'success' ? 'bg-green-500' : record.status == 'running' ? 'bg-yellow-500' : 'bg-red-500' %>"></span>
            <div class="flex-1 min-w-0">
              <a href="<%= admin_crawler_execution_path(record) %>" class="text-hl-13 font-medium text-ink hover:underline truncate block">
                <%= record.task_name %>
              </a>
              <p class="text-hl-12 text-muted-4 truncate"><%= record.progress_message.presence || record.message %></p>
            </div>
            <span class="text-hl-12 text-muted-5 shrink-0"><%= l record.executed_at, format: :short %></span>
          </div>
        <% end %>
      <% else %>
        <div class="px-5 py-8 text-center text-hl-13 text-muted-4">暂无执行记录</div>
      <% end %>
    </div>
  </div>
</div>
