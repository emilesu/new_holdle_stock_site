<%# 最近执行记录（turbo-frame 内容，由 crawler-progress 控制器按需自动刷新） %>
<div data-crawler-active="<%= @crawler_active ? 'true' : 'false' %>"></div>

<div class="hl-card">
  <div class="px-5 py-4 border-b border-line flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <span class="text-xl">📝</span>
      <h2 class="text-hl-16 font-semibold text-ink">最近执行</h2>
      <% if @crawler_active %>
        <span class="text-hl-11 text-muted-4 border border-line px-1.5 py-0.5 rounded">执行中 · 每 5 秒自动刷新</span>
      <% end %>
    </div>
    <a href="<%= admin_crawler_executions_path %>" class="text-hl-12 text-muted-4 hover:text-ink transition-colors">
      全部 <%= @recent_total %> 条 →
    </a>
  </div>

  <div class="divide-y divide-line">
    <% if @executions.present? %>
      <% @executions.each do |record| %>
        <div class="px-5 py-4 flex items-start space-x-4 hover:bg-bg-mute transition-colors">
          <div class="w-3 h-3 mt-1 rounded-full flex-shrink-0
            <%= record.status == 'success' ? 'bg-green-500' : record.status == 'running' ? 'bg-yellow-500' : 'bg-red-500' %>"></div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <a href="<%= admin_crawler_execution_path(record) %>" class="text-hl-13 font-medium text-ink hover:underline">
                <%= record.task_name %>
              </a>
              <span class="text-hl-11 text-muted-5">
                <%= { "manual" => "手动", "schedule" => "定时", "retry" => "重试" }.fetch(record.trigger_source.to_s, "未知") %>
              </span>
            </div>
            <div class="text-hl-12 text-muted-4 mt-0.5 truncate"><%= record.progress_message.presence || record.message %></div>
            <% if record.running? %>
              <% percent = record.progress_percent %>
              <div class="mt-2 flex items-center gap-2">
                <div class="flex-1 h-1 bg-line rounded overflow-hidden">
                  <div class="h-full bg-ink" style="width: <%= percent || 0 %>%"></div>
                </div>
                <span class="text-hl-11 text-muted-4 flex-shrink-0">
                  <%= percent ? "#{percent}%" : "准备中" %>
                  <% if record.total_count.to_i.positive? %>
                    （<%= record.processed_count %>/<%= record.total_count %>）
                  <% end %>
                </span>
              </div>
            <% elsif record.total_count.to_i.positive? %>
              <div class="mt-1 text-hl-11 text-muted-5">
                成功 <%= record.success_count %> · 失败 <%= record.failed_count %> · 共 <%= record.total_count %>
              </div>
            <% end %>
          </div>
          <div class="text-right text-hl-12 text-muted-5 flex-shrink-0">
            <div class="font-medium text-muted-3"><%= record.executed_at&.strftime('%m-%d %H:%M') %></div>
            <% if record.finished_at.present? %><div>耗时 <%= record.duration.to_f.round(1) %>s</div><% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-5 py-12 text-center">
        <p class="text-hl-13 text-muted-4">暂无执行记录</p>
        <p class="text-hl-12 text-muted-5 mt-1">请点击上方任务的「执行」按钮开始爬取</p>
      </div>
    <% end %>
  </div>
</div>
