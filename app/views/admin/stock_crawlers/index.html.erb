<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-hl-22 font-bold text-ink">爬虫管理</h1>
    <p class="mt-1 text-hl-13 text-muted">任务由注册表统一定义，点击即入队；长任务单线程串行执行，避免打满服务器</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="<%= admin_stock_data_path %>" class="hl-btn hl-btn-line whitespace-nowrap">数据看板</a>
    <a href="<%= admin_crawler_executions_path %>" class="hl-btn hl-btn-line whitespace-nowrap">执行历史</a>
  </div>
</div>

<div class="space-y-6 mb-8">
  <% @tasks_by_group.each do |group, tasks| %>
    <div class="hl-card">
      <div class="px-5 py-3 border-b border-line flex items-center justify-between">
        <h2 class="text-hl-16 font-semibold text-ink"><%= DataSources::CrawlerRegistry.group_name(group) %></h2>
        <span class="text-hl-12 text-muted-4"><%= tasks.size %> 个任务</span>
      </div>
      <div class="divide-y divide-line">
        <% tasks.each do |task| %>
          <% last = @last_executions[task.key] %>
          <div class="px-5 py-4 flex flex-col md:flex-row md:items-center gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="w-2 h-2 rounded-full flex-shrink-0 <%= last.nil? ? 'bg-line' : last.status == 'success' ? 'bg-green-500' : last.status == 'running' ? 'bg-yellow-500' : 'bg-red-500' %>"></span>
                <span class="text-hl-13 font-medium text-ink"><%= task.name %></span>
                <% if task.heavy? %>
                  <span class="text-hl-11 text-muted-4 border border-line px-1.5 py-0.5 rounded">重任务 · 建议低峰执行</span>
                <% end %>
              </div>
              <p class="mt-1 text-hl-12 text-muted-4"><%= task.description %></p>
              <p class="mt-1 text-hl-11 text-muted-5">
                <% if last %>
                  上次
                  <%= CrawlerExecution::STATUS_LABELS.fetch(last.status, last.status) %>
                  · <%= relative_time(last.executed_at) %>
                  <% if last.finished_at.present? %>· 耗时 <%= last.duration.to_f.round(1) %>s<% end %>
                <% else %>
                  暂无执行记录
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-2 flex-wrap flex-shrink-0">
              <%= link_to "执行",
                    admin_run_stock_crawler_path(task.key),
                    data: { turbo_method: :post, turbo_confirm: "确认执行「#{task.name}」？" },
                    rel: "nofollow", class: "hl-btn hl-btn-primary" %>
              <% if task.accepts_stock_scope? %>
                <%= link_to "测试 5 只",
                      admin_run_stock_crawler_path(task.key, limit: 5),
                      data: { turbo_method: :post, turbo_confirm: "确认执行「#{task.name}」测试 5 只？" },
                      rel: "nofollow", class: "hl-btn hl-btn-line" %>
                <%# 指定股票按需执行：代码解析为 stock_ids 入队，空输入被 required 拦截，不会误触发全量 %>
                <%= form_with url: admin_run_stock_crawler_path(task.key), method: :post,
                      class: "flex items-center gap-1.5 min-w-0" do %>
                  <input type="text" name="symbols" required
                         placeholder="代码逗号分隔，按需执行"
                         class="w-40 px-2 py-1.5 text-hl-12 border border-line rounded min-w-0">
                  <button type="submit" class="hl-btn hl-btn-line whitespace-nowrap">指定股票</button>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# 有任务在跑时才给帧加 src：Turbo 的 frame.reload() 依赖 src 才能重新发起请求，
    空闲时不留 src 可避免后台常驻轮询请求 %>
<%= turbo_frame_tag "crawler_executions",
      src: (@crawler_active ? admin_stock_crawlers_path : nil),
      data: { controller: "crawler-progress" } do %>
  <%= render "executions" %>
<% end %>

<div class="mt-6 bg-bg-soft border border-line rounded-md p-4">
  <div class="flex items-start space-x-3">
    <span class="text-xl flex-shrink-0">⚠️</span>
    <div>
      <p class="text-hl-13 font-medium text-ink">注意事项</p>
      <p class="text-hl-12 text-muted mt-1">
        任务执行期间请勿重复点击。重任务（全量财务、月K全量重建、全量雷达）耗时较长，建议低峰执行；
        执行中断可在执行历史中「从断点继续」。
      </p>
    </div>
  </div>
</div>
