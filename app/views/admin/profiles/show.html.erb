<div class="mb-6">
  <%= link_to '← 返回档案列表', admin_profiles_path, class: 'text-hl-13 text-muted hover:text-link transition-colors' %>
</div>

<%# 头部信息 + 闸门操作 %>
<div class="hl-card p-5 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-hl-18 font-bold text-ink"><%= @profile.title %></h1>
      <p class="text-hl-13 text-muted mt-1">
        <%= @profile.stock.name %>（<%= @profile.stock.symbol %>）· <%= @profile.period %> ·
        状态：<span class="font-medium text-ink"><%= @profile.status_label %></span> ·
        当前 v<%= @profile.current_version_no %><% if @profile.published_version_no %> · 对外 v<%= @profile.published_version_no %><% end %>
      </p>
      <p class="text-hl-12 text-muted-4 mt-2 font-mono">
        金字塔分 <%= @profile.meta['pyramid_score'] %>（<%= @profile.meta['pyramid_calc_at'] %> 重算）·
        数据截止 <%= @profile.meta['data_cutoff'] %> · 披露 <%= @profile.meta['disclosed_at'].presence || '未回填' %> ·
        gate_passed=<%= @profile.meta['gate_passed'] %> · ai_generated=<%= @profile.meta['ai_generated'] %> ·
        schema=<%= @profile.meta['schema_version'] %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @profile.status == "pending_review" %>
        <%= button_to '发布（闸门放行）', publish_admin_profile_path(@profile), method: :post,
            class: 'px-4 py-2 text-hl-13 font-medium text-white bg-green-600 rounded hover:opacity-90 transition cursor-pointer' %>
      <% end %>
      <% if @profile.status.in?(QualityProfile::EDITABLE_STATUSES) %>
        <%= link_to '编辑', edit_admin_profile_path(@profile),
            class: 'px-4 py-2 text-hl-13 font-medium border border-line-soft rounded text-muted hover:text-link hover:border-link transition' %>
      <% end %>
      <% if @profile.status.in?(%w[published superseded]) %>
        <%= button_to '撤回下架', withdraw_admin_profile_path(@profile), method: :post,
            class: 'px-4 py-2 text-hl-13 font-medium text-white bg-red-500 rounded hover:opacity-90 transition cursor-pointer',
            form: { data: { turbo_confirm: "确认撤回？前台立即不可读（数据保留，可回滚恢复）" } } %>
      <% end %>
      <%= link_to '前台页面', "/archive/#{@profile.stock.symbol}/#{@profile.period[0, 4]}#{QualityProfile::PERIOD_SHORT.invert[@profile.period[4..]]}",
          class: 'px-4 py-2 text-hl-13 border border-line-soft rounded text-muted hover:text-link hover:border-link transition', target: '_blank', rel: 'noopener' %>
    </div>
  </div>
  <% if @profile.status == "draft" %>
    <p class="text-hl-12 text-amber-600 mt-3">该稿 gate_passed=false，只能作为草稿；内容侧校验通过后重新发布才进入待审队列。</p>
  <% end %>
  <% if @profile.status == "pending_review" && @profile.published_version_no %>
    <p class="text-hl-12 text-amber-600 mt-3">覆盖待审：最新稿 v<%= @profile.current_version_no %> 尚未发布，对外仍显示 v<%= @profile.published_version_no %>；点击「发布」后换文。</p>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# 最新稿预览（与前台同 render_profile 管道，所见即所得） %>
  <div class="lg:col-span-2">
    <div class="hl-card p-5">
      <h2 class="text-hl-15 font-semibold text-ink mb-4">最新稿预览（v<%= @profile.current_version_no %>，与前台同渲染管道）</h2>
      <article class="prose prose-gray max-w-none prose-table:text-hl-12">
        <%= @preview_html %>
      </article>
    </div>
  </div>

  <%# 版本历史 + 回滚 %>
  <div class="hl-card">
    <div class="px-5 py-4 border-b border-line">
      <h2 class="text-hl-15 font-semibold text-ink">版本历史</h2>
    </div>
    <div class="divide-y divide-line-soft">
      <% @versions.each do |v| %>
        <div class="px-5 py-3 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-hl-13 text-ink font-medium">v<%= v.version_no %>
              <% if v.version_no == @profile.published_version_no %><span class="text-green-600 text-hl-11">· 对外</span><% end %>
            </p>
            <p class="text-hl-11 text-muted-4"><%= v.created_at.strftime('%Y-%m-%d %H:%M') %>
              <% if v.meta['manual_edited_by'] %><span class="text-amber-600">· 人工编辑（<%= v.meta['manual_edited_by'] %> <%= v.meta['manual_edited_at'] %>）</span><% end %>
            </p>
          </div>
          <% if @profile.status.in?(%w[published superseded pending_review withdrawn]) && v.version_no != @profile.current_version_no %>
            <%= button_to '回滚并发布', rollback_admin_profile_path(@profile, version_no: v.version_no), method: :post,
                class: 'text-hl-12 px-2.5 py-1 border border-line-soft rounded text-muted hover:text-link hover:border-link transition cursor-pointer shrink-0',
                form: { data: { turbo_confirm: "回滚到 v#{v.version_no} 并直接发布？" } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
