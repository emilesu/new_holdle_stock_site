<div class="flex items-center justify-between mb-6">
  <h1 class="text-hl-22 font-bold text-ink">视频管理</h1>
  <%= link_to "新增视频", new_admin_video_path, class: "hl-btn hl-btn-primary" %>
</div>

<div class="hl-card overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="border-b border-line bg-bg-mute">
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">封面</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">标题</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">B站</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">YouTube</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">状态</th>
        <th class="px-6 py-4 text-left text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">排序</th>
        <th class="px-6 py-4 text-right text-hl-12 font-semibold text-muted-3 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @videos.each do |video| %>
        <tr class="border-b border-line hover:bg-bg-mute">
          <td class="px-6 py-4">
            <% if video.cover_url.present? %>
              <%= image_tag video.cover_url, alt: video.title, class: "w-20 h-12 object-cover rounded border border-line" %>
            <% else %>
              <div class="w-20 h-12 bg-bg-mute rounded border border-line flex items-center justify-center text-hl-11 text-muted-5">无封面</div>
            <% end %>
          </td>
          <td class="px-6 py-4 text-hl-13">
            <%= link_to video.title, edit_admin_video_path(video), class: "text-link hover:text-link-hover" %>
          </td>
          <td class="px-6 py-4 text-hl-13">
            <% if video.bilibili_url.present? %>
              <span class="text-profit">有</span>
            <% else %>
              <span class="text-muted-5">—</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-hl-13">
            <% if video.youtube_url.present? %>
              <span class="text-profit">有</span>
            <% else %>
              <span class="text-muted-5">—</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-hl-13 text-muted">
            <%= video.published? ? "已发布" : "草稿" %>
          </td>
          <td class="px-6 py-4 text-hl-13 text-muted"><%= video.sort %></td>
          <td class="px-6 py-4 text-hl-13 text-right">
            <div class="flex items-center justify-end space-x-3">
              <%= link_to "编辑", edit_admin_video_path(video), class: "text-muted hover:text-ink" %>
              <%= button_to "删除", admin_video_path(video), method: :delete, class: "text-profit hover:text-red-700", data: { turbo_confirm: "确认删除？" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
