<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-hl-22 font-bold text-ink">执行历史</h1>
    <p class="mt-1 text-hl-13 text-muted">共 <%= @total_count %> 条记录，可按任务、状态、市场筛选</p>
  </div>
  <a href="<%= admin_stock_crawlers_path %>" class="hl-btn hl-btn-line whitespace-nowrap">返回爬虫管理</a>
</div>

<form method="get" action="<%= admin_crawler_executions_path %>" class="hl-card p-4 mb-6">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <label class="block">
      <span class="text-hl-12 text-muted-4">任务</span>
      <select name="task_key" class="mt-1 w-full border border-line rounded px-3 py-2 text-hl-13 text-ink bg-white">
        <option value="">全部任务</option>
        <% @tasks.each do |task| %>
          <option value="<%= task.key %>" <%= "selected" if @task_key == task.key %>><%= task.name %></option>
        <% end %>
      </select>
    </label>
    <label class="block">
      <span class="text-hl-12 text-muted-4">状态</span>
      <select name="status" class="mt-1 w-full border border-line rounded px-3 py-2 text-hl-13 text-ink bg-white">
        <option value="">全部状态</option>
        <% CrawlerExecution::STATUSES.each do |status| %>
          <option value="<%= status %>" <%= "selected" if @status == status %>>
            <%= CrawlerExecution::STATUS_LABELS.fetch(status, status) %>
          </option>
        <% end %>
      </select>
    </label>
    <label class="block">
      <span class="text-hl-12 text-muted-4">市场</span>
      <select name="market" class="mt-1 w-full border border-line rounded px-3 py-2 text-hl-13 text-ink bg-white">
        <option value="">全部市场</option>
        <% %w[CN HK US].each do |market| %>
          <option value="<%= market %>" <%= "selected" if @market == market %>>
            <%= { "CN" => "A股", "HK" => "港股", "US" => "美股" }[market] %>
          </option>
        <% end %>
      </select>
    </label>
    <div class="flex items-end gap-2">
      <button type="submit" class="hl-btn hl-btn-primary">筛选</button>
      <a href="<%= admin_crawler_executions_path %>" class="hl-btn hl-btn-line">重置</a>
    </div>
  </div>
</form>

<div class="hl-card divide-y divide-line">
  <% if @executions.present? %>
    <% @executions.each do |record| %>
      <div class="px-5 py-4 flex items-start gap-4">
        <div class="w-3 h-3 mt-1 rounded-full flex-shrink-0 <%= record.status_dot_class %>"></div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <a href="<%= admin_crawler_execution_path(record) %>" class="text-hl-13 font-medium text-ink hover:underline">
              <%= record.task_name %>
            </a>
            <span class="text-hl-11 text-muted-5 border border-line px-1.5 py-0.5 rounded">
              <%= record.task_key.presence || "未登记任务" %>
            </span>
            <span class="text-hl-11 text-muted-5">
              <%= { "manual" => "手动", "schedule" => "定时", "retry" => "重试" }.fetch(record.trigger_source.to_s, "未知") %>
              <% if record.market.present? %>· <%= record.market %><% end %>
            </span>
          </div>
          <div class="text-hl-12 text-muted-4 mt-0.5 break-words"><%= record.progress_message.presence || record.message %></div>
        </div>
        <div class="text-right text-hl-12 text-muted-5 flex-shrink-0">
          <div class="font-medium text-muted-3"><%= record.executed_at&.strftime('%Y-%m-%d %H:%M') %></div>
          <div>
            <% if record.total_count.to_i.positive? %>
              <%= record.processed_count %>/<%= record.total_count %> · 失败 <%= record.failed_count %>
            <% end %>
          </div>
          <% if record.finished_at.present? %><div>耗时 <%= record.duration.to_f.round(1) %>s</div><% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="px-5 py-12 text-center">
      <p class="text-hl-13 text-muted-4">没有符合条件的执行记录</p>
    </div>
  <% end %>
</div>

<% if @total_pages > 1 %>
  <div class="mt-4 flex items-center justify-between text-hl-13 text-muted">
    <div>
      显示
      <span class="font-semibold text-ink"><%= [(@page - 1) * Admin::CrawlerExecutionsController::PER_PAGE + 1, @total_count].min %></span>
      -
      <span class="font-semibold text-ink"><%= [@page * Admin::CrawlerExecutionsController::PER_PAGE, @total_count].min %></span>
      条
    </div>
    <div class="flex items-center gap-1">
      <a href="<%= admin_crawler_executions_path(page: [@page - 1, 1].max, task_key: @task_key, status: @status, market: @market) %>"
         class="px-3 py-2 border border-line rounded <%= 'pointer-events-none opacity-40' if @page <= 1 %>">上一页</a>
      <span class="px-3 py-2"><%= @page %> / <%= @total_pages %></span>
      <a href="<%= admin_crawler_executions_path(page: [@page + 1, @total_pages].min, task_key: @task_key, status: @status, market: @market) %>"
         class="px-3 py-2 border border-line rounded <%= 'pointer-events-none opacity-40' if @page >= @total_pages %>">下一页</a>
    </div>
  </div>
<% end %>
