<div class="flex items-center justify-between mb-6">
  <h1 class="text-hl-16 font-semibold text-ink">
    <%= link_to '课程管理', admin_courses_path, class: 'text-link hover:text-link-hover' %> /
    <%= link_to @course.title, admin_course_path(@course), class: 'text-link hover:text-link-hover' %> /
    <%= link_to '章节管理', admin_course_chapters_path(@course), class: 'text-link hover:text-link-hover' %> /
    <%= link_to @chapter.title, admin_course_chapter_path(@course, @chapter), class: 'text-link hover:text-link-hover' %> /
    <%= @lesson.title %>
  </h1>
  <div class="flex items-center space-x-3">
    <%= link_to '前台预览', lesson_path(@lesson), class: 'hl-btn', target: '_blank', rel: 'noopener' %>
    <%= link_to '编辑小节', edit_admin_course_chapter_lesson_path(@course, @chapter, @lesson), class: 'hl-btn hl-btn-primary' %>
  </div>
</div>

<div class="hl-card mb-8">
  <div class="px-6 py-4 border-b border-line bg-bg-mute">
    <h2 class="text-hl-13 font-semibold text-muted-3">基本信息</h2>
  </div>
  <div class="p-6 space-y-4">
    <div>
      <span class="text-hl-12 text-muted-4 block mb-1">标题</span>
      <span class="text-hl-13 text-ink"><%= @lesson.title %></span>
    </div>
    <div class="flex items-center space-x-6">
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">访问级别</span>
        <% level = @lesson.effective_access_level %>
        <span class="inline-flex px-2 py-1 text-hl-12 font-medium <%= level.to_i > 0 ? 'bg-blue-50 text-link border border-blue-200' : 'bg-green-50 text-green-600 border border-green-200' %> rounded">
          <%= access_level_label(level) %>
          <% if @lesson.access_level.nil? %>
            <span class="ml-1 text-muted-4">(继承章节)</span>
          <% end %>
        </span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">状态</span>
        <span class="text-hl-13 text-muted"><%= @lesson.published? ? '已发布' : '草稿' %></span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">排序</span>
        <span class="text-hl-13 text-muted"><%= @lesson.sort_num %></span>
      </div>
      <div>
        <span class="text-hl-12 text-muted-4 block mb-1">更新时间</span>
        <span class="text-hl-13 text-muted"><%= @lesson.updated_at.strftime('%Y-%m-%d %H:%M') %></span>
      </div>
    </div>
  </div>
</div>

<div class="hl-card">
  <div class="px-6 py-4 border-b border-line bg-bg-mute">
    <h2 class="text-hl-13 font-semibold text-muted-3">内容预览</h2>
  </div>
  <% if @lesson.content.present? %>
    <article class="p-6 max-w-none
      prose prose-neutral
      prose-p:text-hl-14 prose-p:text-muted prose-p:leading-relaxed
      prose-headings:text-ink prose-h1:text-hl-22 prose-h2:text-hl-18 prose-h3:text-hl-16
      prose-a:text-link prose-a:no-underline hover:prose-a:text-link-hover
      prose-strong:text-ink prose-strong:font-semibold
      prose-code:text-hl-13 prose-code:bg-bg-mute prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-bg-mute prose-pre:text-ink prose-pre:rounded prose-pre:overflow-x-auto prose-pre:p-4 prose-pre:text-hl-13 prose-pre:leading-relaxed prose-pre:border prose-pre:border-line-soft prose-pre:font-mono
      prose-table:w-full prose-table:text-hl-13
      prose-th:bg-bg-soft prose-th:text-muted-2 prose-th:font-medium prose-th:px-4 prose-th:py-2
      prose-td:px-4 prose-td:py-2 prose-td:border-b prose-td:border-line-soft
      prose-img:rounded prose-img:border prose-img:border-line-soft prose-img:mx-auto
      prose-blockquote:border-l-link prose-blockquote:text-muted-3 prose-blockquote:not-italic
      prose-ul:text-muted prose-ol:text-muted
      prose-li:text-hl-14
      prose-hr:border-line-soft">
      <%= sanitize @lesson.markdown_html, tags: %w[p a img ul ol li h1 h2 h3 h4 h5 h6 pre code blockquote table thead tbody tr th td strong em br hr span div], attributes: %w[href src alt class id target rel width height] %>
    </article>
  <% else %>
    <div class="p-6 text-hl-13 text-muted-4">暂无内容</div>
  <% end %>
</div>
