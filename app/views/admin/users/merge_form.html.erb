<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">账号归并</h1>
  <p class="mt-2 text-gray-600">把源账号 #<%= @user.id %>（<%= @user.nickname %> / <%= @user.email %>）的数据与登录凭据并入目标账号</p>
</div>

<div class="hl-card max-w-2xl">
  <div class="px-6 py-4 border-b border-gray-100">
    <h2 class="text-lg font-semibold text-gray-900">源账号现状</h2>
  </div>
  <div class="px-6 py-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-gray-700">
    <div>收藏：<span class="font-medium"><%= @user.user_favorites.count %></span></div>
    <div>消息：<span class="font-medium"><%= @user.messages.count %></span></div>
    <div>订单：<span class="font-medium"><%= @user.orders.count %></span></div>
    <div>API Key：<span class="font-medium"><%= @user.api_keys.count %></span></div>
  </div>
  <div class="px-6 pb-4 text-sm text-gray-600">
    微信凭据：<%= @user.weixin_unionid.present? || @user.weixin_web_openid.present? || @user.weixin_app_openid.present? ? "有" : "无" %>；
    第三方凭据：<%= @user.identities.map(&:provider).presence || "无" %>；
    角色：<%= human_role(@user.role) %>
  </div>

  <div class="px-6 py-4 border-t border-gray-100">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">并入目标</h2>
    <%= form_with url: merge_admin_user_path(@user), method: :post, class: "space-y-5" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">目标用户 ID</label>
          <input type="text" name="target_user_id"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" placeholder="例如 121">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">或目标邮箱（ID 留空时生效）</label>
          <input type="email" name="target_email"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" placeholder="user@example.com">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">备注（工单号/依据，写入审计日志）</label>
        <textarea name="note" rows="2" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500 resize-none" placeholder="例如：工单 #231 谭伟航 微信+Google 双账号归并"></textarea>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-md px-4 py-3 text-sm text-amber-800">
        执行后：源账号数据与凭据迁移至目标账号并<b>归档（禁止登录、邮箱改为占位、不可逆）</b>；
        目标已有的同类凭据/收藏不会被覆盖；全程写入 merge_logs 审计。请再次核对两个账号确属同一人。
      </div>

      <div class="flex gap-3">
        <button type="submit" class="hl-btn hl-btn-primary" data-turbo-confirm="确认执行归并？此操作不可逆！">执行归并</button>
        <%= link_to "返回", admin_user_path(@user), class: "hl-btn hl-btn-line" %>
      </div>
    <% end %>
  </div>
</div>
