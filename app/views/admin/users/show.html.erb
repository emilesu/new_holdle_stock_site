<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">用户详情</h1>
  <p class="mt-2 text-gray-600">查看用户 <%= @user.nickname %> 的详细信息</p>
</div>

<div class="hl-card">
  <div class="px-6 py-4 border-b border-line">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <%= user_avatar_tag(@user, size: "w-14 h-14", css_class: "text-2xl") %>
        <div>
          <h2 class="text-hl-18 font-bold text-ink"><%= @user.nickname %></h2>
          <p class="text-muted">#<%= @user.id %></p>
        </div>
      </div>
      <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold
        <%= case @user.role
             when 'super_admin' then 'bg-red-100 text-red-800'
             when 'admin' then 'bg-purple-100 text-purple-800'
             when 'member' then 'bg-blue-100 text-blue-800'
             else 'bg-gray-100 text-gray-800'
           end %>">
        <%= human_role(@user.role) %>
      </span>
    </div>
  </div>

  <div class="px-6 py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-gray-50 rounded-md p-5">
        <h3 class="text-sm font-medium text-gray-500 mb-4">基本信息</h3>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-500">邮箱</span>
            <span class="font-medium text-gray-900 text-right"><%= @user.email %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">昵称</span>
            <span class="font-medium text-gray-900 text-right"><%= @user.nickname %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">角色</span>
            <span class="font-medium text-gray-900 text-right"><%= human_role(@user.role) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">会员到期</span>
            <span class="font-medium text-gray-900 text-right">
              <%= @user.member_expire_at.present? ? l(@user.member_expire_at, format: :long) : '未开通会员' %>
            </span>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-md p-5">
        <h3 class="text-sm font-medium text-gray-500 mb-4">时间信息</h3>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-500">注册时间</span>
            <span class="font-medium text-gray-900 text-right"><%= l(@user.created_at, format: :long) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">最后登录</span>
            <span class="font-medium text-gray-900 text-right">
              <%= @user.last_login_at.present? ? l(@user.last_login_at, format: :long) : '暂无记录' %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">信息更新</span>
            <span class="font-medium text-gray-900 text-right"><%= l(@user.updated_at, format: :long) %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 bg-gray-50 rounded-md p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">个人简介</h3>
      <p class="text-gray-900 leading-relaxed min-h-[60px]">
        <%= @user.bio.presence || '<span class="text-gray-400">暂无简介</span>'.html_safe %>
      </p>
    </div>

    <%# T7 Phase2 B1：AI 投研 KEY（只读展示，操作在 edit 页） %>
    <% key = @user.api_keys.active.first %>
    <div class="mt-6 bg-gray-50 rounded-md p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">AI 投研 KEY</h3>
      <% if key %>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Key</span>
            <span class="font-mono font-medium text-gray-900"><%= key.key_prefix %>…</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">套餐</span>
            <span class="font-medium text-gray-900"><%= key.plan_name %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">剩余次数</span>
            <span class="font-medium text-gray-900"><%= key.unlimited? ? "无限" : "#{key.quota_remaining} 次" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">状态</span>
            <span class="font-medium <%= key.status == "active" ? "text-green-600" : "text-red-600" %>">
              <%= key.status == "active" ? "使用中" : (key.status == "disabled" ? "已停用" : "已吊销") %>
            </span>
          </div>
        </div>

        <h4 class="text-xs font-medium text-gray-400 mt-5 mb-2">最近用量（近 10 条）</h4>
        <% usage_logs = key.usage_logs.order(created_at: :desc).limit(10) %>
        <% if usage_logs.any? %>
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left text-gray-400 border-b border-gray-200">
                <th class="py-1.5 pr-3 font-medium">时间</th>
                <th class="py-1.5 pr-3 font-medium">工具</th>
                <th class="py-1.5 font-medium">消耗</th>
              </tr>
            </thead>
            <tbody>
              <% usage_logs.each do |log| %>
                <tr class="border-b border-gray-100">
                  <td class="py-1.5 pr-3 text-gray-500"><%= l(log.created_at, format: :short) %></td>
                  <td class="py-1.5 pr-3 text-gray-700"><%= log.tool_name.presence || "-" %></td>
                  <td class="py-1.5 text-gray-700"><%= log.consumed %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-xs text-gray-400">暂无调用记录</p>
        <% end %>

        <h4 class="text-xs font-medium text-gray-400 mt-5 mb-2">最近调整记录（近 5 条）</h4>
        <% adjustments = key.api_key_adjustments.order(created_at: :desc).limit(5) %>
        <% if adjustments.any? %>
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left text-gray-400 border-b border-gray-200">
                <th class="py-1.5 pr-3 font-medium">时间</th>
                <th class="py-1.5 pr-3 font-medium">调整</th>
                <th class="py-1.5 pr-3 font-medium">管理员</th>
                <th class="py-1.5 font-medium">备注</th>
              </tr>
            </thead>
            <tbody>
              <% adjustments.each do |a| %>
                <tr class="border-b border-gray-100">
                  <td class="py-1.5 pr-3 text-gray-500"><%= l(a.created_at, format: :short) %></td>
                  <td class="py-1.5 pr-3 <%= a.delta.positive? ? "text-green-600" : "text-red-600" %> font-medium">
                    <%= a.delta.positive? ? "+#{a.delta}" : a.delta %>
                  </td>
                  <td class="py-1.5 pr-3 text-gray-700"><%= a.admin.nickname %></td>
                  <td class="py-1.5 text-gray-700"><%= a.reason %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-xs text-gray-400">暂无调整记录</p>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-400">该用户暂无 active AI KEY</p>
      <% end %>
    </div>
  </div>
</div>

<div class="flex space-x-4">
  <%= link_to "编辑", edit_admin_user_path(@user),
    class: "hl-btn hl-btn-primary" %>
  <%= link_to "返回列表", admin_users_path,
    class: "hl-btn hl-btn-line" %>
</div>
