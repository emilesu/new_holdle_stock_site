    <div class="flex justify-center">
      <%= link_to "免费领 15 次体验", new_user_registration_path, class: "hl-btn hl-btn-primary" %>
      <%= link_to "看使用教程", ai_assistant_path, class: "hl-btn hl-btn-line" %>
    </div>
  </div>
</section>

<%# ========== 为什么需要 AI 助手 ========== %>
<section class="border-b border-line">
  <div class="container-hl py-16">
    <div class="label-en">WHY AI ASSISTANT</div>
    <h2 class="text-hl-22 font-semibold text-ink mb-2">学投资最难的不是「看懂」，是「用起来」</h2>
    <p class="text-hl-13 text-muted-3 mb-7">课程免费了，但你还需要有人陪你练——把方法用在自己的投资决策上。</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-7">
      <div class="hl-card hl-card-hover p-7">
        <div class="text-hl-11 text-muted-5 tracking-wide-2 mb-3">01 / UNDERSTAND</div>
        <h3 class="text-hl-16 font-semibold mb-2">课程里没懂的？问它</h3>
        <p class="text-hl-13 text-muted-3 leading-normal mb-5 min-h-11">状态A 的入场时机怎么判断？」</p>
        <ul class="mb-5">
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">带你一步步理解方法论</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">讲到你会用为止</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">基于 HOLDLE 完整知识库</li>
        </ul>
      </div>
      <div class="hl-card hl-card-hover p-7">
        <div class="text-hl-11 text-muted-5 tracking-wide-2 mb-3">02 / ANALYZE</div>
        <h3 class="text-hl-16 font-semibold mb-2">拿到股票想分析？问它</h3>
        <p class="text-hl-13 text-muted-3 leading-normal mb-5 min-h-11">「帮我按 HOLDLE 方法分析 600519」</p>
        <ul class="mb-5">
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">带你按「选好→等好→管好」走</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">企业质量 + 状态A 双判断</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">不荐股，教你判断</li>
        </ul>
      </div>
      <div class="hl-card hl-card-hover p-7">
        <div class="text-hl-11 text-muted-5 tracking-wide-2 mb-3">03 / MANAGE</div>
        <h3 class="text-hl-16 font-semibold mb-2">自己的操作拿不准？问它</h3>
        <p class="text-hl-13 text-muted-3 leading-normal mb-5 min-h-11">「三阶止损怎么设？」</p>
        <ul class="mb-5">
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">交易管理规则随时查</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">入场 / 仓位 / 出场全覆盖</li>
          <li class="py-1 text-hl-13 text-muted relative pl-3.5 list-dot-link">规则化执行，不被情绪左右</li>
        </ul>
      </div>
    </div>

    <div class="hl-callout mb-7">
      AI 投研助手基于 HOLDLE 完整方法论，陪你一步步想清楚 —— 它只讲方法，判断权在你。
    </div>
  </div>
</section>

<%# ========== 定价核心区 ========== %>
<section class="border-b border-line bg-white">
  <div class="container-hl py-16">
    <div class="label-en">PRICING</div>
    <h2 class="text-hl-22 font-bold text-ink mb-2">透明定价，一屏看清</h2>
    <p class="text-hl-13 text-muted mb-8">从免费体验到会员，进阶实战 + AI 无限次</p>

    <%# 定价区动态渲染 Plan.active（v1.40.1 由硬编码改为与 /plans 同源，避免双数据源漂移）；卖点文案按 plan_code 维护 %>
    <% if Plan.active.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto">
      <% pricing_features = {
        "welcome" => ["先安装试一下", "体验完再决定"],
        "member_permanent" => ['AI 助手<span class="text-ink font-medium">无限次</span>使用', "AI 助手完整能力", "AI 助手配套优化「股票回测专用数据脚本」(省token神器)", "进阶实战内容 全解锁", "金字塔排名 全解锁", "HOLDLE技术交流群", "深度投研必备"]
      } %>
      <% Plan.active.order(:price_cents).each do |plan| %>
        <% unlimited = plan.quota.nil? %>
        <% is_member = plan.is_member_upgrade %>
        <div class="hl-card p-7 flex flex-col <%= is_member ? 'border-2 border-ink' : '' %>">
          <div class="flex items-center justify-between mb-1">
            <h3 class="text-hl-15 font-semibold text-ink"><%= plan.name %></h3>
            <% if is_member %>
              <span class="inline-block border border-profit text-profit px-2 py-0.5 text-hl-11 font-medium">推荐</span>
            <% end %>
          </div>
          <p class="text-hl-12 text-muted-3 mb-4"><%= plan.plan_code == "welcome" ? "注册即送，无门槛" : (is_member ? "一次付费" : "按次付费") %></p>
          <p class="text-hl-22 font-bold text-ink mb-1"><%= plan.price_cents.zero? ? "免费" : "¥#{format('%g', plan.price_yuan)}" %></p>
          <p class="text-hl-22 font-bold text-ink mb-4"><%= unlimited ? "无限次" : "#{plan.quota} 次" %></p>
          <ul class="text-hl-13 text-muted space-y-2 mb-5 flex-1">
            <% (pricing_features[plan.plan_code] || []).each do |feature| %>
              <li class="relative pl-3.5 list-dot-link"><%= feature.html_safe %></li>
            <% end %>
          </ul>
          <% if plan.plan_code == "welcome" %>
            <%= link_to "免费领取", new_user_registration_path, class: "hl-btn hl-btn-line w-full text-center" %>
          <% else %>
            <%= link_to is_member ? "解锁进阶实战 · 无限次" : "购买", new_order_path(plan: plan.plan_code), class: "hl-btn #{is_member ? 'hl-btn-primary' : 'hl-btn-line'} w-full text-center" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% else %>
      <p class="text-hl-14 text-muted-4 text-center py-8">套餐筹备中，请稍后再来</p>
    <% end %>

    <p class="text-hl-12 text-muted-4 text-center mt-6">
      ※ 虚拟服务一经购买不支持退款（购买前请确认需求）；15 次免费体验，满意再升级会员（无限次）。
    </p>
  </div>
</section>

<%# ========== 老会员权益 ========== %>
<section class="border-b border-line">
  <div class="container-narrow py-16 text-center">
    <div class="label-en">FOR OLD MEMBERS</div>
    <h2 class="text-hl-22 font-bold text-ink mb-4">老会员，我们没忘</h2>
    <p class="text-hl-14 text-muted leading-loose">
      历史付费会员：已送<span class="text-profit font-semibold">永久 AI 权益（无限次）</span>，登录查看你的 Key。<br />
      感谢多年支持，希望这套方法继续陪你走得稳。
    </p>
    <p class="mt-6">
      <%= link_to "登录查看我的 Key", users_profile_path, class: "hl-btn hl-btn-line" %>
    </p>
  </div>
</section>

<%# ========== 简版 FAQ ========== %>
<section class="border-b border-line bg-white">
  <div class="container-narrow py-16">
    <div class="label-en">FAQ</div>
    <h2 class="text-hl-22 font-bold text-ink mb-8">关于 AI 投研助手</h2>

    <div class="hl-card overflow-hidden hl-faq">
      <details class="hl-faq-item">
        <summary>
          <span class="hl-q-badge">Q</span>
          <span>AI 助手会荐股吗？</span>
          <span class="hl-faq-icon">+</span>
        </summary>
        <div class="hl-faq-content">不会。它只讲方法——教你「怎么判断」，不替你做决定。不荐股、不预测、不承诺收益是 HOLDLE 的红线。</div>
      </details>

      
      <details class="hl-faq-item">
        <summary>
          <span class="hl-q-badge">Q</span>
          <span>AI 助手用什么工具能接？</span>
          <span class="hl-faq-icon">+</span>
        </summary>
        <div class="hl-faq-content">
          任何支持 MCP 协议的 AI 工具都可以：Trae、Claude Desktop、Cursor、WorkBuddy 等。把专属 Key 填进工具的 MCP 配置即可，有图文教程。
        </div>
      </details>

      <details class="hl-faq-item">
        <summary>
          <span class="hl-q-badge">Q</span>
          <span>AI 助手怎么收费？</span>
          <span class="hl-faq-icon">+</span>
        </summary>
        <div class="hl-faq-content">
          按提问次数计算：<br><br>
          新注册免费送 15 次体验；<br>
          468 元会员 = 进阶实战解锁 + AI 无限次使用（含金字塔排名、回测数据脚本、技术交流群）。<br><br>
          虚拟服务一经购买不支持退款。
        </div>
      </details>

      <details class="hl-faq-item">
        <summary>
          <span class="hl-q-badge">Q</span>
          <span>我的 Key 用完了 / 泄露了怎么办？</span>
          <span class="hl-faq-icon">+</span>
        </summary>
        <div class="hl-faq-content">
          次数用完可升级 468 会员（无限次）；Key 泄露可在个人中心自助重新生成，旧 Key 立即失效。每个账号默认 1 个 Key，请勿分享。
        </div>
      </details>

      <details class="hl-faq-item">
        <summary>
          <span class="hl-q-badge">Q</span>
          <span>支持退款吗？</span>
          <span class="hl-faq-icon">+</span>
        </summary>
        <div class="hl-faq-content">虚拟服务，购买前请确认需求，一经购买不支持退款。15 次免费体验，体验后再决定。详见 <%= link_to "《服务协议》", terms_path, class: "underline underline-offset-2 hover:text-profit transition-colors" %>。</div>
      </details>
    </div>
  </div>
</section>

