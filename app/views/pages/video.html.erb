<% set_page_title "视频" %>
<% set_page_description "观看大苏的视频内容，涵盖股票投资、交易策略、创业思考等主题。" %>

<%# ========== Hero（左右两栏：头像 + 平台入口） ========== %>
<section class="py-hl-hero bg-white border-b border-line">
  <div class="container-hl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

    <%# 左栏：圆形头像 + 简短文案 %>
    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
      <div class="w-32 h-32 rounded-full overflow-hidden border border-line bg-bg-mute">
        <%= image_tag "https://video.holdle.com/image/default/DB438C3A8E5A4422A99C71EB48B1F3B9-6-2.jpg", alt: "大苏", class: "w-full h-full object-cover" %>
      </div>
      <h1 class="text-hl-22 md:text-hl-40 font-bold leading-tight text-ink mt-6 mb-3">大苏 EmileSu</h1>
      <p class="text-hl-14 text-muted leading-relaxed max-w-md">
        股票投资、交易策略、创业与学习。两个平台同步更新，选你方便的就行。
      </p>
    </div>

    <%# 右栏：两个平台大按钮 %>
    <div class="space-y-4">
      <a href="https://space.bilibili.com/270587047" target="_blank" rel="noopener noreferrer"
         class="hl-card hl-card-hover p-6 flex items-center gap-5">
        <div class="w-14 h-14 rounded bg-[#FB7299] flex items-center justify-center shrink-0">
          <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-hl-16 font-semibold text-ink mb-1">Bilibili</h3>
          <p class="text-hl-12 text-muted">中文为主，国内用户推荐访问 B 站频道</p>
        </div>
        <svg class="w-5 h-5 text-muted-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>

      <a href="https://www.youtube.com/@EmileSu" target="_blank" rel="noopener noreferrer"
         class="hl-card hl-card-hover p-6 flex items-center gap-5">
        <div class="w-14 h-14 rounded bg-red-600 flex items-center justify-center shrink-0">
          <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-hl-16 font-semibold text-ink mb-1">YouTube</h3>
          <p class="text-hl-12 text-muted">海外用户推荐访问 YouTube 频道</p>
        </div>
        <svg class="w-5 h-5 text-muted-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<%# ========== 往期视频（3 列卡片网格） ========== %>
<section class="py-16">
  <div class="container-hl">
    <div class="mb-8">
      <span class="label-en">VIDEOS</span>
      <h2 class="text-hl-22 font-bold text-ink">往期视频</h2>
    </div>

    <% if @videos.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @videos.each do |video| %>
          <div class="hl-card overflow-hidden flex flex-col">
            <div class="aspect-video bg-bg-mute overflow-hidden">
              <%= image_tag video.cover_url, alt: video.title, loading: "lazy", class: "w-full h-full object-cover", onerror: "this.style.display='none'" %>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-hl-14 font-semibold text-ink mb-4 leading-snug"><%= video.title %></h3>
              <div class="flex flex-wrap gap-2 mt-auto">
                <% if video.bilibili_url.present? %>
                  <a href="<%= video.bilibili_url %>" target="_blank" rel="noopener noreferrer" class="hl-btn hl-btn-line !py-1.5 !px-3 text-hl-12">Bilibili</a>
                <% end %>
                <% if video.youtube_url.present? %>
                  <a href="<%= video.youtube_url %>" target="_blank" rel="noopener noreferrer" class="hl-btn hl-btn-line !py-1.5 !px-3 text-hl-12">YouTube</a>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="hl-card p-10 text-center">
        <p class="text-hl-13 text-muted">视频正在整理中，敬请期待。</p>
      </div>
    <% end %>
  </div>
</section>

<section class="border-t border-line py-16 bg-white">
  <div class="container-narrow text-center">
    <p class="text-hl-13 text-muted">
      如果你喜欢我的内容，欢迎订阅并分享给更多朋友。
    </p>
    <p class="text-hl-12 text-muted-3 mt-4">— 大苏 EmileSu</p>
  </div>
</section>
