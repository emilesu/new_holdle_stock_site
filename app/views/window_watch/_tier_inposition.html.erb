<%# ④持仓管理（契约 v0.5 §三 + 2026-11-25 老板定）：跟随预设筛选的持仓子集，默认折叠
    两态：有命中行=逐股明细 top10+折叠（列头在名头与列表之间）；v1.1 无逐股行=降级仅计数（stats 全量口径）；
    v1.2 命中为空=整块隐藏（与计数条④段同步）
    副标题为 DSH 确认版固定文案（V7 逐字验收）；行=开窗·入场·持仓三时点叙事，金字塔序 %>
<% return if rows.empty? && count.to_i <= 0 %>
<section id="ww-inpos" class="hl-card scroll-mt-24">
  <details>
    <summary class="px-5 py-4 cursor-pointer select-none list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
      <span class="text-hl-16 font-semibold text-ink">④ 持仓管理
        <span class="text-hl-13 text-muted-3 font-normal ml-1"><%= rows.any? ? ww_block_summary(rows) : "#{count} 只" %></span>
      </span>
      <span class="text-hl-11 text-muted-4 border border-dashed border-line rounded px-1.5 py-0.5">排除桶</span>
      <svg class="w-3.5 h-3.5 text-muted-4 transition-transform open:rotate-90 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </summary>
    <div class="border-t border-line">
      <p class="px-5 pt-3 pb-2 text-hl-12 text-muted"><%= WindowWatchHelper::IN_POSITION_SUBTITLE %></p>
      <% if rows.empty? %>
        <%# v1.1 兼容降级：无逐股明细，仅全量计数（12 月 T+1 按 v1.2 推送后自然解除） %>
        <p class="px-5 py-4 text-hl-13 text-muted-3">共 <%= count %> 只（全量口径，未含预设过滤）；逐股明细将随下一批快照（snapshot 1.2）提供。</p>
      <% else %>
        <%= render "column_header" %>
        <div class="divide-y divide-line" data-controller="ww-row-link">
          <% rows.first(WindowWatchHelper::TOP_DISPLAY).each do |row| %><%= render "stock_row", row: row %><% end %>
        </div>
        <% if rows.size > WindowWatchHelper::TOP_DISPLAY %>
          <details class="border-t border-line">
            <summary class="px-5 py-2.5 cursor-pointer select-none list-none text-hl-12 text-muted hover:text-ink [&::-webkit-details-marker]:hidden">展开其余 <%= rows.size - WindowWatchHelper::TOP_DISPLAY %> 只</summary>
            <div class="divide-y divide-line border-t border-line" data-controller="ww-row-link">
              <% rows.drop(WindowWatchHelper::TOP_DISPLAY).each do |row| %><%= render "stock_row", row: row %><% end %>
            </div>
          </details>
        <% end %>
      <% end %>
    </div>
  </details>
</section>
