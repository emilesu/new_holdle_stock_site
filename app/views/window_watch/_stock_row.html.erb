<%# 逐股卡片行（§4.1/§4.2 v0.3.0）：技术判定=快照；名称/行业/财务标注=Trae 财务库 join（契约 v0.4.0 §三.1）
    join 未覆盖的行照常展示技术判定，仅不显示财务标注（兜底常态，非异常） %>
<% ov = @overlay[row.code.to_s.upcase] %>
<div class="px-5 py-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 hover:bg-bg-soft">
  <div class="min-w-[150px]">
    <%= link_to (ov ? ov[:name] : row.name), stock_path(row.code.upcase), class: "text-hl-14 font-medium text-ink hover:text-link" %>
    <span class="text-hl-12 text-muted-3 ml-1.5 font-mono"><%= row.symbol %></span>
  </div>

  <span class="text-hl-12 text-muted-2 min-w-[72px]"><%= (ov ? ov[:industry].presence : row.industry.presence) || "—" %></span>

  <% if ov && ov[:finance] %>
    <%= ww_badge "金融", "金融行业（银行/证券/保险）" %>
  <% end %>
  <% if ov && ov[:st] %>
    <%= ww_badge "ST", "ST/*ST 股票（仅标注，不剔除）" %>
  <% end %>

  <div class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1">
    <% if ov && ov[:roe_latest] %>
      <%= ww_badge "ROE #{number_with_precision(ov[:roe_latest], precision: 1)}%",
                   "最新披露年报加权 ROE（财务库口径；筛选预设见页顶档位说明）" %>
    <% end %>

    <%= render "hist_glyph", row: row %>

    <% case row.tier %>
    <% when "T1" %>
      <span class="text-hl-12 text-muted-2 whitespace-nowrap"><%= row.open_month %> 开窗 · 已存活 <%= row.months_since_open %> 个月</span>
    <% when "T2_P2", "T2_P1" %>
      <span class="text-hl-12 text-muted-3 whitespace-nowrap"><%= row.tier == "T2_P1" ? "状态A中断前连续" : "状态A连续" %> <%= row.sa_run %> 个月</span>
    <% when "T3" %>
      <span class="text-hl-12 text-muted-3 whitespace-nowrap">状态A连续 <%= row.sa_run %> 个月</span>
      <% if (note = WindowWatchHelper::T3_SUBTAG_NOTES[row.subtag]) %>
        <span class="text-hl-12 text-muted-4"><%= note %></span>
      <% end %>
    <% end %>
  </div>
</div>
