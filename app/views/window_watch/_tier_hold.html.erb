<%# ③状态A·暂不开窗（§三⑤ + R1）：保持默认折叠，计数可见；锚点 ww-t3；列头在名头与列表之间（⑥统一样式） %>
<section id="ww-t3" class="hl-card scroll-mt-24">
  <details>
    <summary class="px-5 py-4 cursor-pointer select-none list-none flex items-center gap-2 [&::-webkit-details-marker]:hidden">
      <span class="text-hl-16 font-semibold text-ink">③ 状态A · 暂不开窗
        <span class="text-hl-13 text-muted-3 font-normal ml-1"><%= rows.size %> 只</span>
      </span>
      <svg class="w-3.5 h-3.5 text-muted-4 transition-transform open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </summary>
    <div class="border-t border-line">
      <p class="px-5 pt-3 pb-2 text-hl-12 text-muted"><%= WindowWatchHelper::TIER_SUBTITLES["T3"] %></p>
      <% if rows.empty? %>
        <p class="px-5 py-4 text-hl-13 text-muted-3">本月状态A·暂不开窗暂无股票</p>
      <% else %>
        <%= render "column_header" %>
        <div class="divide-y divide-line" data-controller="ww-row-link">
          <% rows.each do |row| %><%= render "stock_row", row: row %><% end %>
        </div>
      <% end %>
    </div>
  </details>
</section>
