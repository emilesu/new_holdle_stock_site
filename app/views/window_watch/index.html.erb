<% set_page_title "状态A - 月K开窗观察 - HOLDLE 方法论月K状态" %>
<% set_page_description "按 HOLDLE 方法论对全A股月K状态的客观描述：开窗观察、红柱收敛、绿柱收敛与暂不开窗分层，每月更新。" %>
<div class="min-h-screen bg-bg-soft">
  <main class="container-hl py-8 space-y-5">
    <% if @snapshot.nil? %>
      <%# R4 冷启动：库内一次快照都没有（决议4） %>
      <%= render "cold_start" %>
    <% elsif !@is_member %>
      <%# §一 访问控制：非会员 = 定位说明 + 四档计数 teaser，不渲染任何个股（V12） %>
      <%= render "nonmember" %>
    <% else %>
      <%= render "header" %>

      <%# 视图开关（§三② v0.3.0）：主组改为页面侧财务预设；切换时筛选条件重置（R1，行为一致） %>
      <div class="flex flex-wrap items-center gap-1 text-hl-13" role="tablist">
        <%# 视图/档位切换保留判定月（month=latest 时无副作用） %>
        <%= link_to "财务预设", window_watch_path(view: "main", month: @snapshot.month),
              class: "px-3 py-1.5 rounded-md border #{'bg-white border-ink text-ink font-medium' if @view == 'main'} #{'border-line text-muted hover:text-ink' unless @view == 'main'}" %>
        <%= link_to "全部股票", window_watch_path(view: "all", month: @snapshot.month),
              class: "px-3 py-1.5 rounded-md border #{'bg-white border-ink text-ink font-medium' if @view == 'all'} #{'border-line text-muted hover:text-ink' unless @view == 'all'}" %>
        <% if @view == "main" %>
          <%# 三维筛选控件（2026-11-25 老板定）：年数 × 满足方式 × ROE阈值；切换互不丢失（保留 month） %>
          <span class="ml-3 text-hl-12 text-muted-3">近</span>
          <div class="inline-flex rounded-md border border-line overflow-hidden divide-x divide-line" role="group" aria-label="财年数">
            <% WindowWatch::FinancialPreset::YEARS.each do |y| %>
              <%= link_to "#{y}年", window_watch_path(view: "main", years: y, mode: @mode, band: @band, month: @snapshot.month),
                    class: "px-2 py-1 text-hl-12 #{y == @years ? 'bg-ink text-white font-medium' : 'bg-white text-muted hover:text-ink'}" %>
            <% end %>
          </div>
          <span class="text-hl-12 text-muted-3">财年 ROE</span>
          <% mode_tips = { "consecutive" => "连续满足：每年 ROE ≥ 阈值，主值取 N 年最小值",
                           "average" => "平均满足：N 年算术平均 ≥ 阈值，且每年 ROE ≥ 阈值×70%，主值取 N 年算术平均（两种模式均要求每年经营现金流为正）" } %>
          <div class="inline-flex rounded-md border border-line overflow-hidden divide-x divide-line" role="group" aria-label="满足方式">
            <% WindowWatch::FinancialPreset::MODES.each do |md| %>
              <%= link_to WindowWatch::FinancialPreset::MODE_NAMES[md], window_watch_path(view: "main", years: @years, mode: md, band: @band, month: @snapshot.month),
                    class: "hl-tip px-2 py-1 text-hl-12 #{md == @mode ? 'bg-ink text-white font-medium' : 'bg-white text-muted hover:text-ink'}",
                    data: { tip: mode_tips[md] } %>
            <% end %>
          </div>
          <div class="inline-flex rounded-md border border-line overflow-hidden divide-x divide-line" role="group" aria-label="ROE 阈值">
            <% WindowWatch::FinancialPreset::BANDS.each do |b| %>
              <%= link_to "#{b}%", window_watch_path(view: "main", years: @years, mode: @mode, band: b, month: @snapshot.month),
                    class: "px-2.5 py-1 text-hl-12 #{b == @band ? 'bg-ink text-white font-medium' : 'bg-white text-muted hover:text-ink'}" %>
            <% end %>
          </div>
          <span class="text-hl-12 text-muted-3">且每年经营现金流为正（最新披露年报口径，财务库筛选）</span>
        <% else %>
          <span class="ml-2 text-hl-12 text-muted-4">全部=技术形态全量列表</span>
        <% end %>
        <%# R2②：判定月切换（历史快照回看；切换时筛选条件重置，行为与视图开关一致） %>
        <% if @months.size > 1 %>
          <%= form_with url: window_watch_path, method: :get, class: "ml-auto flex items-center gap-1.5" do %>
            <%= hidden_field_tag :view, @view %>
            <label class="text-hl-12 text-muted-3" for="ww_month">判定月</label>
            <select id="ww_month" name="month" class="px-2 py-1.5 text-hl-12 border border-line rounded-md bg-white focus:border-link">
              <% @months.each do |m| %>
                <option value="<%= m %>" <%= "selected" if m == @snapshot.month %>><%= m %></option>
              <% end %>
            </select>
            <button type="submit" class="px-2.5 py-1.5 text-hl-12 rounded-md border border-line text-muted hover:text-ink hover:border-ink">切换</button>
          <% end %>
        <% end %>
      </div>

      <% if @view == "main" %>
        <%# 不做区块缓存：命中集随财务库日批变化，缓存会陈旧；查询走索引+预设日缓存，成本可忽略（V9 实时正确） %>
        <%# 列头说明行（2026-11-25 老板定）：与卡片行共用六列栅格保证对齐 %>
        <div class="px-5 py-2 grid <%= WindowWatchHelper::WW_CARD_GRID %> gap-x-4 gap-y-1 text-hl-12 text-muted-3">
          <span>名称/代码 · 板块行业</span>
          <span class="hl-tip" data-tip="网站金字塔综合分（财务评分，口径见金字塔页），预设内按此降序排列" tabindex="0">金字塔</span>
          <span class="hl-tip" data-tip="<%= ww_roe_metric_tip(@mode, @years) %>" tabindex="0">ROE(筛选值)</span>
          <span>形态</span>
          <span>状态</span>
          <span>标注</span>
        </div>
        <%= render "tier_open", rows: @t1 %>
        <%= render "tier_forming", p2: @t2_p2, p1: @t2_p1 %>
        <%= render "tier_hold", rows: @t3 %>
        <%= render "tier_inposition", rows: @in_position, count: @preset_counts["IN_POSITION"] %>
      <% else %>
        <%= render "full_table" %>
      <% end %>

      <%= render "glossary" %>
    <% end %>

    <% if @snapshot %>
      <%= render "disclaimer" %>
    <% end %>
  </main>
</div>
