<%# ========== 5. 历史战绩 ========== %>
<section class="py-16 bg-white">
  <div class="container-hl">
    <div class="label-en">CASE CLOSED · 已结案案例</div>
    <h2 class="text-hl-22 font-semibold text-ink mb-2">方法论的历史验证</h2>
    <p class="text-hl-13 text-muted-3 mb-7">按 HOLDLE 策略完整执行的公开案例。方法论的有效性是长期可复现的。</p>

    <div class="hl-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse hl-table">
          <thead>
            <tr>
              <th class="w-1/3">股票</th>
              <th class="w-1/4">区间</th>
              <th class="w-1/6">收益</th>
              <th>一句话备注</th>
            </tr>
          </thead>
          <tbody>
            <%# 数据硬编码，不依赖 controller 变量 %>
            <% cases = [
              { name: "贵州茅台", code: "SH600519", range: "2016.05 → 2018.08", ret: "+125.3%", note: '一笔最经典的"等状态A再买"' },
              { name: "海康威视", code: "SZ002415", range: "2017.03 → 2018.02", ret: "+88.8%",  note: "得概率优势，守株待兔" },
              { name: "伟星新材", code: "SZ002372", range: "2016.07 → 2018.09", ret: "+64.5%",  note: "建材行业隐藏的优等生" },
              { name: "爱尔眼科", code: "SZ300015", range: "2017.11 → 2018.08", ret: "+52.3%",  note: '医疗器械的"长潜"样本' },
              { name: "海天味业", code: "SH603288", range: "2017.05 → 2020.02", ret: "+128.3%",  note: "食品消费类龙头" },
              { name: "谷歌", code: "GOOG", range: "2020.07 → 2022.01",  ret: "+74.6%",  note: "科技巨头，盈利能力高" },
              { name: "英伟达", code: "NVDA",    range: "2023.05 → 2025.01", ret: "+287.0%",  note: "全球市值最高的公司" },
              { name: "台积电", code: "TSM",    range: "2023.11 → 2025.02", ret: "+62%",  note: "垄断芯片市场，每股收益极高" }
            ] %>
            <% cases.each do |c| %>
              <tr>
                <td>
                  <%= link_to stock_path(c[:code]), class: "font-semibold text-ink hover:text-profit transition-colors" do %>
                    <%= c[:name] %>
                    <span class="text-muted-4 text-hl-12 ml-1.5"><%= c[:code] %></span>
                  <% end %>
                </td>
                <td><%= c[:range] %></td>
                <td><span class="profit-up profit-up-before"><%= c[:ret] %></span></td>
                <td><%= c[:note] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="px-6 py-4 bg-bg-soft border-t border-line-soft text-hl-12 text-muted-3 leading-relaxed">       
        ※ 以上案例均为按 HOLDLE 方法论完整执行并已结案的盈利案例。过去的战绩不代表未来，但方法论的有效性是长期可复现的。</br>
        ※ 我希望这套方法能成为你长期使用的工具，而不是短期暴富的承诺。
      </div>
    </div>
  </div>
</section>

