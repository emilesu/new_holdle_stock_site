<%# 「加载更早消息」按钮：服务端下发 (created_at, id) 复合游标，加载完更早历史后替换为无更多提示 %>
<div id="earlier_control" class="text-center py-2">
  <% if has_earlier %>
    <button type="button"
            class="px-4 py-1.5 text-hl-12 text-muted bg-white border border-line rounded-full shadow-sm hover:bg-bg-mute transition-colors cursor-pointer disabled:opacity-50"
            data-action="message#loadEarlier"
            data-before-at="<%= cursor_at.iso8601(6) %>"
            data-before-id="<%= cursor_id %>">加载更早消息</button>
  <% else %>
    <span class="inline-block px-2.5 py-0.5 text-hl-11 text-muted-4">— 没有更早的消息了 —</span>
  <% end %>
</div>
