<%# 加载更早一页：prepend 到消息流头部，并替换顶部按钮状态（更新游标/无更多提示） %>
<%= turbo_stream.prepend "message_thread" do %>
  <%= render "messages/thread", messages: @earlier %>
<% end %>
<%= turbo_stream.replace "earlier_control" do %>
  <%= render "messages/earlier_control", cursor_at: @new_cursor_at, cursor_id: @new_cursor_id, has_earlier: @has_earlier %>
<% end %>
