<% set_page_title "AI复盘报告 - Holdle" %>
<% set_page_description "AI驱动的股票复盘分析报告，深度解读市场走势和个股表现。" %>
<% set_page_keywords "AI复盘,股票分析,市场复盘,个股分析" %>
<div class="py-16">
  <div class="container-narrow">
    <div class="label-en">ARTICLES - HOLDLE-AI REVIEW</div>
    <h1 class="text-hl-22 font-semibold text-ink mb-2">HOLDLE-AI 复盘报告</h1>
    <p class="text-hl-13 text-muted-3 mb-7">由课程知识库搭建的 HOLDLE-AI 股票复盘分析，帮助你更好地理解操作细节，和HOLDLE的实战价值。</p>

    <div class="grid grid-cols-1 gap-4">
      <% @articles.each do |article| %>
        <%= link_to article_path(article), class: 'hl-card hl-card-hover block transition-colors' do %>
          <div class="p-6 sm:p-7">
            <div class="flex items-start gap-3 mb-2">
              <h2 class="text-hl-16 font-semibold text-ink flex-1 min-w-0"><%= article.title %></h2>
              <% if article.member_only? %>
                <span class="shrink-0 inline-flex px-2 py-0.5 text-hl-11 font-medium bg-bg-mute text-muted-3 border border-line-soft rounded">会员</span>
              <% else %>
                <span class="shrink-0 inline-flex px-2 py-0.5 text-hl-11 font-medium bg-bg-soft text-muted-4 border border-line-soft rounded">公开</span>
              <% end %>
            </div>
            <% if article.summary.present? %>
              <p class="text-hl-13 text-muted line-clamp-2"><%= article.summary %></p>
            <% end %>
            <% if article.published_at.present? %>
              <div class="mt-3 text-hl-12 text-muted-4">
                <%= l(article.published_at.to_date, format: :long) %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if @articles.empty? %>
        <div class="hl-card py-16 text-center">
          <p class="text-hl-14 text-muted-4">暂无文章</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
