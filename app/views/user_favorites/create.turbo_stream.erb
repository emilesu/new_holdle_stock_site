<%= turbo_stream.replace "follow_stock_#{@stock.id}" do %>
  <%= turbo_frame_tag "follow_stock_#{@stock.id}" do %>
    <%= render "shared/favorite_rating", stock: @stock, favorite: @user_favorite, variant: :detail %>
  <% end %>
<% end %>

<%# 首次收藏同样要就地点亮列表行内 compact 星标（开窗观察/收藏页行等）；
    与 update.turbo_stream 同规：Turbo 对不存在的目标静默跳过，一个流可同时服务多页面 %>
<%= turbo_stream.replace "favorite_rating_#{@stock.id}_row" do %>
  <%= render "shared/favorite_rating", stock: @stock, favorite: @user_favorite, variant: :compact %>
<% end %>

<%= turbo_stream.remove "favorite_card_#{@stock.id}" %>

<% remaining = current_user.user_favorites.count %>
<%# 收藏页的「共 N 只」计数需随收藏同步；其他页面没有该元素，Turbo 对缺失目标静默跳过 %>
<%= turbo_stream.replace "favorites_summary" do %>
  <span id="favorites_summary" class="text-ink font-medium"><%= remaining %></span>
<% end %>
