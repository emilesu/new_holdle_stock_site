<%= turbo_stream.replace "follow_stock_#{@stock.id}" do %>
  <%= turbo_frame_tag "follow_stock_#{@stock.id}" do %>
    <%= button_to "收藏股票", user_favorites_path(stock_id: @stock.id), method: :post,
      class: "w-full hl-btn hl-btn-primary mt-4" %>
  <% end %>
<% end %>

<%= turbo_stream.replace "follow_stock_quick_#{@stock.id}" do %>
  <%= turbo_frame_tag "follow_stock_quick_#{@stock.id}" do %>
    <%= button_to "收藏股票", user_favorites_path(stock_id: @stock.id), method: :post,
      class: "w-full py-2 text-left text-sm text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" %>
  <% end %>
<% end %>

<%= turbo_stream.remove "favorite_card_#{@stock.id}" %>

<% remaining = current_user.user_favorites.count %>
<%# 收藏页的「共 N 只」计数需随取消收藏同步；其他页面没有该元素，Turbo 对缺失目标静默跳过 %>
<%= turbo_stream.replace "favorites_summary" do %>
  <span id="favorites_summary" class="text-ink font-medium"><%= remaining %></span>
<% end %>

<%# 取消到一条不剩时补渲染空态，否则收藏页只剩一片空白（「筛选出」计数由收藏页脚本就地递减） %>
<% if remaining.zero? %>
  <%= turbo_stream.replace "favorites_list" do %>
    <div id="favorites_list">
      <%= render partial: "users/profiles/empty_state", locals: { total: 0 } %>
    </div>
  <% end %>
<% end %>
