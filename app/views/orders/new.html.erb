<% set_page_title "开通会员" %>

<%= javascript_tag nonce: true do %>
  document.addEventListener('turbo:load', function() {
    var labels = document.querySelectorAll('[data-payment-label]');
    labels.forEach(function(label) {
      var radio = label.querySelector('input[type=radio]');
      radio.addEventListener('change', function() {
        labels.forEach(function(l) {
          l.classList.toggle('border-ink', l.querySelector('input[type=radio]').checked);
        });
      });
    });
  });
<% end %>

<section class="bg-bg-soft min-h-screen">
  <div class="container-hl py-12">
    <div class="max-w-lg mx-auto">
      <h1 class="text-hl-22 font-bold text-ink mb-2">开通会员</h1>
      <p class="text-hl-13 text-muted mb-8">确认以下信息并完成支付</p>

      <div class="hl-card p-7 mb-6">
        <h2 class="text-hl-16 font-semibold text-ink mb-4"><%= @plan.name %></h2>

        <div class="space-y-3 mb-6">
          <div class="flex justify-between text-hl-13">
            <span class="text-muted">套餐类型</span>
            <span class="text-ink font-medium"><%= @plan.unlimited? ? "永久会员（无限次）" : "#{@plan.quota} 次" %></span>
          </div>
          <div class="flex justify-between text-hl-13">
            <span class="text-muted">支付方式</span>
            <span class="text-ink font-medium">微信支付 / 支付宝</span>
          </div>
          <div class="w-full h-px bg-line"></div>
          <div class="flex justify-between text-hl-16">
            <span class="text-ink font-semibold">合计</span>
            <span class="text-profit font-bold">¥<%= @plan.price_cents / 100 %></span>
          </div>
        </div>

        <%# 到账说明：当前 Key 状态 + 购买效果（T7 支付流程改造） %>
        <% if (key = current_user.api_keys.active.first) %>
          <div class="bg-bg-soft rounded px-5 py-4 mb-5 text-hl-12 text-muted space-y-1.5">
            <p>当前 Key：<span class="text-ink font-medium"><%= key.plan_name %></span>，剩余 <span class="text-ink font-medium"><%= key.unlimited? ? "无限次" : "#{key.quota_remaining} 次" %></span></p>
            <p>
              <% if @plan.unlimited? %>
                购买后将把同一把 Key 转为无限次使用。
              <% elsif key.unlimited? %>
                当前 Key 已为无限次使用，无需购买次数包。
              <% else %>
                购买后将自动叠加 <span class="text-ink font-medium"><%= @plan.quota %></span> 次，不会重复发放 Key。
              <% end %>
            </p>
            <p class="text-profit font-medium">支付成功自动到账，无需人工确认。</p>
          </div>
        <% else %>
          <div class="bg-bg-soft rounded px-5 py-4 mb-5 text-hl-12 text-muted space-y-1.5">
            <p>支付成功后系统将自动为你生成专属 Key，可在个人中心查看与复制。</p>
            <p class="text-profit font-medium">支付成功自动到账，无需人工确认。</p>
          </div>
        <% end %>

        <form action="<%= orders_path %>" method="post" data-turbo="false">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="plan" value="<%= @plan.plan_code %>">

          <%# 支付方式选择：微信 / 支付宝 %>
          <div class="mb-6">
            <p class="text-hl-12 text-muted mb-3">选择支付方式</p>
            <label class="hl-card flex items-center gap-3 px-4 py-3 mb-3 cursor-pointer border-ink" data-payment-label="wechat">
              <input type="radio" name="payment_method" value="wechat" class="accent-ink" checked>
              <span class="text-hl-14 font-medium text-ink">微信支付</span>
              <span class="text-hl-12 text-muted-4 ml-auto">微信扫码 / 微信内拉起</span>
            </label>
            <label class="hl-card flex items-center gap-3 px-4 py-3 cursor-pointer" data-payment-label="alipay">
              <input type="radio" name="payment_method" value="alipay" class="accent-ink">
              <span class="text-hl-14 font-medium text-ink">支付宝</span>
              <span class="text-hl-12 text-muted-4 ml-auto">支付宝扫码 / 唤起支付宝 App</span>
            </label>
          </div>

          <button type="submit" class="hl-btn hl-btn-primary block w-full text-center py-3">
            确认支付 ¥<%= @plan.price_cents / 100 %>
          </button>
        </form>

        <p class="text-hl-12 text-muted-4 text-center mt-4">
          支付即表示同意 <%= link_to "《服务协议》", terms_path, class: "text-muted-3 underline underline-offset-2 hover:text-ink transition-colors" %>
        </p>
      </div>

      <p class="text-hl-12 text-muted-4 text-center">
        遇到问题？请邮件联系 emilesu@holdle.com
      </p>
    </div>
  </div>
</section>
