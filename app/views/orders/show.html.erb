<% set_page_title "支付中" %>

<section class="bg-bg-soft min-h-screen">
  <div class="container-hl py-12">
    <div class="max-w-lg mx-auto text-center">
      <% if @order.payment_method == "wechat_jsapi" %>
        <%# 微信内 JSAPI 支付 %>
        <div class="hl-card p-7 mb-6">
          <div class="mb-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-bg-mute rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-muted-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h2 id="wx-pay-title" class="text-hl-18 font-bold text-ink mb-2">正在拉起微信支付...</h2>
            <p id="wx-pay-sub" class="text-hl-13 text-muted">如果未自动弹出，请点击下方按钮</p>
          </div>

          <button id="wx-pay-btn" data-pay-params="<%= @pay_params.to_json %>"
                  class="hl-btn hl-btn-primary block w-full text-center py-3">
            立即支付 ¥<%= @order.amount_yuan %>
          </button>
        </div>

        <%= javascript_tag nonce: true do %>
          document.addEventListener('turbo:load', function() {
            var btn = document.getElementById('wx-pay-btn');
            if (!btn) return;

            var payParams = JSON.parse(btn.dataset.payParams);
            var orderId = <%= @order.id %>;
            var invokedKey = 'hl_wxpay_' + orderId;

            function invokeWechatPay() {
              // 标记已调用，防止刷新页面重复触发
              try { sessionStorage.setItem(invokedKey, '1'); } catch(e) {}

              if (typeof WeixinJSBridge === 'undefined') {
                document.addEventListener('WeixinJSBridgeReady', function() {
                  WeixinJSBridge.invoke('getBrandWCPayRequest', payParams, function(res) {
                    if (res.err_msg === 'get_brand_wcpay_request:ok') {
                      window.location.href = '<%= order_path(@order) %>';
                    }
                  });
                });
              } else {
                WeixinJSBridge.invoke('getBrandWCPayRequest', payParams, function(res) {
                  if (res.err_msg === 'get_brand_wcpay_request:ok') {
                    window.location.href = '<%= order_path(@order) %>';
                  }
                });
              }
            }

            btn.addEventListener('click', invokeWechatPay);

            // 仅首次加载时自动拉起，刷新页面不重复触发
            var alreadyInvoked = false;
            try { alreadyInvoked = sessionStorage.getItem(invokedKey) === '1'; } catch(e) {}
            if (!alreadyInvoked) {
              setTimeout(invokeWechatPay, 500);
            } else {
              // 已拉起过一次（支付成功跳回本页、回调未到），切换为确认中文案，避免误导已支付用户
              var titleEl = document.getElementById('wx-pay-title');
              var subEl = document.getElementById('wx-pay-sub');
              if (titleEl) titleEl.textContent = '正在确认支付结果...';
              if (subEl) subEl.textContent = '如已完成支付，页面将自动跳转；未支付请点击下方按钮';
            }
          });
        <% end %>
      <% elsif @order.payment_method == "alipay_wap" %>
        <%# 支付宝手机网站支付：自动跳转唤起 App（未装则进 H5 收银台） %>
        <div class="hl-card p-7 mb-6">
          <div class="mb-6">
            <div class="w-16 h-16 mx-auto mb-4 bg-bg-mute rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-muted-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h2 id="ali-pay-title" class="text-hl-18 font-bold text-ink mb-2">正在拉起支付宝...</h2>
            <p id="ali-pay-sub" class="text-hl-13 text-muted">如果未自动跳转，请点击下方按钮</p>
          </div>

          <a id="ali-pay-btn" href="<%= @order.code_url %>"
             class="hl-btn hl-btn-primary block w-full text-center py-3">
            去支付宝付款 ¥<%= @order.amount_yuan %>
          </a>
        </div>

        <%= javascript_tag nonce: true do %>
          document.addEventListener('turbo:load', function() {
            var btn = document.getElementById('ali-pay-btn');
            if (!btn) return;
            var orderId = <%= @order.id %>;
            var invokedKey = 'hl_alipay_' + orderId;
            var alreadyInvoked = false;
            try { alreadyInvoked = sessionStorage.getItem(invokedKey) === '1'; } catch(e) {}
            if (!alreadyInvoked) {
              try { sessionStorage.setItem(invokedKey, '1'); } catch(e) {}
              window.location.href = btn.href;
            } else {
              // 已跳转过一次（支付成功跳回本页、回调未到），切为确认中文案
              var titleEl = document.getElementById('ali-pay-title');
              var subEl = document.getElementById('ali-pay-sub');
              if (titleEl) titleEl.textContent = '正在确认支付结果...';
              if (subEl) subEl.textContent = '如已完成支付，页面将自动跳转；未支付请点击上方按钮';
            }
          });
        <% end %>
      <% else %>
        <%# Native 扫码支付（微信 / 支付宝通用） %>
        <div class="hl-card p-7 mb-6">
          <h2 class="text-hl-18 font-bold text-ink mb-4">
            <%= @order.payment_method == "alipay_native" ? "请使用支付宝扫码支付" : "请使用微信扫码支付" %>
          </h2>
          <div class="flex justify-center mb-6">
            <div id="qrcode-container" data-controller="qrcode"
                 data-qrcode-url="<%= @order.code_url %>"
                 class="inline-block bg-white border border-line p-3">
              <canvas data-qrcode-target="canvas"></canvas>
            </div>
          </div>
          <p class="text-hl-13 text-muted">订单金额：<span class="text-profit font-semibold">¥<%= @order.amount_yuan %></span></p>
          <p class="text-hl-12 text-muted-4 mt-2">二维码有效期 30 分钟，过期后需重新下单</p>
        </div>

        <p class="text-hl-12 text-muted-4">支付成功后将自动跳转</p>
      <% end %>
    </div>
  </div>
</section>

<% unless @order.paid? %>
  <%# JSAPI/Native 均轮询：JSAPI 支付成功跳回本页时回调可能未到，轮询到 paid 后 reload 进落地页 %>
  <%= javascript_tag nonce: true do %>
    // 统一清理：定时器 + visibilitychange 监听。
    // 订单页强制登录且 layout 对登录态注入 turbo-cache-control:no-cache，Turbo 不会触发 turbo:before-cache，
    // 因此必须同时挂在 turbo:before-render（每次 Turbo 渲染新页面前必触发）上，防止离开订单页后监听器跨页面泄漏。
    function stopOrderPolling() {
      if (window._orderPollTimer) {
        clearInterval(window._orderPollTimer);
        window._orderPollTimer = null;
      }
      if (window._orderVisHandler) {
        document.removeEventListener('visibilitychange', window._orderVisHandler);
        window._orderVisHandler = null;
      }
    }

    // 先移除旧监听再挂载，避免多次访问订单页时 before-render/before-cache 监听器累积
    if (window._stopOrderPolling) {
      document.removeEventListener('turbo:before-cache', window._stopOrderPolling);
      document.removeEventListener('turbo:before-render', window._stopOrderPolling);
    }
    window._stopOrderPolling = stopOrderPolling;
    document.addEventListener('turbo:before-cache', window._stopOrderPolling);
    document.addEventListener('turbo:before-render', window._stopOrderPolling);

    document.addEventListener('turbo:load', function() {
      stopOrderPolling();

      var paid = <%= @order.paid? %>;
      if (paid) return;

      function checkOrderStatus() {
        fetch('<%= status_order_path(@order) %>', { headers: { 'Accept': 'application/json' } })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.paid) {
              clearInterval(window._orderPollTimer);
              window._orderPollTimer = null;
              window.location.reload();
            }
          })
          .catch(function() { /* 网络抖动忽略，下一轮继续 */ });
      }

      window._orderPollTimer = setInterval(checkOrderStatus, 3000);

      // 扫码支付时页面常处于后台 tab，setInterval 会被浏览器节流；切回页面立即检查一次，避免「刷新才跳转」
      window._orderVisHandler = function() {
        if (!document.hidden) checkOrderStatus();
      };
      document.addEventListener('visibilitychange', window._orderVisHandler);
    });
  <% end %>
<% end %>
