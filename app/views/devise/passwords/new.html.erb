<% set_page_title "忘记密码" %>
<div class="py-16 bg-bg-soft min-h-screen">
  <div class="container-narrow">
    <div class="hl-card p-8 sm:p-10">

      <div class="text-center mb-7">
        <span class="text-hl-11 text-muted-5 tracking-wide-2 font-medium block mb-3">HOLD LE</span>
        <h1 class="text-hl-22 font-semibold text-ink">忘记密码</h1>
        <p class="mt-2 text-hl-13 text-muted-3">输入注册邮箱获取验证码，验证后设置新密码</p>
      </div>

      <%# 两步同页：第一步 POST 发码（create），成功后 @email_sent 置真，同页展开第二步表单（PATCH update） %>
      <%= form_with url: user_password_path, method: :post, class: "space-y-4" do %>
        <div>
          <label class="block text-hl-13 font-medium text-muted mb-1.5">注册邮箱</label>
          <input type="email" name="email" required autocomplete="email" placeholder="your@email.com"
            value="<%= @email_sent || params[:email] %>"
            class="w-full px-4 py-2.5 border border-line rounded text-hl-14 text-ink bg-white focus:outline-none focus:border-muted-3 transition-colors">
        </div>
        <div>
          <button type="submit" class="hl-btn hl-btn-line w-full text-center">获取邮箱验证码</button>
        </div>
      <% end %>

      <% if @email_sent %>
        <div class="mt-5 pt-5 border-t border-line-soft">
          <%= form_with url: user_password_path, method: :patch, class: "space-y-4" do %>
            <input type="hidden" name="email" value="<%= @email_sent %>">
            <div>
              <label class="block text-hl-13 font-medium text-muted mb-1.5">邮箱验证码</label>
              <input type="text" name="code" required inputmode="numeric" maxlength="6" placeholder="6 位数字"
                class="w-full px-4 py-2.5 border border-line rounded text-hl-14 text-ink bg-white focus:outline-none focus:border-muted-3">
            </div>
            <div>
              <label class="block text-hl-13 font-medium text-muted mb-1.5">新密码</label>
              <input type="password" name="password" required autocomplete="new-password" placeholder="至少 8 位"
                class="w-full px-4 py-2.5 border border-line rounded text-hl-14 text-ink bg-white focus:outline-none focus:border-muted-3">
            </div>
            <div>
              <label class="block text-hl-13 font-medium text-muted mb-1.5">确认新密码</label>
              <input type="password" name="password_confirmation" required autocomplete="new-password"
                class="w-full px-4 py-2.5 border border-line rounded text-hl-14 text-ink bg-white focus:outline-none focus:border-muted-3">
            </div>
            <div>
              <button type="submit" class="hl-btn hl-btn-primary w-full text-center">重置密码</button>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mt-7 pt-5 border-t border-line-soft text-center">
        <p class="text-hl-13 text-muted-3">
          曾用微信/Google 登录且未绑定邮箱？请返回登录页用对应方式登录后，在个人中心绑定邮箱。
        </p>
        <p class="text-hl-13 text-muted-3 mt-2">
          <%= link_to "返回登录", new_session_path(resource_name), class: "text-link hover:text-link-hover font-medium transition-colors" %>
        </p>
      </div>

    </div>
  </div>
</div>
