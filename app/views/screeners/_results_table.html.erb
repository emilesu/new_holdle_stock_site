<%# 筛选结果表：仿股票详情页财务表，年份为列、指标为行；每只股票按启用指标占多行，股票信息列跨行合并 %>
<%# 会员真实结果与非会员示例共用（示例传 masked: true 把指标数值打码），保证表头与列结构与真实结果始终一致 %>
<%# locals: stocks, conditions, metrics, indicator_rows, year_range, fmt, fmt_yi, display_name；masked 可选 %>
<% masked = local_assigns.fetch(:masked, false) %>
<% muted = masked ? 'text-muted-3' : '' %>
<%# 仿股票详情页：前导五列定宽吸附左侧（lg 及以上），仅年份与数据区表内横滑；手机端只吸股票列避免小屏挤爆 %>
<%# 吸附偏移 = 各列定宽累计：股票208 + 板块128 + 行业144 + 金字塔分96 + 指标112 %>
<div class="overflow-x-auto" data-screener-target="scroller">
  <%# table-fixed 使 lg 定宽列逐像素精确，吸附偏移不漂移（修复列间缝隙漏内容）；年份列不设宽度均分余量，min-width 保证每列至少 96px %>
  <table class="hl-table w-full lg:table-fixed" style="min-width: <%= 688 + 96 * year_range.size %>px">
    <thead>
      <tr>
        <th class="text-left sticky left-0 z-20 bg-bg-soft whitespace-nowrap lg:w-52 lg:max-w-52 lg:truncate">股票</th>
        <th class="text-left whitespace-nowrap lg:sticky lg:left-52 lg:z-20 lg:bg-bg-soft lg:w-32 lg:max-w-32 lg:truncate">板块</th>
        <th class="text-left whitespace-nowrap lg:sticky lg:left-84 lg:z-20 lg:bg-bg-soft lg:w-36 lg:max-w-36 lg:truncate">行业</th>
        <th class="whitespace-nowrap lg:sticky lg:left-120 lg:z-20 lg:bg-bg-soft lg:w-24">金字塔分</th>
        <th class="text-left whitespace-nowrap lg:sticky lg:left-144 lg:z-20 lg:bg-bg-soft lg:w-28 lg:shadow-[6px_0_6px_-6px_rgba(0,0,0,0.12)]">指标</th>
        <% year_range.each do |y| %>
          <th class="text-hl-12 font-semibold text-ink-soft whitespace-nowrap"><%= y %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% stocks.each do |stock| %>
        <% m = metrics[stock.id] || { years: {} } %>
        <% my = m[:years] || {} %>
        <% indicator_rows.each_with_index do |g, gi| %>
          <tr class="cursor-pointer border-t border-line-soft"
              data-action="mouseover->screener#rowEnter mouseout->screener#rowLeave click->screener#openStock"
              data-screener-group-param="<%= stock.id %>" data-screener-url-param="<%= stock_path(stock) %>">
            <% if gi.zero? %>
              <td class="text-left bg-white sticky left-0 z-20 lg:w-52 lg:max-w-52" rowspan="<%= indicator_rows.size %>">
                <%# flex + 名称单独 truncate：列宽不足时只截断名称，代码与小图标始终可见 %>
                <div class="flex items-center min-w-0">
                  <%= link_to stock_path(stock), target: '_blank', rel: 'noopener', class: 'text-ink font-medium hover:text-link lg:truncate' do %>
                    <%= display_name.call(stock) %>
                  <% end %>
                  <span class="text-hl-11 text-muted-3 ml-1.5 font-mono shrink-0"><%= stock.symbol %></span>
                  <%# 次新股标记：无文字小图标，悬停/读屏显示注释；data-screener-no-open 阻止点击图标误触发整行跳转 %>
                  <% if stock.new_listing? %>
                    <span class="ml-1.5 shrink-0 inline-flex text-muted-3 cursor-help" title="<%= Stock.pyramid_tag_hint('次新股') %>"
                          aria-label="次新股" role="img" data-screener-no-open>
                      <%= new_listing_icon_tag %>
                    </span>
                  <% end %>
                  <%# 已收藏标记：实心星，颜色跟随链接色 %>
                  <% if @favorite_stock_ids.include?(stock.id) %>
                    <span class="ml-1.5 shrink-0 inline-flex text-link cursor-help" title="已收藏"
                          aria-label="已收藏" role="img" data-screener-no-open>
                      <%= favorite_icon_tag %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="text-left text-muted lg:sticky lg:left-52 lg:z-20 lg:bg-white lg:w-32 lg:max-w-32 lg:truncate" rowspan="<%= indicator_rows.size %>"><%= stock.sector || '—' %></td>
              <td class="text-left text-muted lg:sticky lg:left-84 lg:z-20 lg:bg-white lg:w-36 lg:max-w-36 lg:truncate" rowspan="<%= indicator_rows.size %>"><%= stock.industry || '—' %></td>
              <%# 非会员示例：金字塔分同样打码 %>
              <td class="text-center font-semibold lg:sticky lg:left-120 lg:z-20 lg:bg-white lg:w-24 <%= masked ? 'text-muted-3 font-mono' : 'text-link' %>" rowspan="<%= indicator_rows.size %>"><%= masked ? '**' : stock.pyramid_total_score %></td>
            <% end %>
            <td class="text-left text-muted whitespace-nowrap lg:sticky lg:left-144 lg:z-20 lg:bg-white lg:w-28 lg:shadow-[6px_0_6px_-6px_rgba(0,0,0,0.12)]"><%= g[:label] %></td>
            <% if g[:kind] == :year %>
              <% year_range.each do |y| %>
                <% val = (my[y] || {})[g[:mkey]] %>
                <td class="text-center font-mono whitespace-nowrap <%= muted %>"><%= masked ? '**' : (g[:mkey] == :ni ? fmt_yi.call(val) : fmt.call(val)) %></td>
              <% end %>
            <% else %>
              <%# 净利润同比为末年单值，仅在末年列展示 %>
              <% year_range.each do |y| %>
                <td class="text-center font-mono <%= muted %>"><%= y == conditions[:year_to] ? (masked ? '**' : fmt.call(m[:ni_growth])) : '—' %></td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>