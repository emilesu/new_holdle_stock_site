<% set_page_title "我的收藏" %>
<% set_page_description "查看您收藏的股票和关注的金融市场数据。" %>
<%# 手机端卡片四边贴屏（与企业质量档案正文一致）：md 以下无上下灰边、容器无左右留白 %>
<div class="md:py-16 bg-bg-soft min-h-screen" data-controller="favorites"
     data-action="turbo:before-fetch-request->favorites#loading turbo:fetch-request-error->favorites#frameLoaded">
  <div class="container-narrow-flush">

    <div class="hl-card overflow-hidden">

      <%# 用户头部 %>
      <div class="bg-ink px-6 sm:px-8 py-8">
        <div class="flex items-center justify-between gap-5">
          <div class="flex items-center gap-5 min-w-0">
            <%= user_avatar_tag(@user, size: "w-20 h-20", css_class: "text-hl-22") %>
            <div class="min-w-0">
              <h1 class="text-hl-18 font-semibold text-white">我的收藏</h1>
              <p class="text-hl-13 text-white/60 mt-0.5"><%= @user.nickname %> 的收藏股票</p>
            </div>
          </div>
          <%= link_to "个人中心", users_profile_path, class: "text-hl-12 text-white/60 hover:text-white transition-colors shrink-0" %>
        </div>
      </div>

      <%# 工具栏：表单必须放在 turbo-frame 之外，局部刷新才不会替换输入框（保住焦点与输入法组词状态） %>
      <%= form_with url: users_profile_favorites_path, method: :get,
            data: { turbo_frame: "favorites_results", favorites_target: "form",
                    action: "change->favorites#submitNow" },
            class: "px-6 sm:px-8 py-4 border-b border-line bg-white space-y-3" do %>
        <div class="relative">
          <label for="favorites-query" class="sr-only">搜索收藏的股票</label>
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-4 select-none" aria-hidden="true">⌕</span>
          <input type="search" id="favorites-query" name="q" value="<%= @q %>"
                 placeholder="搜索代码 / 名称 / 拼音首字母..."
                 autocomplete="off" enterkeyhint="search"
                 data-favorites-target="query"
                 data-action="input->favorites#search search->favorites#search compositionend->favorites#compositionEnd"
                 class="w-full pl-8 pr-3 py-2 text-hl-13 text-ink border border-line rounded-md focus:border-link focus:outline-none bg-white placeholder:text-muted-4">
          <button type="submit" class="sr-only">搜索</button>
        </div>

        <%# 筛选与排序：手机端横向滚动，桌面端换行 %>
        <div class="flex items-center gap-2 overflow-x-auto pb-1 -mx-1 px-1 sm:flex-wrap sm:overflow-visible sm:pb-0 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-1.5 shrink-0">
            <label for="favorites-market" class="text-hl-13 font-medium text-muted-2 shrink-0">市场</label>
            <select id="favorites-market" name="market" class="px-3 py-2 text-hl-13 border border-line rounded-md focus:border-link bg-white">
              <option value="" <%= 'selected' if @market.blank? %>>全部</option>
              <% [%w[CN A股], %w[HK 港股], %w[US 美股]].each do |code, label| %>
                <option value="<%= code %>" <%= 'selected' if @market == code %>><%= label %></option>
              <% end %>
            </select>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <label for="favorites-sector" class="text-hl-13 font-medium text-muted-2 shrink-0">板块</label>
            <select id="favorites-sector" name="sector" class="px-3 py-2 text-hl-13 border border-line rounded-md focus:border-link bg-white max-w-40" <%= 'disabled' if @sector_options.empty? %>>
              <option value="" <%= 'selected' if @sector.blank? %>>全部</option>
              <% @sector_options.each do |sector| %>
                <option value="<%= sector %>" <%= 'selected' if @sector == sector %>><%= sector %></option>
              <% end %>
            </select>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <label for="favorites-score-range" class="text-hl-13 font-medium text-muted-2 shrink-0">评分</label>
            <select id="favorites-score-range" name="score_range" class="px-3 py-2 text-hl-13 border border-line rounded-md focus:border-link bg-white" <%= 'disabled' unless @is_member %>>
              <option value="" <%= 'selected' if @score_range.blank? %>>全部</option>
              <option value="900_1000" <%= 'selected' if @score_range == '900_1000' %>>900 分以上</option>
              <option value="800_899" <%= 'selected' if @score_range == '800_899' %>>800–899 分</option>
              <option value="700_799" <%= 'selected' if @score_range == '700_799' %>>700–799 分</option>
              <option value="600_699" <%= 'selected' if @score_range == '600_699' %>>600–699 分</option>
              <option value="500_599" <%= 'selected' if @score_range == '500_599' %>>500–599 分</option>
              <option value="0_499" <%= 'selected' if @score_range == '0_499' %>>500 分以下（含未评分）</option>
            </select>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <label for="favorites-sort" class="text-hl-13 font-medium text-muted-2 shrink-0">排序</label>
            <select id="favorites-sort" name="sort" class="px-3 py-2 text-hl-13 border border-line rounded-md focus:border-link bg-white">
              <option value="recent" <%= 'selected' if @sort == 'recent' %>>最近收藏</option>
              <option value="score" <%= 'selected' if @sort == 'score' %> <%= 'disabled' unless @is_member %>>金字塔评分（高→低）</option>
            </select>
          </div>

          <button type="button"
                  class="hl-btn text-hl-12 shrink-0 aria-pressed:bg-ink aria-pressed:text-white aria-pressed:border-ink"
                  aria-pressed="<%= @group == 'market' %>" data-favorites-target="groupButton"
                  data-action="click->favorites#toggleGroup">按市场分组</button>
          <%= hidden_field_tag :group, @group, data: { favorites_target: "groupInput" } %>
        </div>

        <% unless @is_member %>
          <p class="text-hl-11 text-muted-3">
            金字塔评分的筛选与排序为会员功能 ·
            <%= link_to "了解会员权益", join_path, class: "text-link hover:underline" %>
          </p>
        <% end %>
      <% end %>

      <%# 结果区：Turbo Frame 局部刷新；frame 在空态/加载态下也必须存在，否则表单提交会无响应 %>
      <%= turbo_frame_tag "favorites_results",
            data: { favorites_target: "results",
                    action: "turbo:frame-load->favorites#frameLoaded turbo:frame-render->favorites#frameRendered" } do %>
        <div class="px-6 py-2 border-b border-line-soft flex items-center justify-between gap-3">
          <span class="text-hl-12 text-muted-3">
            共 <span id="favorites_summary" class="text-ink font-medium"><%= @total_favorites %></span> 只
            <% if @filtered %> · 筛选出 <span id="favorites_filtered_summary" class="text-ink font-medium"><%= @favorites.total_count %></span> 只<% end %>
            <span class="hidden text-muted-4" data-favorites-target="loadingHint">· 搜索中…</span>
          </span>
          <% if @filtered %>
            <button type="button" data-action="click->favorites#resetForm"
                    class="text-hl-12 text-link hover:text-link-hover transition-colors shrink-0">清除筛选</button>
          <% end %>
        </div>

        <%# 列表区整体包一层 id：取消收藏到一条不剩时，turbo_stream 会整块替换成空态 %>
        <div id="favorites_list">
          <% if @favorites.empty? %>
            <%= render partial: "users/profiles/empty_state", locals: { total: @total_favorites } %>
          <% else %>
            <div class="divide-y divide-line-soft">
              <% if @group == 'market' %>
                <% @favorites.group_by { |favorite| favorite.stock.market }.each do |market, favorites| %>
                  <%# 该市场若从上一页延续过来，本页不重复渲染分组标题 %>
                  <% unless market == @continued_market %>
                    <div data-market-group="<%= market %>" class="px-6 py-2 bg-bg-mute">
                      <span class="text-hl-12 font-medium text-muted-2"><%= market_label(market) %></span>
                    </div>
                  <% end %>
                  <%= render partial: "users/profiles/favorite_row", collection: favorites, as: :favorite, locals: { is_member: @is_member } %>
                <% end %>
              <% else %>
                <%= render partial: "users/profiles/favorite_row", collection: @favorites, as: :favorite, locals: { is_member: @is_member } %>
              <% end %>
            </div>

            <% if @favorites.total_pages > 1 %>
              <div class="px-6 py-4 border-t border-line">
                <%= paginate @favorites %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
