<% set_page_title "个人中心 - Holdle" %>
<% set_page_description "管理您的Holdle个人资料、收藏股票和账户设置。" %>
<div class="py-16 bg-bg-soft min-h-screen">
  <div class="container-narrow">

    <div class="hl-card overflow-hidden">

      <%# 用户头部 %>
      <div class="bg-ink px-6 sm:px-8 py-8">
        <div class="flex items-center gap-5">
          <%= user_avatar_tag(@user, size: "w-20 h-20", css_class: "text-hl-22") %>
          <div class="min-w-0">
            <h1 class="text-hl-18 font-semibold text-white"><%= @user.nickname %></h1>
            <div class="flex flex-wrap gap-2 mt-3">
              <span class="inline-flex px-2.5 py-0.5 text-hl-11 font-medium bg-white/10 text-white/80 border border-white/20 rounded"><%= human_role(@user.role) %></span>
            </div>
          </div>
        </div>
      </div>

      <%# 导航标签 %>
      <div class="flex border-b border-line px-6 sm:px-8">
        <nav class="flex gap-6">
          <a href="<%= users_profile_path %>" class="pb-3 border-b-2 border-ink text-ink font-medium text-hl-13">基本信息</a>
          <a href="<%= users_profile_favorites_path %>" class="pb-3 text-muted-3 hover:text-ink transition-colors text-hl-13">我的收藏</a>
        </nav>
      </div>

      <%# 信息区域 %>
      <div class="p-6 sm:p-8 space-y-5">

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">昵称</span>
          <span class="text-hl-15 text-ink font-medium"><%= @user.nickname %></span>
        </div>

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">个人简介</span>
          <span class="text-hl-14 text-muted leading-relaxed block min-h-[40px]">
            <%= @user.bio.presence || "<span class='text-muted-4'>暂无简介</span>".html_safe %>
          </span>
        </div>

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">角色权限</span>
          <span class="text-hl-14 text-ink font-medium"><%= human_role(@user.role) %></span>
        </div>

        <%# AI 投研助手 API Key（T7 Phase3：开放给所有用户，完整展示 + 复制 + 安装提示词） %>
        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-hl-12 text-muted-4">AI 投研助手 API Key</span>
            <% if @api_keys.any? %>
              <%= link_to "购买套餐充值", new_order_path, class: "text-hl-12 text-profit font-medium hover:underline" %>
            <% end %>
          </div>
          <% if @api_keys.any? %>
            <div class="space-y-4">
              <% @api_keys.each do |key| %>
                <div class="space-y-3">
                  <%# Key 完整展示 + 复制 %>
                  <div class="border border-line rounded px-4 py-3 bg-white" data-controller="copy">
                    <div class="flex items-center justify-between gap-3">
                      <span data-copy-target="source" class="text-hl-13 font-mono font-medium text-ink break-all"><%= key.key_plaintext.presence || "#{key.key_prefix}…" %></span>
                      <div class="flex items-center gap-2 shrink-0">
                        <button type="button" data-action="copy#copy" data-copy-label="复制 Key" class="hl-btn hl-btn-line px-3 py-1.5 text-hl-12">复制 Key</button>
                        <% if key.active? %>
                          <%= button_to "重新生成", users_regenerate_api_key_path, method: :post, form: { class: "inline" }, data: { confirm: "旧 Key 将立即失效，需在所有工具中更新配置。确定重新生成？" }, class: "hl-btn hl-btn-line px-3 py-1.5 text-hl-12" %>
                        <% end %>
                      </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-hl-12 text-muted-3">
                      <span class="<%= key.status == "active" ? "text-profit" : "text-muted-4" %>"><%= key.status == "active" ? "使用中" : (key.status == "disabled" ? "已停用" : "已吊销") %></span>
                      <span><%= key.plan_name %></span>
                      <span>剩余 <%= key.unlimited? ? "无限次" : "#{key.quota_remaining} 次" %></span>
                    </div>
                  </div>

                  <%# 安装提示词 + 复制（暂仅管理员可见，待开放给普通用户时去掉 is_admin? 包裹即可） %>
                  <% if current_user.is_admin? %>
                    <div data-controller="copy">
                      <div class="flex items-center justify-between mb-1.5">
                        <span class="text-hl-12 text-muted-4">安装提示词（复制后粘贴给你的 AI 工具）</span>
                        <button type="button" data-action="copy#copy" data-copy-label="复制提示词" class="hl-btn hl-btn-line px-3 py-1.5 text-hl-12">复制提示词</button>
                      </div>
                      <textarea readonly rows="9" data-copy-target="source" class="w-full bg-white border border-line rounded px-4 py-3 text-hl-12 text-muted font-mono leading-relaxed focus:outline-none"><%= install_prompt(key.key_plaintext) %></textarea>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <p class="text-hl-11 text-muted-4 mt-3">Key 请勿分享给他人；泄露可联系站长重新生成。</p>
          <% else %>
            <span class="text-hl-13 text-muted-3">暂无 API Key。</span>
            <%= link_to "去购买 AI 投研助手套餐", new_order_path, class: "text-hl-13 text-profit font-medium hover:underline ml-1" %>
          <% end %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-bg-soft rounded p-4 sm:p-5">
            <span class="text-hl-12 text-muted-4 block mb-1">注册时间</span>
            <span class="text-hl-14 text-ink font-medium"><%= l(@user.created_at, format: :long) %></span>
          </div>
          <div class="bg-bg-soft rounded p-4 sm:p-5">
            <span class="text-hl-12 text-muted-4 block mb-1">最后登录</span>
            <span class="text-hl-14 text-ink font-medium">
              <%= @user.last_login_at.present? ? l(@user.last_login_at, format: :long) : "<span class='text-muted-4'>暂无记录</span>".html_safe %>
            </span>
          </div>
        </div>

      </div>

      <%# 操作按钮 %>
      <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex flex-wrap gap-3">
        <%= link_to "编辑资料", users_edit_profile_path, class: "hl-btn hl-btn-primary" %>
        <% if current_user.is_admin? %>
          <%= link_to "后台管理", admin_root_path, class: "hl-btn hl-btn-line" %>
          <%= link_to "预览注册引导页", onboarding_path(preview: 1), class: "hl-btn hl-btn-line" %>
        <% end %>
      </div>

    </div>
  </div>
</div>