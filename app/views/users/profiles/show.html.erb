<% set_page_title "个人中心" %>
<% set_page_description "管理您的Holdle个人资料、收藏股票和账户设置。" %>
<div class="py-16 bg-bg-soft min-h-screen">
  <div class="container-narrow">

    <div class="hl-card overflow-hidden">

      <%# 用户头部 %>
      <div class="bg-ink px-6 sm:px-8 py-8">
        <div class="flex items-center gap-5">
          <%= user_avatar_tag(@user, size: "w-20 h-20", css_class: "text-hl-22") %>
          <div class="min-w-0">
            <h1 class="text-hl-18 font-semibold text-white"><%= @user.nickname %></h1>
            <div class="flex flex-wrap gap-2 mt-3">
              <span class="inline-flex px-2.5 py-0.5 text-hl-11 font-medium bg-white/10 text-white/80 border border-white/20 rounded"><%= human_role(@user.role) %></span>
            </div>
          </div>
        </div>
      </div>

      <%# 收藏入口（原「基本信息 / 我的收藏」Tab 已摘除，「股票收藏」提升为导航栏下拉菜单中的并列入口） %>
      <div class="px-6 sm:px-8 py-4 border-b border-line">
        <%= link_to users_profile_favorites_path, class: "flex items-center justify-between gap-3 group" do %>
          <span class="flex items-center gap-3 min-w-0">
            <%= favorite_icon_tag(class_name: "w-4 h-4 text-muted-4 shrink-0") %>
            <span class="text-hl-14 text-ink font-medium">我的收藏</span>
            <span class="text-hl-12 text-muted-4"><%= current_user.user_favorites.count %> 只</span>
          </span>
          <svg class="w-4 h-4 text-muted-4 shrink-0 group-hover:text-ink transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>

      <%# 信息区域 %>
      <div class="p-6 sm:p-8 space-y-5">

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">昵称</span>
          <span class="text-hl-15 text-ink font-medium"><%= @user.nickname %></span>
        </div>

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">个人简介</span>
          <span class="text-hl-14 text-muted leading-relaxed block min-h-[40px]">
            <%= @user.bio.presence || "<span class='text-muted-4'>暂无简介</span>".html_safe %>
          </span>
        </div>

        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">角色权限</span>
          <span class="text-hl-14 text-ink font-medium"><%= human_role(@user.role) %></span>
        </div>

        <%# 账号绑定（PR-4）：微信 / Google / 邮箱 凭据管理，解绑有守卫保证至少保留一种登录方式 %>
        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-3">账号绑定</span>
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2 min-w-0">
                <span class="text-hl-14 text-ink font-medium">微信</span>
                <% if @user.weixin_unionid.present? || @user.weixin_web_openid.present? || @user.weixin_app_openid.present? %>
                  <span class="text-hl-12 text-profit">已绑定</span>
                <% else %>
                  <span class="text-hl-12 text-muted-4">未绑定</span>
                <% end %>
              </span>
              <% if @user.weixin_unionid.present? || @user.weixin_web_openid.present? || @user.weixin_app_openid.present? %>
                <%= button_to "解绑", users_unlink_wechat_path, method: :delete, form: { class: "inline" }, data: { confirm: "解绑后将无法用微信登录此账号，确定解绑？" }, class: "hl-btn hl-btn-line px-3 py-1 text-hl-12" %>
              <% else %>
                <%= link_to "绑定微信", users_link_identity_path(wechat_browser? ? "wechat_mobile" : "wechat"), class: "hl-btn hl-btn-line px-3 py-1 text-hl-12" %>
              <% end %>
            </div>

            <% google_identity = @user.google_identity %>
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2 min-w-0">
                <span class="text-hl-14 text-ink font-medium">Google</span>
                <% if google_identity %>
                  <span class="text-hl-12 text-profit">已绑定</span>
                  <span class="text-hl-12 text-muted-4 truncate"><%= google_identity.email %></span>
                <% else %>
                  <span class="text-hl-12 text-muted-4">未绑定</span>
                <% end %>
              </span>
              <% if google_identity %>
                <%= button_to "解绑", users_identity_path(google_identity), method: :delete, form: { class: "inline" }, data: { confirm: "解绑后将无法用 Google 登录此账号，确定解绑？" }, class: "hl-btn hl-btn-line px-3 py-1 text-hl-12" %>
              <% else %>
                <%= link_to "绑定 Google", users_link_identity_path("google_oauth2"), class: "hl-btn hl-btn-line px-3 py-1 text-hl-12" %>
              <% end %>
            </div>

            <%# 邮箱行：占位邮箱=未绑定；绑定可选，但手机浏览器登录（无法用微信内置授权）的用户需要邮箱+密码 %>
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2 min-w-0">
                <span class="text-hl-14 text-ink font-medium">邮箱</span>
                <% if @user.real_email? %>
                  <span class="text-hl-12 text-profit">已绑定</span>
                  <span class="text-hl-12 text-muted-4 truncate"><%= @user.email %></span>
                <% else %>
                  <span class="text-hl-12 text-muted-4">未绑定</span>
                <% end %>
              </span>
              <% if @user.email_placeholder? && current_user == @user %>
                <%= link_to "绑定邮箱", "#email-binding-card", class: "hl-btn hl-btn-line px-3 py-1 text-hl-12" %>
              <% end %>
            </div>
          </div>
          <p class="text-hl-11 text-muted-4 mt-3">绑定后可用任一方式登录同一账号；为保证始终可登录，仅在存在其他登录方式时可解绑。不绑定邮箱也可继续用微信/Google 登录，但无法接收站点通知、无法在其他浏览器设备上登录。</p>
        </div>

        <%# PR-6：占位邮箱账号绑定真实邮箱（验证码即时生效，必须同步首设登录密码） %>
        <% if current_user.email_placeholder? %>
          <div id="email-binding-card" class="bg-bg-soft rounded p-4 sm:p-5 border border-line-soft">
            <span class="text-hl-12 text-muted-4 block mb-1">绑定真实邮箱</span>
            <p class="text-hl-12 text-muted-3 mb-4">当前账号邮箱为系统占位地址（<%= current_user.email %>），收不到通知也无法找回密码。绑定并设置密码后，可用邮箱+密码在任何浏览器登录；微信登录不受影响、无需密码，也可以暂不绑定。</p>
            <% if flash[:binding_error] %>
              <div class="mb-3 bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded text-hl-12"><%= flash[:binding_error] %></div>
            <% end %>

            <%= form_with url: users_email_binding_code_path, method: :post, class: "flex flex-wrap items-end gap-3 mb-4" do %>
              <div class="flex-1 min-w-[200px]">
                <label class="block text-hl-12 text-muted-4 mb-1">新邮箱</label>
                <input type="email" name="email" required placeholder="your@email.com"
                  class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
              </div>
              <button type="submit" class="hl-btn hl-btn-line px-4 py-2 text-hl-13">获取验证码</button>
            <% end %>

            <%= form_with url: users_email_binding_path, method: :patch, class: "space-y-3" do %>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">邮箱验证码</label>
                  <input type="text" name="code" required inputmode="numeric" maxlength="6" placeholder="6 位数字"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">设置登录密码</label>
                  <input type="password" name="password" required autocomplete="new-password" placeholder="至少 8 位"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">确认登录密码</label>
                  <input type="password" name="password_confirmation" required autocomplete="new-password"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
              </div>
              <button type="submit" class="hl-btn hl-btn-primary px-4 py-2 text-hl-13">验证并绑定</button>
            <% end %>
          </div>
        <% end %>

        <%# 登录密码：统一「绑定邮箱验证码」方式设置/修改（免当前密码），覆盖 Google/微信建号从未自设密码的死角 %>
        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <span class="text-hl-12 text-muted-4 block mb-1">登录密码</span>
          <% if current_user.email_placeholder? %>
            <p class="text-hl-12 text-muted-3">绑定真实邮箱后即可设置登录密码。微信/Google 登录不受影响、无需密码。</p>
          <% else %>
            <p class="text-hl-12 text-muted-3 mb-4">用于邮箱+密码登录与忘记密码找回。验证码将发送至 <%= current_user.email %>，修改无需当前密码。</p>
            <% if flash[:password_error] %>
              <div class="mb-3 bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded text-hl-12"><%= flash[:password_error] %></div>
            <% end %>

            <%= form_with url: users_password_setting_code_path, method: :post, class: "mb-4" do %>
              <button type="submit" class="hl-btn hl-btn-line px-4 py-2 text-hl-13">获取邮箱验证码</button>
            <% end %>

            <%= form_with url: users_password_setting_path, method: :patch, class: "space-y-3" do %>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">邮箱验证码</label>
                  <input type="text" name="code" required inputmode="numeric" maxlength="6" placeholder="6 位数字"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">新密码</label>
                  <input type="password" name="password" required autocomplete="new-password" placeholder="至少 8 位"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
                <div>
                  <label class="block text-hl-12 text-muted-4 mb-1">确认新密码</label>
                  <input type="password" name="password_confirmation" required autocomplete="new-password"
                    class="w-full px-4 py-2 border border-line rounded text-hl-13 text-ink bg-white focus:outline-none focus:border-muted-3">
                </div>
              </div>
              <button type="submit" class="hl-btn hl-btn-primary px-4 py-2 text-hl-13">保存新密码</button>
            <% end %>
          <% end %>
        </div>

        <%# AI 投研助手 API Key（T7 Phase3：开放给所有用户，完整展示 + 复制 + 安装提示词） %>
        <div class="bg-bg-soft rounded p-4 sm:p-5">
          <div class="flex items-center justify-between mb-3">
            <span class="text-hl-12 text-muted-4">AI 投研助手 API Key</span>
            <% if @api_keys.any? %>
              <%= link_to "购买套餐充值", plans_path, class: "text-hl-12 text-profit font-medium hover:underline" %>
            <% end %>
          </div>
          <% if @api_keys.any? %>
            <div class="space-y-4">
              <% @api_keys.each do |key| %>
                <div class="space-y-3">
                  <%# Key 完整展示 + 复制 %>
                  <div class="border border-line rounded px-4 py-3 bg-white" data-controller="copy">
                    <div class="flex items-center justify-between gap-3">
                      <span data-copy-target="source" class="text-hl-13 font-mono font-medium text-ink break-all"><%= key.key_plaintext.presence || "#{key.key_prefix}…" %></span>
                      <div class="flex items-center gap-2 shrink-0">
                        <button type="button" data-action="copy#copy" data-copy-label="复制 Key" class="hl-btn hl-btn-line px-3 py-1.5 text-hl-12">复制 Key</button>
                        <% if key.active? %>
                          <%= button_to "重新生成", users_regenerate_api_key_path, method: :post, form: { class: "inline" }, data: { confirm: "旧 Key 将立即失效，需在所有工具中更新配置。确定重新生成？" }, class: "hl-btn hl-btn-line px-3 py-1.5 text-hl-12" %>
                        <% end %>
                      </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-hl-12 text-muted-3">
                      <span class="<%= key.status == "active" ? "text-profit" : "text-muted-4" %>"><%= key.status == "active" ? "使用中" : (key.status == "disabled" ? "已停用" : "已吊销") %></span>
                      <span><%= key.plan_name %></span>
                      <span><%= key.unlimited? ? "长期使用" : "剩余 #{key.quota_remaining} 次" %></span>
                    </div>
                  </div>

                  <%# 安装提示词 + 复制（v1.39.0 起对普通用户开放；仅 active key 展示，disabled/已吊销 key 不提供，与「重新生成」按钮一致） %>
                  <% if key.active? %>
                    <div data-controller="copy">
                      <div class="flex items-center justify-between mb-1.5">
                        <span class="text-hl-12 text-muted-4">安装提示词（复制后粘贴给你的 AI 工具）</span>
                        <button type="button" data-action="copy#copy" data-copy-label="复制提示词" class="hl-btn hl-btn-line px-3 py-1.5 text-hl-12">复制提示词</button>
                      </div>
                      <textarea readonly rows="20" data-copy-target="source" class="w-full bg-white border border-line rounded px-4 py-3 text-hl-12 text-muted font-mono leading-relaxed focus:outline-none"><%= install_prompt(key.key_plaintext) %></textarea>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <p class="text-hl-11 text-muted-4 mt-3">Key 是你的付费凭证，请勿泄露给他人；如泄露请点击上方「重新生成」立即更换，旧 Key 即刻失效。</p>
          <% else %>
            <span class="text-hl-13 text-muted-3">暂无 API Key。</span>
            <%= link_to "去购买 AI 投研助手套餐", plans_path, class: "text-hl-13 text-profit font-medium hover:underline ml-1" %>
          <% end %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-bg-soft rounded p-4 sm:p-5">
            <span class="text-hl-12 text-muted-4 block mb-1">注册时间</span>
            <span class="text-hl-14 text-ink font-medium"><%= l(@user.created_at, format: :long) %></span>
          </div>
          <div class="bg-bg-soft rounded p-4 sm:p-5">
            <span class="text-hl-12 text-muted-4 block mb-1">最后登录</span>
            <span class="text-hl-14 text-ink font-medium">
              <%= @user.last_login_at.present? ? l(@user.last_login_at, format: :long) : "<span class='text-muted-4'>暂无记录</span>".html_safe %>
            </span>
          </div>
        </div>

      </div>

      <%# 操作按钮 %>
      <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex flex-wrap gap-3">
        <%= link_to "编辑资料", users_edit_profile_path, class: "hl-btn hl-btn-primary" %>
        <% if current_user.is_admin? %>
          <%= link_to "后台管理", admin_root_path, class: "hl-btn hl-btn-line" %>
          <%= link_to "预览注册引导页", onboarding_path(preview: 1), class: "hl-btn hl-btn-line" %>
        <% end %>
      </div>

    </div>
  </div>
</div>